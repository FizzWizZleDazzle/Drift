// The drift module's random numbers, noise, generators and pathfinding give
// the engine's numbers: the same golden values as tests/test_procgen.cpp.
// ctest runs it with `drift run` and reads the log.

import "drift" { * };

@resource
struct Checks { failed: int = 0 }

fn expect(checks: Checks, what: string, ok: bool) {
    if !ok {
        checks.failed += 1;
        warn("FAIL " + what);
    }
}

@system(schedule: Schedule::Startup)
fn check(window: Window, checks: Checks, assets: Assets, random: Random) {
    let r = rng(42);
    expect(checks, "rng u32", r.next_int() == 1898997482 && r.next_int() == 1014631766
                              && r.next_int() == 4096008554 && r.next_int() == 633901381);
    let f = rng(7);
    expect(checks, "rng next_float", f.next_float() == 0.8234375715255737);
    expect(checks, "rng range_float", f.range_float(-5.0, 5.0) == -2.311068058013916);
    expect(checks, "rng range_float 2", f.range_float(10.0, 20.0) == 16.758506774902344);
    expect(checks, "rng range", f.range(1, 6) == 5 && f.range(1, 6) == 1 && f.range(-100, 100) == 55);
    expect(checks, "seed_from", seed_from("caves") == -3181713717986421903);

    let copy = rng(1234);
    copy.next_int();
    let again = copy.copy();
    expect(checks, "rng copies replay", copy.next_int() == again.next_int());

    let n = Noise { seed: 1234, kind: NoiseType::Perlin, .. };
    expect(checks, "perlin", n.sample(3.7, 1.2) == -0.13217830657958984);
    let warped = Noise { seed: 1234, frequency: 0.05, octaves: 4, warp: 8.0, .. };
    expect(checks, "warped simplex", warped.sample(13.0, 27.0) == -0.5514052510261536);

    let c = rng(99);
    expect(checks, "cave", cave(c, 40, 24, CaveOptions { .. }).count(FLOOR) == 531);
    let d = rng(5);
    let dg = dungeon(d, 48, 30, DungeonOptions { .. });
    expect(checks, "dungeon", dg.rooms.len() == 19 && dg.grid.count(DOOR) == 27);
    let w = rng(3);
    expect(checks, "random walk", random_walk(w, 40, 24, WalkOptions { .. }).count(FLOOR) == 334);
    let p = rng(11);
    let pts = poisson_disk(p, rect(0.0, 0.0, 100.0, 100.0), 10.0);
    expect(checks, "poisson", pts.len() == 66 && pts[0].x == 88.66236877441406);

    let sample = grid(6, 6, FLOOR);
    for i in range(6) {
        sample.set(cell(i, 0), WALL);
        sample.set(cell(i, 5), WALL);
        sample.set(cell(0, i), WALL);
        sample.set(cell(5, i), WALL);
    }
    sample.set(cell(2, 2), 2);
    let wr = rng(8);
    let made = false;
    if wfc(wr, sample, 20, 12, WfcOptions { .. }) is Some(out) {
        made = out.width == 20 && out.count(WALL) == 136;
    }
    expect(checks, "wfc", made);

    let table = weighted_table<string>().add("coin", 70.0).add("potion", 25.0).add("sword", 5.0);
    let lr = rng(1);
    let rolls = "";
    for i in range(6) {
        if table.roll(lr) is Some(item) {
            rolls = rolls + item + " ";
        }
    }
    expect(checks, "weighted table", rolls == "potion coin sword coin coin potion ");

    let maze = grid(8, 5, FLOOR);
    for y in range(4) {
        maze.set(cell(4, y), WALL);
    }
    let path = find_path(maze, cell(0, 0), cell(7, 0), [WALL], false);
    expect(checks, "find_path", path.len() == 16 && path[15].x == 7);
    let field = flow_field(maze, [cell(7, 0)], [WALL], false);
    expect(checks, "flow_field", field.cost(cell(0, 0)) == 15.0 && field.cost(cell(4, 0)) == -1.0);
    expect(checks, "regions", maze.region_sizes(FLOOR).len() == 1);
    let open = cave(rng(3), 30, 20, CaveOptions { fill: 0.55, keep_largest: false, .. });
    let pockets = open.region_sizes(FLOOR).len();
    open.keep_largest_region(FLOOR, WALL);
    expect(checks, "keep_largest_region", pockets > 1 && open.region_sizes(FLOOR).len() == 1);

    let mixed = rng(9).shuffle<int>([1, 2, 3, 4, 5]);
    expect(checks, "shuffle keeps items", mixed.len() == 5 && mixed[0] + mixed[1] + mixed[2] + mixed[3] + mixed[4] == 15);
    let parent = rng(9);
    let child = parent.split();
    expect(checks, "split", child.next_int() != parent.next_int());
    expect(checks, "random streams", random.stream("a").next_int() == random.stream("a").next_int()
                                     && random.stream("a").next_int() != random.stream("b").next_int());

    // A map made in code holds what was written into it.
    let white: Color[] = [];
    for i in range(32 * 16) {
        white.push(rgb(255, 255, 255));
    }
    let tiles = assets.create_texture(32, 16, white);
    let map = assets.create_tilemap(30, 20, 16, tiles, ["Ground", "Walls"]);
    let walls = cave(rng(12), 30, 20, CaveOptions { .. });
    map.fill(1, walls, [0, 2], cell(0, 0));
    expect(checks, "map size", map.size().x == 30 && map.size().y == 20 && map.tile_size().x == 16);
    expect(checks, "map layers", map.layer_count() == 2 && map.layer("Walls") == 1 && map.layer_name(0) == "Ground");
    expect(checks, "map tile", map.tile(1, cell(0, 0)) == 2);
    let back = map.to_grid(1);
    let same = true;
    for i in range(walls.cells.len()) {
        if (walls.cells[i] == WALL) != (back.cells[i] == 2) {
            same = false;
        }
    }
    expect(checks, "map to_grid", same);
    map.set_tile(0, cell(3, 4), 1);
    expect(checks, "map set_tile", map.tile(0, cell(3, 4)) == 1);
    let spot = map.world_to_tile(vec2(40.0, 70.0), 0);
    expect(checks, "map world_to_tile", spot.x == 2 && spot.y == 4);
    map.destroy();

    if checks.failed == 0 {
        log("procgen checks passed");
    }
    window.quit();
}
