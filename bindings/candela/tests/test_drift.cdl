// Exercises the package end to end against a real engine. Run from the
// package directory after building the native library:
//
//     SDL_VIDEO_DRIVER=offscreen candela run tests/test_drift.cdl [dir] [pipelined]
//
// A second argument of 0 runs the engine simulation after the systems
// instead of beside them (Config.pipelined = false).
//
// The test is a game: one update system walks through a list of steps,
// each a function that returns true when it is done, so the checks see the
// engine the way a game does, frame by frame. Steps that wait on the engine
// use seconds, because a headless run draws as fast as it can. Temporary
// files (screenshots, a save, a scene) go in `dir`, default the working
// directory, and are removed again.

import "std/assert" as assert;
import "std/fs";
import "../src/main.cdl" { Align, AnimationClip, Animator, Binding, Blend, BodyKind, BoxCollider, Camera, Cell, Circle, CircleCollider, Color, Ease, EmitShape, Entity, Filter, Follow, GamepadAxis, GamepadButton, Key, Lifetime, LightOccluder, MouseButton, Name, Oscillate, ParticleEmitter, Rectangle, RigidBody, Row, ScaleMode, Sprite, Text, Texture, Tilemap, Transform, Velocity, World, app, at, config, cooldown, ease, hud_layer, last_error, play_options, rect, repeating_timer, rgb, rgba, sprite_options, timer, tween, vec2 };

// ---- Components and resources of the test ----

struct Marker {
    n: int,
}

struct Tag {
    label: string,
}

struct Ball {
    id: int,
}

struct Ground {
    id: int,
}

struct Zone {
    id: int,
}

struct Score {
    points: int,
}

struct Step {
    name: string,
    run: fn(World, Checks, float) -> bool,
}

/// Shared state of the steps.
struct Checks {
    dir: string,
    steps: Step[],
    index: int,
    started: float,
    first: bool,
    a: Entity,
    b: Entity,
    c: Entity,
    d: Entity,
    tex: Texture,
    n: int,
    touched: bool,
    entered: bool,
    order_ok: bool,
    max_overlap: float,
    background: bool,
}

fn scratch(c: Checks, name: string) -> string {
    return c.dir + "/" + name;
}

fn near(a: float, b: float, eps: float) -> bool {
    return (a - b).abs() <= eps;
}

fn main() {
    test_values();
    let dir = ".";
    let args = argv();
    if args.len() > 0 {
        dir = args[0];
    }
    let none = Entity { id: 0 };
    let checks = Checks {
        dir: dir, steps: [], index: 0, started: 0.0, first: true, a: none, b: none, c: none, d: none,
        tex: Texture { id: 0 }, n: 0, touched: false, entered: false, order_ok: true,
        max_overlap: 0.0, background: false,
    };
    add(checks, "app", step_app);
    add(checks, "entities", step_entities);
    add(checks, "velocity", step_velocity);
    add(checks, "script and engine", step_script_and_engine);
    add(checks, "lifetime", step_lifetime);
    add(checks, "behaviors", step_behaviors);
    add(checks, "sprites and animation", step_animation);
    add(checks, "tweens", step_tweens);
    add(checks, "drawing", step_drawing);
    add(checks, "input", step_input);
    add(checks, "actions", step_actions);
    add(checks, "physics", step_physics);
    add(checks, "particles and effects", step_effects);
    add(checks, "audio", step_audio);
    add(checks, "save data", step_save);
    add(checks, "tilemap", step_tilemap);
    add(checks, "scenes", step_scenes);
    add(checks, "pipeline", step_pipeline);

    let cfg = config("drift tests", 640, 360);
    cfg.pipelined = args.len() < 2 || args[1] != "0";
    app(cfg)
        .startup(fn(world) { world.insert_resource(checks); })
        .update(run_steps)
        .on_collision<Ball, Ground>(fn(world, ball, ground) {
            let c = world.resource<Checks>();
            c.touched = true;
            c.order_ok = c.order_ok && world.has<Ball>(ball) && world.has<Ground>(ground);
        })
        .on_sensor<Ball, Zone>(fn(world, ball, zone) {
            let c = world.resource<Checks>();
            c.entered = true;
            c.order_ok = c.order_ok && world.has<Ball>(ball) && world.has<Zone>(zone);
        })
        .run();
    assert::eq(checks.index, checks.steps.len());
    print("drift package: ok");
}

fn add(c: Checks, name: string, f: fn(World, Checks, float) -> bool) {
    c.steps.push(Step { name: name, run: f });
}

fn run_steps(world: World, dt: float) {
    let c = world.resource<Checks>();
    let s = world.stats();
    if s.overlap > c.max_overlap {
        c.max_overlap = s.overlap;
    }
    c.background = c.background || s.background;
    if c.index >= c.steps.len() {
        world.quit();
        return;
    }
    if c.first {
        c.first = false;
        c.started = world.time();
    }
    let step = c.steps[c.index];
    if step.run(world, c, world.time() - c.started) {
        print(step.name + ": ok");
        c.index += 1;
        c.first = true;
    }
}

// Plain values: no engine needed.
fn test_values() {
    let v = vec2(3.0, 4.0);
    assert::eq(v.length(), 5.0);
    assert::eq(v.add(vec2(1.0, 1.0)).x, 4.0);
    assert::is_true(near(v.normalized().y, 0.8, 0.000001));
    assert::is_true(rect(0.0, 0.0, 10.0, 10.0).contains(vec2(5.0, 5.0)));
    assert::is_false(rect(0.0, 0.0, 10.0, 10.0).overlaps(rect(20.0, 0.0, 5.0, 5.0)));
    assert::eq(rgb(255, 0, 0).r, 1.0);
    assert::eq(rgba(0, 0, 0, 0).a, 0.0);
    assert::eq(Key::Space.code(), 44);
    assert::eq(Key::Code(100).code(), 100);
    assert::eq(Binding::Key(Key::A).text(), "key:#4");
    assert::eq(Binding::AxisNegative(GamepadAxis::LeftY).text(), "axis:-#1");
    assert::eq(ease(Ease::Linear, 0.25), 0.25);
    assert::eq(ease(Ease::OutQuad, 1.0), 1.0);
    assert::eq(Transform { .. }.scale.x, 1.0);
    assert::eq(at(1.0, 2.0).position.y, 2.0);
    assert::eq(Sprite { .. }.anchor.x, 0.5);
    assert::eq(tween().move_to(vec2(1.0, 2.0), 0.5, Ease::Linear).yoyo(-1).loops, -1);

    let t = timer(1.0);
    assert::eq(t.tick(0.5), 0);
    assert::eq(t.tick(0.6), 1);
    assert::is_true(t.finished());
    let r = repeating_timer(0.25);
    assert::eq(r.tick(0.6), 2);
    let c = cooldown(0.5);
    assert::is_true(c.try_use());
    assert::is_false(c.try_use());
    c.tick(0.5);
    assert::is_true(c.ready());
    print("values: ok");
}

fn step_app(world: World, c: Checks, t: float) -> bool {
    assert::is_true(world.dt > 0.0);
    assert::eq(world.size().x, 640.0);
    assert::is_true(world.backend() == "gl" || world.backend() == "webgpu");
    world.set_title("drift tests (running)");
    world.set_scale_mode(ScaleMode::Integer);
    world.set_scale_mode(ScaleMode::Letterbox);
    world.set_clear_color(rgb(10, 20, 30));
    return true;
}

fn step_entities(world: World, c: Checks, t: float) -> bool {
    // Your own components live on the candela side.
    let a = world.spawn().insert(Marker { n: 1 }).insert(Tag { label: "a" }).id();
    let b = world.spawn().insert(Marker { n: 2 }).id();
    let e3 = world.spawn().insert(Tag { label: "only tag" }).id();
    assert::is_true(world.alive(a));
    assert::is_true(world.has<Marker>(a));
    assert::is_false(world.has<Tag>(b));
    assert::eq(world.get<Tag>(a).label, "a");
    assert::eq(world.count<Marker>(), 2);
    assert::eq(world.query<Marker>().len(), 2);
    assert::eq(world.query2<Marker, Tag>().len(), 1);
    assert::eq(world.query2<Marker, Tag>()[0].entity.id, a.id);

    // Changes through a row or a get stay in the stored component.
    for r in world.query<Marker>() {
        r.a.n += 10;
    }
    assert::eq(world.get<Marker>(a).n, 11);
    world.get<Marker>(b).n = 50;
    assert::eq(world.query<Marker>()[1].a.n, 50);
    world.par_each<Marker>(fn(w, e, m) { m.n += 1; });
    assert::eq(world.get<Marker>(b).n, 51);
    world.par_each2<Marker, Tag>(fn(w, e, m, tag) { tag.label = tag.label + "!"; });
    assert::eq(world.get<Tag>(a).label, "a!");

    // Spawning and despawning while iterating a query is safe: the rows
    // are a snapshot.
    for r in world.query<Marker>() {
        world.spawn().insert(Marker { n: 100 });
        world.despawn(r.entity);
    }
    assert::is_false(world.alive(a));
    assert::eq(world.count<Marker>(), 2);
    assert::is_false(world.has<Tag>(a));
    assert::eq(world.count<Tag>(), 1);

    // remove, re-insert, replace.
    world.remove<Tag>(e3);
    assert::is_false(world.has<Tag>(e3));
    world.entity(e3).insert(Tag { label: "back" }).insert(Tag { label: "replaced" });
    assert::eq(world.get<Tag>(e3).label, "replaced");
    try {
        world.get<Marker>(e3);
        assert::is_true(false);
    } catch "drift_missing_component" {
        print("missing component raised");
    }

    // Resources.
    world.insert_resource(Score { points: 3 });
    world.resource<Score>().points += 1;
    assert::eq(world.resource<Score>().points, 4);
    assert::is_true(world.has_resource<Score>());
    world.remove_resource<Score>();
    assert::is_false(world.has_resource<Score>());
    try {
        world.resource<Score>();
        assert::is_true(false);
    } catch "drift_missing_resource" {
        print("missing resource raised");
    }

    // Names.
    let named = world.spawn().insert(Name { value: "hero" }).insert(at(5.0, 6.0)).id();
    assert::eq(world.find("hero").id, named.id);
    assert::is_false(world.alive(world.find("nobody")));
    for r in world.query<Marker>() {
        world.despawn(r.entity);
    }
    world.despawn(e3);
    world.despawn(named);
    return true;
}

// A Velocity moves the entity in the engine; the Transform the systems
// read follows it.
fn step_velocity(world: World, c: Checks, t: float) -> bool {
    if t == 0.0 || c.n == 0 {
        c.a = world.spawn()
            .insert(at(10.0, 10.0))
            .insert(Velocity { linear: vec2(200.0, 0.0), angular: 1.0 })
            .insert(Rectangle { size: vec2(8.0, 8.0), .. })
            .id();
        c.n = 1;
        return false;
    }
    if t < 0.3 {
        return false;
    }
    let tr = world.get<Transform>(c.a);
    assert::is_true(tr.position.x > 50.0);
    assert::is_true(tr.rotation > 0.2);
    assert::eq(tr.position.y, 10.0);
    world.despawn(c.a);
    c.n = 0;
    return true;
}

// A system changes a Transform the engine also moves: both changes land.
fn step_script_and_engine(world: World, c: Checks, t: float) -> bool {
    if c.n == 0 {
        c.a = world.spawn().insert(at(0.0, 0.0)).insert(Velocity { linear: vec2(100.0, 0.0), .. }).id();
        c.n = 1;
        return false;
    }
    if t < 0.3 {
        world.get<Transform>(c.a).position.y += 1.0;
        c.n += 1;
        return false;
    }
    let p = world.get<Transform>(c.a).position;
    // Every frame's +1 arrived, and the velocity kept moving x.
    assert::is_true(near(p.y, float(c.n - 1), 1.01));
    assert::is_true(p.x > 15.0);
    world.despawn(c.a);
    c.n = 0;
    return true;
}

fn step_lifetime(world: World, c: Checks, t: float) -> bool {
    if c.n == 0 {
        c.a = world.spawn().insert(at(0.0, 0.0)).insert(Lifetime { seconds: 0.1 }).insert(Marker { n: 7 }).id();
        c.n = 1;
        return false;
    }
    if t < 0.05 && world.alive(c.a) {
        assert::is_true(world.get<Lifetime>(c.a).seconds < 0.1001);
    }
    if t < 0.4 {
        return false;
    }
    // The engine despawned it; the candela side heard.
    assert::is_false(world.alive(c.a));
    assert::eq(world.count<Marker>(), 0);
    c.n = 0;
    return true;
}

fn step_behaviors(world: World, c: Checks, t: float) -> bool {
    if c.n == 0 {
        c.a = world.spawn().insert(at(400.0, 100.0)).id();
        c.b = world.spawn().insert(at(100.0, 100.0)).insert(Follow { target: c.a, speed: 2000.0, distance: 10.0, .. }).id();
        c.c = world.spawn().insert(at(200.0, 200.0)).insert(Oscillate { amplitude: vec2(0.0, 50.0), frequency: 1.0, .. }).id();
        c.n = 1;
        return false;
    }
    if t < 0.3 {
        return false;
    }
    let f = world.get<Transform>(c.b).position;
    assert::is_true(near(f.x, 390.0, 1.0));
    let o = world.get<Transform>(c.c).position;
    assert::is_true(o.y > 210.0);
    assert::eq(o.x, 200.0);
    world.despawn(c.a);
    world.despawn(c.b);
    world.despawn(c.c);
    c.n = 0;
    return true;
}

fn checker(world: World) -> Texture {
    let px: Color[] = [];
    for y in range(8) {
        for x in range(16) {
            if (x / 4 + y / 4) % 2 == 0 {
                px.push(rgb(255, 255, 255));
            } else {
                px.push(rgb(255, 0, 255));
            }
        }
    }
    return world.create_texture(16, 8, px);
}

fn step_animation(world: World, c: Checks, t: float) -> bool {
    if c.n == 0 {
        let tex = checker(world);
        c.tex = tex;
        assert::eq(tex.size().x, 16.0);
        tex.set_filter(Filter::Linear);
        try {
            world.load_texture("no/such/file.png");
            assert::is_true(false);
        } catch "drift_load_failed" {
            assert::is_true(last_error().contains("no/such/file.png"));
        }
        let sheet = world.spritesheet(tex, 4, 4);
        assert::eq(sheet.frame_count(), 8);
        assert::eq(sheet.frame_at(5).x, 4.0);
        c.a = world.spawn()
            .insert(at(100.0, 100.0))
            .insert(Sprite { texture: tex, color: rgba(255, 128, 0, 255), z: 3.0, .. })
            .insert(Animator { clips: [AnimationClip { frames: sheet.frames(0, 4), frame_seconds: 0.02, looping: true },
                                       AnimationClip { frames: sheet.frames(4, 2), frame_seconds: 0.02, looping: false }], .. })
            .id();
        c.n = 1;
        return false;
    }
    if c.n == 1 {
        if t < 0.05 {
            return false;
        }
        let an = world.get<Animator>(c.a);
        assert::eq(an.clip, 0);
        assert::eq(world.get<Sprite>(c.a).frame.w, 4.0);
        assert::is_true(near(world.get<Sprite>(c.a).color.g, 128.0 / 255.0, 0.01));
        an.clip = 1;
        c.n = 2;
        return false;
    }
    if t < 0.3 {
        return false;
    }
    let an = world.get<Animator>(c.a);
    assert::eq(an.clip, 1);
    assert::is_true(an.finished);
    assert::eq(an.frame, 1);
    assert::eq(world.get<Sprite>(c.a).frame.x, 4.0);
    assert::eq(world.get<Sprite>(c.a).frame.y, 4.0);
    world.despawn(c.a);
    c.n = 0;
    return true;
}

fn step_tweens(world: World, c: Checks, t: float) -> bool {
    if c.n == 0 {
        c.a = world.spawn()
            .insert(at(50.0, 50.0))
            .insert(Sprite { texture: c.tex, .. })
            .insert(tween().move_to(vec2(150.0, 50.0), 0.1, Ease::OutQuad).delay(0.02).fade_to(0.0, 0.05, Ease::Linear))
            .id();
        c.b = world.spawn().insert(at(0.0, 0.0)).insert(Camera { zoom: 1.0, active: false, .. })
            .insert(tween().zoom_to(2.0, 0.05, Ease::Linear)).id();
        c.n = 1;
        return false;
    }
    if t < 0.3 {
        return false;
    }
    assert::is_true(near(world.get<Transform>(c.a).position.x, 150.0, 0.5));
    assert::is_true(near(world.get<Sprite>(c.a).color.a, 0.0, 0.01));
    assert::is_true(near(world.get<Camera>(c.b).zoom, 2.0, 0.01));
    world.set_tween_speed(1.0);
    world.despawn(c.a);
    world.despawn(c.b);
    c.n = 0;
    return true;
}

fn step_drawing(world: World, c: Checks, t: float) -> bool {
    let shot = scratch(c, "test_drift_shot.png");
    if c.n == 0 {
        c.a = world.spawn().insert(at(320.0, 180.0)).insert(Camera { zoom: 1.0, .. }).id();
        world.spawn().insert(at(60.0, 60.0)).insert(Rectangle { size: vec2(60.0, 40.0), color: rgb(255, 0, 0), .. });
        world.spawn().insert(Transform { position: vec2(160.0, 60.0), rotation: 0.5, .. })
            .insert(Rectangle { size: vec2(60.0, 40.0), color: rgb(0, 255, 0), outline: 3.0, .. });
        world.spawn().insert(at(260.0, 60.0)).insert(Circle { radius: 25.0, color: rgb(0, 128, 255), .. });
        world.spawn().insert(at(340.0, 60.0)).insert(Rectangle { size: vec2(60.0, 40.0), corner_radius: 10.0, color: rgb(255, 255, 0), .. });
        world.spawn().insert(at(10.0, 300.0)).insert(Text { value: "drift", size: 32.0, layer: hud_layer(), .. });
        world.spawn().insert(at(320.0, 200.0))
            .insert(Text { value: "centered", size: 24.0, align: Align::Center, outline: 2.0, color: rgb(255, 255, 0), .. });
        world.spawn().insert(Transform { position: vec2(500.0, 200.0), scale: vec2(4.0, 4.0), .. }).insert(Sprite { texture: c.tex, .. });
        let size = world.measure_text("Hello", 20.0);
        assert::is_true(size.x > 20.0);
        assert::is_true(world.measure_text("Hello Hello", 20.0).x > size.x);
        // Debug drawing still exists for systems.
        world.draw_line(vec2(10.0, 150.0), vec2(300.0, 150.0), rgb(255, 255, 255), 3.0);
        world.draw_circle(vec2(500.0, 300.0), 10.0, rgb(255, 0, 255));
        let o = sprite_options();
        o.scale = vec2(4.0, 4.0);
        world.draw_texture(c.tex, vec2(560.0, 260.0), o);
        world.screenshot(shot);
        c.n = 1;
        return false;
    }
    if t < 0.1 {
        return false;
    }
    assert::is_true(world.draw_calls() > 0);
    assert::is_true(fs::exists(shot));
    let w = world.screen_to_world(vec2(320.0, 180.0));
    assert::is_true(near(w.x, 320.0, 1.0));
    if c.dir == "." {
        fs::delete(shot);
    }
    for e in world.entities<Rectangle>() {
        world.despawn(e);
    }
    for e in world.entities<Circle>() {
        world.despawn(e);
    }
    for e in world.entities<Text>() {
        world.despawn(e);
    }
    for e in world.entities<Sprite>() {
        world.despawn(e);
    }
    world.despawn(c.a);
    c.n = 0;
    return true;
}

fn step_input(world: World, c: Checks, t: float) -> bool {
    let input = world.input();
    if c.n == 0 {
        input.send_key(Key::Space, true);
        c.n = 1;
        return false;
    }
    if c.n == 1 {
        assert::is_true(input.key_pressed(Key::Space));
        assert::is_true(input.key_down(Key::Space));
        c.n = 2;
        return false;
    }
    if c.n == 2 {
        assert::is_false(input.key_pressed(Key::Space));
        assert::is_true(input.key_down(Key::Space));
        input.send_key(Key::Space, false);
        input.send_mouse_move(vec2(100.0, 50.0));
        input.send_mouse_button(vec2(100.0, 50.0), MouseButton::Left, true);
        c.n = 3;
        return false;
    }
    assert::is_true(input.key_released(Key::Space));
    assert::is_true(input.mouse_pressed(MouseButton::Left));
    assert::is_true(input.mouse_position().x > 0.0);
    assert::is_false(input.gamepad_connected(0));
    input.send_mouse_button(vec2(100.0, 50.0), MouseButton::Left, false);
    c.n = 0;
    return true;
}

fn step_actions(world: World, c: Checks, t: float) -> bool {
    let input = world.input();
    if c.n == 0 {
        input.bind_action("jump", Binding::Key(Key::Space));
        input.bind_action("jump", Binding::Button(GamepadButton::South));
        input.bind_axis2d("move", Binding::Key(Key::A), Binding::Key(Key::D), Binding::Key(Key::W), Binding::Key(Key::S));
        input.bind_axis("turn", Binding::Key(Key::Q), Binding::Key(Key::E));
        input.bind_stick("look", GamepadAxis::RightX, GamepadAxis::RightY);
        assert::is_true(input.has_action("jump"));
        assert::eq(input.bindings("jump", 0), ["key:Space", "button:South"]);
        try {
            input.bind_action("jump", Binding::Unbound);
            assert::is_true(false);
        } catch "drift_bad_binding" {
            print("unbound binding raised");
        }
        input.send_key(Key::Space, true);
        input.send_key(Key::D, true);
        input.send_key(Key::E, true);
        c.n = 1;
        return false;
    }
    if c.n == 1 {
        assert::is_true(input.action_pressed("jump"));
        assert::eq(input.action_value("jump"), 1.0);
        assert::eq(input.axis2d("move").x, 1.0);
        assert::eq(input.axis("turn"), 1.0);
        input.send_key(Key::Space, false);
        input.send_key(Key::D, false);
        input.send_key(Key::E, false);
        c.n = 2;
        return false;
    }
    assert::is_true(input.action_released("jump"));
    assert::is_true(input.rebind("jump", 0, 0, Binding::Key(Key::J)));
    let saved = input.bindings_json();
    assert::is_true(input.rebind_text("jump", 0, 0, "key:K"));
    assert::is_true(input.load_bindings_json(saved) > 0);
    assert::eq(input.bindings("jump", 0)[0], "key:J");
    input.remove_action("turn");
    assert::is_false(input.has_action("turn"));
    c.n = 0;
    return true;
}

fn step_physics(world: World, c: Checks, t: float) -> bool {
    if c.n == 0 {
        world.set_gravity(vec2(0.0, 500.0));
        assert::eq(world.gravity().y, 500.0);
        c.a = world.spawn().insert(at(320.0, 340.0)).insert(BoxCollider { half_size: vec2(300.0, 10.0), .. })
            .insert(Ground { id: 1 }).id();
        c.b = world.spawn().insert(at(320.0, 200.0)).insert(RigidBody { .. })
            .insert(CircleCollider { radius: 10.0, restitution: 0.2, .. }).insert(Velocity { .. })
            .insert(Ball { id: 1 }).id();
        c.c = world.spawn().insert(at(320.0, 260.0)).insert(BoxCollider { half_size: vec2(40.0, 10.0), sensor: true, .. })
            .insert(Zone { id: 1 }).id();
        c.n = 1;
        return false;
    }
    if c.n == 1 {
        if !(c.touched && c.entered) {
            assert::is_true(t < 3.0);
            return false;
        }
        assert::is_true(c.order_ok);
        assert::is_true(world.get<Transform>(c.b).position.y > 300.0);
        // Rays hit sensors too; take the zone away first.
        world.despawn(c.c);
        c.n = 2;
        return false;
    }
    if c.n == 2 {
        let hit = world.raycast(vec2(320.0, 100.0), vec2(0.0, 1.0), 400.0);
        assert::is_true(hit.hit);
        assert::is_true(hit.point.y > 300.0);
        assert::is_false(world.raycast(vec2(10.0, 10.0), vec2(-1.0, 0.0), 5.0).hit);
        // Teleport the ball and stop it; then push it.
        world.set_gravity(vec2(0.0, 0.0));
        world.get<Transform>(c.b).position = vec2(100.0, 100.0);
        world.get<Velocity>(c.b).linear = vec2(0.0, 0.0);
        c.n = 3;
        c.started = world.time();
        return false;
    }
    if c.n == 3 {
        if t < 0.05 {
            return false;
        }
        assert::is_true(near(world.get<Transform>(c.b).position.x, 100.0, 1.0));
        world.apply_impulse(c.b, vec2(1000.0, 0.0));
        c.n = 4;
        c.started = world.time();
        return false;
    }
    if t < 0.1 {
        return false;
    }
    assert::is_true(world.get<Transform>(c.b).position.x > 100.0);
    assert::is_true(world.get<Velocity>(c.b).linear.x > 0.0);
    world.remove<RigidBody>(c.b);
    assert::is_false(world.has<RigidBody>(c.b));
    world.despawn(c.a);
    world.despawn(c.b);
    c.n = 0;
    return true;
}

fn step_effects(world: World, c: Checks, t: float) -> bool {
    if c.n == 0 {
        c.a = world.spawn().insert(at(200.0, 200.0))
            .insert(ParticleEmitter { rate: 200.0, color_start: rgb(255, 200, 50), blend: Blend::Additive,
                                      shape: EmitShape::Circle, shape_radius: 5.0, .. }).id();
        world.burst(vec2(100.0, 100.0), ParticleEmitter { lifetime_max: 0.1, .. }, 30);
        let fx = [world.add_bloom(0.7, 1.0), world.add_vignette(0.5, 0.8), world.add_crt(0.1, 0.3),
                  world.add_grayscale(1.0), world.add_sepia(0.5), world.add_pixelate(4.0), world.add_blur(1.0, 2)];
        for e in fx {
            assert::is_true(e.id != 0);
            e.set_enabled(false);
            e.remove();
        }
        world.flash(rgb(255, 255, 255), 0.1);
        world.fade_to(rgb(0, 0, 0), 0.5, 0.1);
        try {
            world.set_ambient(rgb(10, 10, 10));
            assert::is_true(false);
        } catch "drift_lighting_off" {
            print("lighting off raised");
        }
        c.n = 1;
        return false;
    }
    if t < 0.1 {
        return false;
    }
    world.get<ParticleEmitter>(c.a).playing = false;
    world.fade_to(rgb(0, 0, 0), 0.0, 0.0);
    world.despawn(c.a);
    c.n = 0;
    return true;
}

fn step_audio(world: World, c: Checks, t: float) -> bool {
    let samples = [0.0].repeat(4410);
    let beep = world.create_sound(samples, 22050);
    assert::is_true(near(beep.duration(), 0.2, 0.01));
    beep.set_max_instances(4);
    let v = beep.play();
    assert::is_true(v.playing());
    v.set_volume(0.5, 0.0);
    v.set_pan(-0.5);
    v.set_pitch(1.5);
    v.stop(0.0);
    let o = play_options();
    o.looping = true;
    let ui = world.create_bus("ui", world.sfx_bus());
    o.bus = ui;
    let looped = beep.play_with(o);
    assert::is_true(looped.playing());
    ui.set_volume(0.25, 0.0);
    assert::eq(ui.volume(), 0.25);
    ui.stop(0.0);
    assert::is_true(world.music_bus().id != world.sfx_bus().id);
    world.play_music(beep, 0.0, true);
    world.stop_music(0.0);
    let tone = world.load_sound("../../tests/data/tone440.ogg");
    assert::is_true(tone.duration() > 0.0);
    assert::is_true(world.load_music("../../tests/data/tone440.mp3").duration() > 0.0);
    try {
        world.load_sound("missing.wav");
        assert::is_true(false);
    } catch "drift_load_failed" {
        print("missing sound raised");
    }
    print("audio device: " + string(world.audio_device()));
    return true;
}

fn step_save(world: World, c: Checks, t: float) -> bool {
    let path = scratch(c, "test_drift_save.json");
    if fs::exists(path) {
        fs::delete(path);
    }
    let s = world.open_save_file(path);
    assert::eq(s.get_int("score", 7), 7);
    s.set_int("score", 1200);
    s.set_float("volume", 0.75);
    s.set_string("name", "Ada");
    s.flush();
    assert::is_true(fs::exists(path));
    s.set_int("score", 1);
    assert::is_true(s.reload());
    assert::eq(s.get_int("score", 0), 1200);
    assert::eq(s.get_string("name", ""), "Ada");
    s.clear();
    assert::is_false(s.has("score"));
    fs::delete(path);
    return true;
}

fn step_tilemap(world: World, c: Checks, t: float) -> bool {
    if c.n == 0 {
        let map = world.load_tilemap("../../examples/tilemap/assets/meadow.tmj");
        assert::eq(map.tile_size().x, 16);
        let ground = map.layer("Ground");
        try {
            map.layer("Lava");
            assert::is_true(false);
        } catch "drift_no_such_layer" {
            print("missing layer raised");
        }
        assert::is_true(map.objects("Coin").len() >= 4);
        c.a = world.spawn().insert(at(0.0, 0.0)).insert(Tilemap { map: map, .. }).id();
        c.n = 1;
        return false;
    }
    if t < 0.05 {
        return false;
    }
    let map = world.get<Tilemap>(c.a).map;
    let ground = map.layer("Ground");
    let fx = -1000;
    let fy = -1000;
    for y in range(60) {
        for x in range(120) {
            if fx == -1000 && map.tile(ground, x - 40, y - 20) != 0 {
                fx = x - 40;
                fy = y - 20;
            }
        }
    }
    assert::is_true(fx != -1000);
    let id = map.tile(ground, fx, fy);
    let corner = map.tile_to_world(Cell { x: fx, y: fy }, ground);
    let cell = map.world_to_tile(corner.add(vec2(8.0, 8.0)), ground);
    assert::eq(cell.x, fx);
    assert::eq(map.tile_at(ground, corner.add(vec2(8.0, 8.0))), id);
    world.despawn(c.a);
    c.n = 0;
    return true;
}

fn step_scenes(world: World, c: Checks, t: float) -> bool {
    let path = scratch(c, "test_drift_scene.json");
    let a = world.spawn().insert(at(10.0, 10.0)).insert(Rectangle { size: vec2(8.0, 8.0), color: rgb(255, 0, 0), .. })
        .insert(Name { value: "crate" }).id();
    assert::is_true(world.save_scene(path));
    world.despawn(a);
    let scene = world.load_scene(path);
    let spawned = world.spawn_scene(scene, vec2(100.0, 0.0));
    assert::is_true(spawned.len() >= 1);
    let crate = world.find("crate");
    assert::is_true(world.alive(crate));
    assert::is_true(near(world.get<Transform>(crate).position.x, 110.0, 0.01));
    assert::eq(world.get<Rectangle>(crate).size.x, 8.0);
    assert::is_true(near(world.get<Rectangle>(crate).color.r, 1.0, 0.01));
    try {
        world.load_scene("missing_scene.json");
        assert::is_true(false);
    } catch "drift_load_failed" {
        print("missing scene raised");
    }
    for e in spawned {
        world.despawn(e);
    }
    fs::delete(path);
    return true;
}

// The engine simulation ran on its background thread while the systems
// ran. A system that takes a while makes the overlap measurable.
fn step_pipeline(world: World, c: Checks, t: float) -> bool {
    if c.n == 0 {
        for i in range(500) {
            world.spawn().insert(at(float(i), 10.0)).insert(Velocity { linear: vec2(10.0, 0.0), .. });
        }
        c.n = 1;
        return false;
    }
    let busy = 0.0;
    for i in range(20000) {
        busy += float(i) * 0.5;
    }
    if t < 0.3 {
        return false;
    }
    print("max overlap ms: " + string(c.max_overlap));
    let args = argv();
    if args.len() < 2 || args[1] != "0" {
        assert::is_true(c.background);
        assert::is_true(c.max_overlap > 0.0);
    } else {
        assert::is_false(c.background);
    }
    for e in world.entities<Velocity>() {
        world.despawn(e);
    }
    return true;
}
