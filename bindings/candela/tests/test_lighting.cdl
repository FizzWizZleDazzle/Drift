// Lights need Config.lighting, which is fixed when the app starts, so they
// get their own program. The screenshot shows a lit circle with a shadow.
//
//     SDL_VIDEO_DRIVER=offscreen candela run tests/test_lighting.cdl [dir]

import "std/assert" as assert;
import "../src/main.cdl" { BoxCollider, LightOccluder, OccluderShape, PointLight, Rectangle, SpotLight, World, app, at, config, rgb, vec2 };

struct Shot {
    dir: string,
    frames: int,
    lamp_id: int,
}

fn main() {
    let dir = ".";
    let args = argv();
    if args.len() > 0 {
        dir = args[0];
    }
    let cfg = config("lighting test", 480, 270);
    cfg.lighting = true;
    app(cfg).startup(fn(world) {
        world.set_clear_color(rgb(160, 160, 170));
        world.set_ambient(rgb(20, 20, 30));
        let lamp = world.spawn().insert(at(160.0, 135.0))
            .insert(PointLight { color: rgb(255, 220, 160), intensity: 1.5, radius: 220.0, .. }).id();
        world.spawn().insert(at(400.0, 40.0))
            .insert(SpotLight { color: rgb(140, 180, 255), intensity: 1.4, radius: 260.0, direction: 2.2, angle: 0.7, .. });
        world.spawn().insert(at(240.0, 135.0))
            .insert(Rectangle { size: vec2(20.0, 120.0), color: rgb(90, 90, 90), .. })
            .insert(LightOccluder { half_size: vec2(10.0, 60.0), .. });
        world.spawn().insert(at(100.0, 220.0))
            .insert(LightOccluder { shape: OccluderShape::Circle, radius: 12.0, .. });
        world.spawn().insert(at(320.0, 200.0))
            .insert(Rectangle { size: vec2(24.0, 24.0), color: rgb(120, 80, 40), .. })
            .insert(BoxCollider { half_size: vec2(12.0, 12.0), .. })
            .insert(LightOccluder { shape: OccluderShape::FromCollider, .. });
        world.insert_resource(Shot { dir: dir, frames: 0, lamp_id: lamp.id });
    }).update(fn(world, dt) {
        let s = world.resource<Shot>();
        s.frames += 1;
        if s.frames == 3 {
            assert::eq(world.count<PointLight>(), 1);
            assert::eq(world.count<SpotLight>(), 1);
            world.screenshot(s.dir + "/lighting_test.png");
        }
        if s.frames == 6 {
            world.quit();
        }
    }).run();
    print("lighting: ok");
}
