// Frame-time benchmark: many moving sprites, moved three ways.
//
//     SDL_VIDEO_DRIVER=offscreen candela run tests/bench_movers.cdl <mode> <pipelined> <count>
//
// mode velocity  each entity has a Velocity; the engine moves them
// mode script    each entity has a Mover of its own; a system moves them
// mode physics   dynamic bodies bounce in a box while a system runs game
//                logic over a component of its own
// pipelined      1 (default) simulates while the systems run, 0 does not
//
// Prints the mean frame time and the mean of World.stats() over the
// measured frames. Not part of ctest; run by hand.

import "../src/main.cdl" { BoxCollider, CircleCollider, Rectangle, RigidBody, Sprite, Texture, Transform, Velocity, World, app, at, config, rgb, vec2 };
import "std/random" as random;

struct Mover {
    vx: float,
    vy: float,
}

struct Brain {
    mood: float,
}

struct Bench {
    mode: string,
    count: int,
    frames: int,
    warmup: int,
    measured: int,
    t0: float,
    script: float,
    simulation: float,
    overlap: float,
    wait: float,
    serial: float,
    render: float,
}

fn main() {
    let args = argv();
    let mode = "velocity";
    let pipelined = true;
    let count = 2000;
    if args.len() > 0 {
        mode = args[0];
    }
    if args.len() > 1 {
        pipelined = args[1] != "0";
    }
    if args.len() > 2 {
        count = args[2].parse<int>().unwrap_or(2000);
    }
    let cfg = config("bench", 960, 540);
    cfg.vsync = false;
    cfg.pipelined = pipelined;
    app(cfg).startup(fn(world) {
        let px = [rgb(255, 255, 255)].repeat(16);
        let tex = world.create_texture(4, 4, px);
        world.insert_resource(Bench { mode: mode, count: count, frames: 0, warmup: 30, measured: 300, t0: 0.0,
                                      script: 0.0, simulation: 0.0, overlap: 0.0, wait: 0.0, serial: 0.0, render: 0.0 });
        if mode == "physics" {
            world.set_gravity(vec2(0.0, 300.0));
            wall(world, 480.0, 535.0, 480.0, 5.0);
            wall(world, 5.0, 270.0, 5.0, 270.0);
            wall(world, 955.0, 270.0, 5.0, 270.0);
        }
        for i in range(count) {
            let e = world.spawn()
                .insert(at(random::float_range(20.0, 940.0), random::float_range(20.0, 300.0)))
                .insert(Sprite { texture: tex, color: rgb(120 + i % 120, 180, 255), .. });
            let vx = random::float_range(-40.0, 40.0);
            let vy = random::float_range(-40.0, 40.0);
            if mode == "velocity" {
                e.insert(Velocity { linear: vec2(vx, vy), .. });
            } else if mode == "script" {
                e.insert(Mover { vx: vx, vy: vy });
            } else {
                e.insert(RigidBody { .. }).insert(CircleCollider { radius: 2.0, restitution: 0.5, .. })
                    .insert(Brain { mood: 0.0 });
            }
        }
    }).update(move_by_script).update(think).update(measure).run();
}

fn wall(world: World, x: float, y: float, hx: float, hy: float) {
    world.spawn().insert(at(x, y)).insert(BoxCollider { half_size: vec2(hx, hy), .. })
        .insert(Rectangle { size: vec2(hx * 2.0, hy * 2.0), color: rgb(80, 80, 90), .. });
}

fn move_by_script(world: World, dt: float) {
    for r in world.query2<Mover, Transform>() {
        r.b.position.x += r.a.vx * dt;
        r.b.position.y += r.a.vy * dt;
    }
}

// Game logic that never touches an engine component.
fn think(world: World, dt: float) {
    for r in world.query<Brain>() {
        let m = r.a.mood;
        for k in range(20) {
            m = m * 0.99 + float(k) * 0.001;
        }
        r.a.mood = m;
    }
}

fn measure(world: World, dt: float) {
    let b = world.resource<Bench>();
    b.frames += 1;
    if b.frames == b.warmup {
        b.t0 = world.time();
    }
    if b.frames > b.warmup {
        let s = world.stats();
        b.script += s.script;
        b.simulation += s.simulation;
        b.overlap += s.overlap;
        b.wait += s.wait;
        b.serial += s.serial;
        b.render += s.render;
    }
    if b.frames == b.warmup + b.measured {
        let n = float(b.measured);
        let frame = (world.time() - b.t0) * 1000.0 / n;
        print(b.mode + " count=" + string(b.count) + " pipelined=" + string(world.stats().background)
            + " frame_ms=" + string(frame)
            + " script=" + string(b.script / n) + " sim=" + string(b.simulation / n)
            + " overlap=" + string(b.overlap / n) + " wait=" + string(b.wait / n)
            + " serial=" + string(b.serial / n) + " render=" + string(b.render / n));
        world.quit();
    }
}
