// Benchmark: many particles from emitters that drift around the screen.
//
// `?n=24` sets how many emitters; each keeps about 800 particles alive.

import "drift" { * };

@component struct Drifter { phase: float = 0.0 }

fn arg(platform: Platform, name: string, fallback: int) -> int {
    return match platform.query(name).parse<int>() { Some(v) => v, None => fallback };
}

@system(schedule: Schedule::Startup)
fn setup(cmd: Commands, platform: Platform) {
    let count = arg(platform, "n", 24);
    for i in range(count) {
        let hue = float(i) * 360.0 / float(count);
        cmd.spawn([
            at(480.0, 270.0),
            ParticleEmitter {
                rate: 800.0, lifetime_min: 0.6, lifetime_max: 1.4, speed_min: 30.0, speed_max: 120.0,
                size_start: 5.0, size_end: 1.0, max_particles: 1200,
                color_start: hsv(hue, 0.7, 1.0), color_end: rgba(255, 255, 255, 0),
                gravity: vec2(0.0, 40.0), blend: Blend::Additive, ..
            },
            Drifter { phase: float(i) },
        ]);
    }
}

// The emitters circle about, so particles do not stack on one spot.
@system
fn wander(row: (Drifter, Transform), time: Time) {
    let (d, t) = row;
    let a = time.elapsed * 0.5 + d.phase;
    t.position = vec2(480.0 + cos(a) * 300.0 + sin(a * 2.3) * 60.0, 270.0 + sin(a * 1.7) * 180.0);
}
