// The engine's components, and the parent and child links between entities.

import "drift/core/values" { * };
import "drift/core/assets" { * };
import "drift/core/world" { * };
import "drift/core/rendering" { * };
import "drift/core/animation" { * };

// ---- Engine components ----

struct Transform { position: Vec2 = Vec2 { .. }, rotation: float = 0.0, scale: Vec2 = Vec2 { x: 1.0, y: 1.0 } }
fn at(x: float, y: float) -> Transform { return Transform { position: Vec2 { x: x, y: y }, .. }; }

struct Sprite {
    image: Texture = Texture { .. },
    frame: Rect = Rect { .. },
    anchor: Vec2 = Vec2 { x: 0.5, y: 0.5 },
    color: Color = Color { .. },
    flip_x: bool = false,
    flip_y: bool = false,
    z: float = 0.0,
    layer: int = 0,
    visible: bool = true,
    blend: Blend = Blend::Alpha,
    material: Material = Material { .. },   // a custom shader; Material {} draws as usual
}

struct Rectangle {
    size: Vec2 = Vec2 { x: 32.0, y: 32.0 },
    color: Color = Color { .. },
    outline: float = 0.0,
    corner_radius: float = 0.0,
    anchor: Vec2 = Vec2 { x: 0.5, y: 0.5 },
    z: float = 0.0,
    layer: int = 0,
    visible: bool = true,
}

struct Circle {
    radius: float = 16.0,
    color: Color = Color { .. },
    outline: float = 0.0,
    z: float = 0.0,
    layer: int = 0,
    visible: bool = true,
}

struct Text {
    value: string = "",
    size: float = 24.0,
    color: Color = Color { .. },
    align: Align = Align::Left,
    valign: VAlign = VAlign::Top,
    wrap: float = 0.0,
    line_spacing: float = 1.0,
    outline: float = 0.0,
    outline_color: Color = Color { r: 0.0, g: 0.0, b: 0.0, a: 1.0 },
    shadow_offset: Vec2 = Vec2 { .. },
    shadow_color: Color = Color { r: 0.0, g: 0.0, b: 0.0, a: 0.6 },
    rich_text: bool = false,
    font: Font = Font { .. },
    z: float = 0.0,
    layer: int = 0,
    visible: bool = true,
}

struct Velocity { linear: Vec2 = Vec2 { .. }, angular: float = 0.0 }

struct RigidBody {
    kind: BodyKind = BodyKind::Dynamic,
    fixed_rotation: bool = false,
    gravity_scale: float = 1.0,
    linear_damping: float = 0.0,
    angular_damping: float = 0.0,
}

struct BoxCollider {
    half_size: Vec2 = Vec2 { x: 16.0, y: 16.0 },
    offset: Vec2 = Vec2 { .. },
    sensor: bool = false,
    density: float = 1.0,
    friction: float = 0.3,
    restitution: float = 0.0,
    category: int = 1,        // bits this collider is
    mask: int = 65535,        // bits it collides with
}

struct CircleCollider {
    radius: float = 16.0,
    offset: Vec2 = Vec2 { .. },
    sensor: bool = false,
    density: float = 1.0,
    friction: float = 0.3,
    restitution: float = 0.0,
    category: int = 1,        // bits this collider is
    mask: int = 65535,        // bits it collides with
}

// A collider the shape of the entity's Sprite: the outline of every pixel
// whose alpha is at least `threshold`, holes included, placed by the
// sprite's frame, anchor and flips and the Transform's scale. A static body
// (or no RigidBody) collides along the outlines; dynamic and kinematic
// bodies and sensors get convex pieces. Shapes are worked out once per
// image, frame and settings and shared by every entity that shows them;
// after changing the image's pixels, call Physics.rebuild_shapes.
struct TextureCollider {
    threshold: float = 0.5,      // alpha, 0 to 1, from which a pixel is solid
    tolerance: float = 1.0,      // how far in image pixels the outline may stray from the pixels
    min_area: float = 4.0,       // solid parts and holes smaller than this many square pixels are dropped
    follow_sprite: bool = false, // make the shape again when the frame, anchor, a flip or the scale changes
    sensor: bool = false,
    density: float = 1.0,
    friction: float = 0.3,
    restitution: float = 0.0,
    category: int = 1,           // bits this collider is
    mask: int = 65535,           // bits it collides with
}

struct Lifetime { seconds: float = 1.0 }

// Swings the entity back and forth around where it is: `amplitude` pixels
// each way, `frequency` times a second. Adds to whatever else moves it.
struct Oscillate { amplitude: Vec2 = Vec2 { x: 0.0, y: 8.0 }, frequency: float = 1.0, phase: float = 0.0 }

// Moves the entity toward `target` plus `offset` at `speed` pixels per
// second, stopping `distance` short. Nothing happens while the target is
// missing.
struct Follow { target: Entity = Entity { .. }, speed: float = 100.0, distance: float = 0.0, offset: Vec2 = Vec2 { .. } }

// Circles the entity around `center`, or around `point` while `center` is
// unset or gone: `radius` pixels out, `speed` radians per second (negative
// turns the other way), from `angle`.
struct Orbit { center: Entity = Entity { .. }, point: Vec2 = Vec2 { .. }, radius: float = 64.0, speed: float = 1.0, angle: float = 0.0 }

enum Ease {
    Linear,
    InSine, OutSine, InOutSine,
    InQuad, OutQuad, InOutQuad,
    InCubic, OutCubic, InOutCubic,
    InQuart, OutQuart, InOutQuart,
    InQuint, OutQuint, InOutQuint,
    InExpo, OutExpo, InOutExpo,
    InCirc, OutCirc, InOutCirc,
    InBack, OutBack, InOutBack,
    InElastic, OutElastic, InOutElastic,
    InBounce, OutBounce, InOutBounce,
    Spring,
}

enum EmitShape { Point, Circle, Ring, Box, Line }

// `count` particles at once, `time` seconds into the emitter's run, repeated
// `cycles` times (0 forever) `interval` seconds apart.
struct Burst { time: float = 0.0, count: int = 10, cycles: int = 1, interval: float = 0.0 }

// Particles from the entity's position. `rate` per second; `duration` -1.0
// emits forever. A `_max` of 0.0 is the same as its minimum.
struct ParticleEmitter {
    rate: float = 20.0,
    lifetime_min: float = 0.5,
    lifetime_max: float = 1.5,
    speed_min: float = 20.0,
    speed_max: float = 60.0,
    angle_min: float = 0.0,
    angle_max: float = 6.2831853,
    size_start: float = 6.0,
    size_end: float = 1.0,
    color_start: Color = Color { .. },
    color_end: Color = Color { r: 1.0, g: 1.0, b: 1.0, a: 0.0 },
    gravity: Vec2 = Vec2 { .. },
    drag: float = 0.0,
    max_particles: int = 256,
    blend: Blend = Blend::Alpha,
    texture: Texture = Texture { .. },
    shape: EmitShape = EmitShape::Point,
    shape_radius: float = 0.0,
    shape_extents: Vec2 = Vec2 { .. },
    duration: float = -1.0,
    looping: bool = true,
    z: float = 10.0,
    playing: bool = true,
    frame: Rect = Rect { .. },           // part of `texture`; zero size for all of it
    size_start_max: float = 0.0,
    size_end_max: float = 0.0,
    rotation_min: float = 0.0,           // radians at birth
    rotation_max: float = 0.0,
    spin_min: float = 0.0,               // radians per second
    spin_max: float = 0.0,
    inherit_velocity: float = 0.0,       // share of the emitter's own motion particles keep
    local: bool = false,                 // particles move with the emitter
    prewarm: float = 0.0,                // seconds simulated before the first frame
    bounds: Rect = Rect { .. },          // particles stop at its edges; zero size for none
    seed: int = 0,                       // 0 picks one
    bursts: Burst[] = [],
}

// One step of a Tween; build them with tween() and its methods.
struct TweenStep { kind: int, a: float, b: float, c: float = 0.0, d: float = 0.0, seconds: float, ease: Ease = Ease::Linear }

// Animates the entity in the engine: the steps in order, repeated `loops`
// times (-1 forever), forward and back when `mirror` is set. Inserting a
// changed Tween starts it again.
struct Tween { steps: TweenStep[] = [], loops: int = 0, mirror: bool = false }

fn tween() -> Tween { return Tween { .. }; }

impl Tween {
    fn add_step(self, kind: int, a: float, b: float, seconds: float, e: Ease) -> Tween {
        self.steps.push(TweenStep { kind: kind, a: a, b: b, seconds: seconds, ease: e, .. });
        return self;
    }
    fn move_to(self, to: Vec2, seconds: float, e: Ease) -> Tween { return self.add_step(0, to.x, to.y, seconds, e); }
    fn move_by(self, by: Vec2, seconds: float, e: Ease) -> Tween { return self.add_step(1, by.x, by.y, seconds, e); }
    fn scale_to(self, to: Vec2, seconds: float, e: Ease) -> Tween { return self.add_step(2, to.x, to.y, seconds, e); }
    fn rotate_to(self, radians: float, seconds: float, e: Ease) -> Tween { return self.add_step(3, radians, 0.0, seconds, e); }
    fn rotate_by(self, radians: float, seconds: float, e: Ease) -> Tween { return self.add_step(4, radians, 0.0, seconds, e); }
    // Sprite alpha, 0.0 to 1.0.
    fn fade_to(self, alpha: float, seconds: float, e: Ease) -> Tween { return self.add_step(5, alpha, 0.0, seconds, e); }
    // Camera zoom.
    fn zoom_to(self, zoom: float, seconds: float, e: Ease) -> Tween { return self.add_step(6, zoom, 0.0, seconds, e); }
    fn tint_to(self, c: Color, seconds: float, e: Ease) -> Tween {
        self.steps.push(TweenStep { kind: 7, a: c.r, b: c.g, c: c.b, d: c.a, seconds: seconds, ease: e });
        return self;
    }
    fn delay(self, seconds: float) -> Tween { return self.add_step(8, 0.0, 0.0, seconds, Ease::Linear); }
    fn repeat(self, times: int) -> Tween {
        self.loops = times;
        self.mirror = false;
        return self;
    }
    fn yoyo(self, times: int) -> Tween {
        self.loops = times;
        self.mirror = true;
        return self;
    }
}
struct Name { value: string = "" }

// ---- Hierarchy ----

// Makes the entity's Transform relative to `entity`. With `keep_world`, the
// child's Transform is rewritten when the link is made so it stays where it
// is on screen. `Parent { entity: Entity {}, .. }` detaches it.
struct Parent { entity: Entity = Entity { .. }, keep_world: bool = false }

// The entity's position, rotation and scale after every parent. Assigning
// one moves the entity there in world space.
struct GlobalTransform { position: Vec2 = Vec2 { .. }, rotation: float = 0.0, scale: Vec2 = Vec2 { x: 1.0, y: 1.0 } }

impl Commands {
    // Spawns an entity whose Transform is relative to `parent`.
    fn spawn_child(self, parent: Entity, bundle: any[]) -> Entity {
        bundle.push(Parent { entity: parent, keep_world: false });
        return self.spawn(bundle);
    }
    // Moves `child` under `parent`, keeping its Transform's numbers.
    fn set_parent(self, child: Entity, parent: Entity) { self.insert(child, Parent { entity: parent, keep_world: false }); }
    // Moves `child` under `parent`, keeping it where it is on screen.
    fn set_parent_in_place(self, child: Entity, parent: Entity) { self.insert(child, Parent { entity: parent, keep_world: true }); }
    // Makes `child` a root again, where it is on screen.
    fn detach(self, child: Entity) { self.remove<Parent>(child); }
}

// The entity's parent; `Entity {}` for a root.
fn parent_of(e: Entity) -> Entity { return Entity { id: drift::hier_parent(e.id) }; }
fn ids_to_entities(ids: int[]) -> Entity[] {
    let out: Entity[] = [];
    for id in ids {
        out.push(Entity { id: id });
    }
    return out;
}
// The entity's direct children, in the order they were added.
fn children_of(e: Entity) -> Entity[] { return ids_to_entities(drift::hier_children(e.id)); }
// Everything below the entity, depth first.
fn descendants_of(e: Entity) -> Entity[] { return ids_to_entities(drift::hier_descendants(e.id)); }
// The entity's transform after every parent, from the engine's current
// Transforms (changes a running system made land when it returns).
fn world_transform(e: Entity) -> GlobalTransform {
    let w = drift::hier_world(e.id);
    return GlobalTransform { position: Vec2 { x: w[0], y: w[1] }, rotation: w[2], scale: Vec2 { x: w[3], y: w[4] } };
}
// A point in the entity's space (where a child at `local` would be) to the
// world, and a world point to the entity's space.
fn to_world(e: Entity, local: Vec2) -> Vec2 {
    let p = drift::hier_to_world(e.id, local.x, local.y);
    return Vec2 { x: p[0], y: p[1] };
}
fn to_local(e: Entity, world: Vec2) -> Vec2 {
    let p = drift::hier_to_local(e.id, world.x, world.y);
    return Vec2 { x: p[0], y: p[1] };
}
