//! Scenes and prefabs.

import "drift/core/values" { * };
import "drift/core/world" { * };
import "drift/core/resources" { * };

// ---- Scenes and prefabs ----

//! page: assets

/// A loaded scene or prefab file.
struct Scene {
    /// The engine's id of the loaded file.
    id: int = 0,
}

/// How one copy of a scene spawns: `offset` moves its root entities, `parent` makes them
/// children of an entity, and `overrides` maps an entity's Name to a JSON patch of its
/// components.
struct SceneOptions {
    /// Added to the position of each root entity, in pixels.
    offset: Vec2 = Vec2 { .. },
    /// The entity the roots become children of; no entity leaves them without a parent.
    parent: Entity = Entity { .. },
    /// An entity's Name to a JSON patch of its components, applied to that copy only.
    overrides: {string: string} = {},
}

/// The entities one spawn made, in file order.
struct SceneInstance {
    /// Every entity the spawn made, in file order.
    entities: Entity[] = [],
    /// The entities without a parent in the file.
    roots: Entity[] = [],
    /// Each entity's Name, at the same index as `entities`; "" for one without a Name.
    names: string[] = [],
}
impl SceneInstance {
    /// The first entity with this Name.
    fn find(self, name: string) -> Option<Entity> {
        for i in range(self.names.len()) {
            if self.names[i] == name {
                return Some(self.entities[i]);
            }
        }
        return None;
    }
}

impl Assets {
    /// A scene file, loaded once per path.
    fn scene(self, path: string) -> Scene {
        let id = drift::scene_load(path);
        if id == 0 {
            throw "drift_load_failed: " + path;
        }
        return Scene { id: id };
    }
}

impl Commands {
    /// Spawns a copy of a scene now; its entities and components exist for the systems after
    /// this one.
    fn spawn_scene(self, scene: Scene, o: SceneOptions) -> SceneInstance {
        let names: string[] = [];
        let patches: string[] = [];
        for k in o.overrides.keys() {
            names.push(k);
            patches.push(o.overrides[k]);
        }
        let r = drift::scene_spawn(scene.id, o.offset.x, o.offset.y, o.parent.id, names, patches);
        let inst = SceneInstance { names: drift::scene_names(), .. };
        let n = r[0];
        for i in range(n) {
            inst.entities.push(Entity { id: r[1 + i] });
        }
        for i in range(r[1 + n]) {
            inst.roots.push(Entity { id: r[2 + n + i] });
        }
        return inst;
    }
    /// Writes every entity with a saved component to a scene file, after this system returns.
    fn save_scene(self, path: string) { drift::scene_save(path, 0); }
    /// Writes `root` and its children: a prefab of something built in game.
    fn save_prefab(self, path: string, root: Entity) { drift::scene_save(path, root.id); }
}
