//! Data files and networking.

import "drift/core/host" { * };
import "drift/core/world" { * };
import "drift/core/resources" { * };
import "drift/core/text" { * };

// ---- Data files ----

//! page: data

/// The text of a file, such as one under assets/.
fn read_text(path: string) -> string { return parse_json<string>(read_data(path, "text")); }
/// Internal: the file at `path` as JSON text from the host, read as `format` ("" picks by the
/// extension); throws drift_load_failed when it cannot be read.
fn read_data(path: string, format: string) -> string {
    let j = drift::data_read(path, format);
    if j == "" {
        throw "drift_load_failed: " + path;
    }
    return j;
}

/// A JSON, TOML or CSV file (by its extension) as a value of type T: a struct, a list, a map.
/// Fields the file leaves out keep their zero value. A CSV file is a list of rows, so T is a
/// list: load_data<Item[]>(path).
fn load_data<T>(path: string) -> T { return parse_json<T>(read_data(path, "")); }

/// JSON text as a value of type T.
fn parse_json<T>(text: string) -> T {
    let r = drift::value_from_json(text, drift_type_name<T>());
    if r is string {
        throw "drift_bad_data: " + (r as string);
    }
    return (r as any[])[0] as T;
}

/// Any value as JSON text: structs become objects, enums their variant name.
fn to_json(value: any) -> string { return drift::value_to_json(value); }

impl Save {
    /// A value of any type stored as JSON under `key`, or `fallback`.
    fn get_value<T>(self, key: string, fallback: T) -> T {
        if !drift::save_has(self.name, key) {
            return fallback;
        }
        return parse_json<T>(drift::save_get_string(self.name, key, ""));
    }
    /// Stores a value of any type as JSON under `key`; read it back with `get_value`.
    ///
    /// ```rust
    /// save.set_value("inventory", player.items);
    /// ```
    fn set_value(self, key: string, value: any) { drift::save_set_string(self.name, key, to_json(value)); }
}

// ---- Networking ----

/// A request in flight. Its answer arrives as an HttpResponse message.
struct Request {
    /// The engine's number for the request; compare it with `HttpResponse.request.id`
    id: int = 0,
}

/// The answer to a request. `ok` is true for a 2xx status; `status` is 0 and `error` says why
/// when there was no answer at all (offline, blocked by CORS, a bad URL).
@message
struct HttpResponse {
    /// The request this answers
    request: Request,
    /// The HTTP status code, such as 200 or 404; 0 when there was no answer
    status: int,
    /// Whether the status is in the 200s
    ok: bool,
    /// The answer's body, as text
    body: string,
    /// Why there was no answer; "" when there was one
    error: string,
}

/// Sends a GET request to `url`; the answer arrives later as an HttpResponse message.
/// Requests work only in the web build; elsewhere the answer is an error.
///
/// ```rust
/// let req = http_get("https://example.com/scores.json");
/// ```
fn http_get(url: string) -> Request { return Request { id: drift::http_request("GET", url, "", "") }; }

/// Sends a POST request with `body` as JSON: `http_post(url, to_json(score))`. The answer
/// arrives later as an HttpResponse message.
fn http_post(url: string, body: string) -> Request {
    return Request { id: drift::http_request("POST", url, body, "{\"Content-Type\": \"application/json\"}") };
}

/// Sends a request with any method and headers; the answer arrives later as an HttpResponse
/// message.
fn http_request(method: string, url: string, body: string, headers: {string: string}) -> Request {
    return Request { id: drift::http_request(method, url, body, to_json(headers)) };
}

/// A WebSocket connection. What happens on it arrives as SocketEvent messages.
struct Socket {
    /// The engine's number for the socket; compare it with `SocketEvent.socket.id`
    id: int = 0,
}

/// What happened on a Socket.
enum SocketEventKind {
    /// The connection is open; `send` works from now on
    Opened,
    /// A message arrived; `text` holds it
    Message,
    /// The connection closed; `code` is the close code and `text` the reason
    Closed,
    /// Something went wrong; `text` says what. A Closed event follows when the connection ends
    Error,
}

/// Something that happened on a WebSocket: it opened, a message arrived, it closed, or it
/// failed. Sockets work only in the web build; elsewhere a socket reports an Error and closes.
///
/// ```rust
/// @system
/// fn chat(events: SocketEvent[]) {
///     for e in events {
///         if e.kind == SocketEventKind::Message { log(e.text); }
///     }
/// }
/// ```
@message
struct SocketEvent {
    /// The socket it happened on
    socket: Socket,
    /// What happened
    kind: SocketEventKind,
    /// The message for Message, the reason for Closed, the cause for Error
    text: string,
    /// The WebSocket close code for Closed (1000 is a normal close, 1006 a lost connection); 0
    /// otherwise
    code: int,
}

/// Opens a WebSocket to a ws:// or wss:// URL. Send once Opened has arrived.
fn websocket(url: string) -> Socket { return Socket { id: drift::ws_open(url) }; }
impl Socket {
    /// False when the socket is not open.
    fn send(self, text: string) -> bool { return drift::ws_send(self.id, text); }
    /// Closes the connection with code 1000; a Closed event follows.
    fn close(self) { drift::ws_close(self.id); }
}
