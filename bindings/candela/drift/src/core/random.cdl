// Random numbers and noise.

import "drift/core/values" { * };
import "drift/core/procgen" { * };

// ---- Random numbers ----

// A seeded generator: the engine's PCG32, so a seed gives the same numbers
// here, in C++ and in the browser. Keep one in a resource to carry on;
// copy() it to replay a sequence later.
struct Rng { hi: int = 0, lo: int = 0, inc: int = 1 }

// A generator seeded with `seed`.
fn rng(seed: int) -> Rng { return rng_state(drift::rng_seed(seed, 0)); }
// Another sequence for the same seed: generators with different streams
// do not repeat each other.
fn rng_stream(seed: int, stream: int) -> Rng { return rng_state(drift::rng_seed(seed, stream)); }
// A seed from text, for seeds players type: rng(seed_from("daily-2026-11-12")).
fn seed_from(text: string) -> int { return drift::hash_text(text); }
fn rng_state(s: int[]) -> Rng { return Rng { hi: s[0], lo: s[1], inc: s[2] }; }

impl Rng {
    fn ints(self, op: string, a: int, b: int) -> int[] {
        let r = drift::rng_int(self.hi, self.lo, self.inc, op, a, b);
        self.hi = r[0];
        self.lo = r[1];
        return r;
    }
    fn floats(self, op: string, a: float, b: float) -> float[] {
        let r = drift::rng_float(self.hi, self.lo, self.inc, op, a, b);
        self.hi = int(r[0]);
        self.lo = int(r[1]);
        return r;
    }
    // 32 random bits, 0 to 4294967295.
    fn next_int(self) -> int { return self.ints("next_int", 0, 0)[2]; }
    // 0.0 up to, not including, 1.0.
    fn next_float(self) -> float { return self.floats("next_float", 0.0, 0.0)[2]; }
    // 0 up to, not including, n.
    fn below(self, n: int) -> int { return self.ints("below", n, 0)[2]; }
    // lo to hi, both included.
    fn range(self, lo: int, hi: int) -> int { return self.ints("range", lo, hi)[2]; }
    // lo up to, not including, hi.
    fn range_float(self, lo: float, hi: float) -> float { return self.floats("range", lo, hi)[2]; }
    fn chance(self, p: float) -> bool { return self.floats("chance", p, 0.0)[2] > 0.5; }
    // -1.0 or 1.0.
    fn sign(self) -> float { return self.floats("sign", 0.0, 0.0)[2]; }
    // Radians, 0 to tau.
    fn angle(self) -> float { return self.floats("angle", 0.0, 0.0)[2]; }
    fn unit_vector(self) -> Vec2 {
        let r = self.floats("unit_vector", 0.0, 0.0);
        return Vec2 { x: r[2], y: r[3] };
    }
    fn inside_circle(self, radius: float) -> Vec2 {
        let r = self.floats("inside_circle", radius, 0.0);
        return Vec2 { x: r[2], y: r[3] };
    }
    fn inside_rect(self, r: Rect) -> Vec2 {
        let x = self.range_float(r.x, r.x + r.w);
        return Vec2 { x: x, y: self.range_float(r.y, r.y + r.h) };
    }
    // A Gaussian sample.
    fn normal(self, mean: float, stddev: float) -> float { return self.floats("normal", mean, stddev)[2]; }
    // An index chosen in proportion to its weight; -1 when no weight is
    // above zero.
    fn weighted(self, weights: float[]) -> int {
        let r = drift::rng_weighted(self.hi, self.lo, self.inc, weights);
        self.hi = r[0];
        self.lo = r[1];
        return r[2];
    }
    // A random element. The array must not be empty.
    fn pick<T>(self, items: T[]) -> T { return items[self.below(items.len())]; }
    // The items in a random order.
    fn shuffle<T>(self, items: T[]) -> T[] {
        let order = self.ints("shuffle", items.len(), 0);
        let out: T[] = [];
        for i in range(items.len()) {
            out.push(items[order[i + 2]]);
        }
        return out;
    }
    // A generator at the same point, to replay what this one produces next.
    fn copy(self) -> Rng { return Rng { hi: self.hi, lo: self.lo, inc: self.inc }; }
    // A new generator seeded from this one: its own sequence for a sub-task.
    fn split(self) -> Rng {
        let r = self.ints("split", 0, 0);
        return Rng { hi: r[2], lo: r[3], inc: r[4] };
    }
}

// The game's seed from drift.toml [random], and a generator per purpose.
struct Random { id: int = 0 }
impl Random {
    fn seed(self) -> int { return drift::random_seed(); }
    // The same name gives the same generator for the same seed.
    fn stream(self, name: string) -> Rng { return rng_state(drift::random_stream(name)); }
}

// Items rolled by weight: loot, spawns, room types.
struct WeightedTable<T> { items: T[], weights: float[] }
fn weighted_table<T>() -> WeightedTable<T> {
    let items: T[] = [];
    let weights: float[] = [];
    return WeightedTable { items: items, weights: weights };
}
impl WeightedTable<T> {
    fn add(self, item: T, weight: float) -> WeightedTable<T> {
        self.items.push(item);
        self.weights.push(weight);
        return self;
    }
    fn roll(self, rng: Rng) -> Option<T> {
        let i = rng.weighted(self.weights);
        if i < 0 {
            return None;
        }
        return Some(self.items[i]);
    }
}

// ---- Noise ----

enum NoiseType { Value, Perlin, Simplex }

// A noise recipe. Samples are -1.0 to 1.0; the same seed gives the same
// field everywhere. `frequency` scales positions (0.05 makes features about
// 20 units across), `octaves` layers finer detail, and `warp` bends the
// field by up to that many units.
struct Noise {
    seed: int = 0,
    kind: NoiseType = NoiseType::Simplex,
    frequency: float = 1.0,
    octaves: int = 1,
    lacunarity: float = 2.0,
    gain: float = 0.5,
    warp: float = 0.0,
    warp_frequency: float = 1.0,
}
fn noise(seed: int) -> Noise { return Noise { seed: seed, .. }; }
impl Noise {
    fn type_code(self) -> int {
        return match self.kind { NoiseType::Value => 0, NoiseType::Perlin => 1, NoiseType::Simplex => 2 };
    }
    fn sample(self, x: float, y: float) -> float {
        return drift::noise_sample(self.seed, self.type_code(), self.frequency, self.octaves, self.lacunarity,
                                   self.gain, self.warp, self.warp_frequency, x, y);
    }
    // w x h samples, row by row, starting at `from` and `step` apart.
    fn samples(self, from: Vec2, w: int, h: int, step: float) -> float[] {
        return drift::noise_grid(self.seed, self.type_code(), self.frequency, self.octaves, self.lacunarity,
                                 self.gain, self.warp, self.warp_frequency, from.x, from.y, w, h, step);
    }
    // A grid from the noise at each cell's center: `above` where it is at
    // least `threshold`, `below` elsewhere.
    fn grid(self, w: int, h: int, threshold: float, above: int, below: int) -> Grid {
        let cells = drift::noise_cells(self.seed, self.type_code(), self.frequency, self.octaves, self.lacunarity,
                                       self.gain, self.warp, self.warp_frequency, w, h, threshold, above, below);
        return Grid { width: w, height: h, cells: cells };
    }
}
