// Grids, level generators, pathfinding, sight lines and steering.

import "drift/core/values" { * };
import "drift/core/components" { * };
import "drift/core/random" { * };
import "drift/core/text" { * };

// ---- Grids ----

// The generators write FLOOR for open cells and WALL for solid ones;
// dungeons add DOOR. Your own values can be anything.
const FLOOR: int = 0;
const WALL: int = 1;
const DOOR: int = 2;

struct Cell { x: int = 0, y: int = 0 }
fn cell(x: int, y: int) -> Cell { return Cell { x: x, y: y }; }

// A rectangle of integer cells, row by row from the top-left.
struct Grid { width: int = 0, height: int = 0, cells: int[] = [] }
fn grid(width: int, height: int, value: int) -> Grid {
    let cells: int[] = [];
    for i in range(width * height) {
        cells.push(value);
    }
    return Grid { width: width, height: height, cells: cells };
}
impl Grid {
    fn in_bounds(self, c: Cell) -> bool { return c.x >= 0 && c.y >= 0 && c.x < self.width && c.y < self.height; }
    // The value at a cell; WALL outside the grid.
    fn get(self, c: Cell) -> int {
        if !self.in_bounds(c) {
            return WALL;
        }
        return self.cells[c.y * self.width + c.x];
    }
    fn set(self, c: Cell, value: int) {
        if self.in_bounds(c) {
            self.cells[c.y * self.width + c.x] = value;
        }
    }
    fn count(self, value: int) -> int {
        let n = 0;
        for v in self.cells {
            if v == value {
                n += 1;
            }
        }
        return n;
    }
    // Every cell holding `value`, row by row.
    fn cells_of(self, value: int) -> Cell[] {
        let out: Cell[] = [];
        for i in range(self.cells.len()) {
            if self.cells[i] == value {
                out.push(Cell { x: i % self.width, y: i / self.width });
            }
        }
        return out;
    }
    fn op(self, name: string, a: int, b: int, c: int) {
        self.cells = drift::grid_op(self.width, self.height, self.cells, name, a, b, c);
    }
    // Keeps the largest connected region of `value`; the others become `fill`.
    fn keep_largest_region(self, value: int, fill: int) { self.op("keep_largest", value, fill, 0); }
    // Regions of `value` under `min_size` cells become `fill`.
    fn remove_small_regions(self, value: int, min_size: int, fill: int) { self.op("remove_small", value, min_size, fill); }
    // Carves tunnels of `value` so every region of it is connected.
    fn connect_regions(self, value: int, width: int) { self.op("connect", value, width, 0); }
    // The sizes of the connected regions of `value`, in cells.
    fn region_sizes(self, value: int) -> int[] {
        return drift::grid_op(self.width, self.height, self.cells, "regions", value, 0, 0);
    }
    // 1 where `from` can reach through cells of its own value, 0 elsewhere.
    fn flood_fill(self, from: Cell) -> Grid {
        return Grid { width: self.width, height: self.height,
                      cells: drift::grid_op(self.width, self.height, self.cells, "flood", from.x, from.y, 0) };
    }
}

// ---- Generators ----

fn grid_answer(rng: Rng, r: int[]) -> Grid {
    rng.hi = r[0];
    rng.lo = r[1];
    let w = r[2];
    let h = r[3];
    return Grid { width: w, height: h, cells: r[4..4 + w * h] };
}

// Cellular-automata caves: random walls smoothed into caverns.
struct CaveOptions {
    wall_chance: float = 0.45,   // chance a cell starts as wall, 0 to 1
    steps: int = 5,              // smoothing passes
    birth: int = 5,              // walls among 8 neighbours that make a wall
    survive: int = 4,            // walls among 8 neighbours that keep a wall
    solid_edges: bool = true,
    keep_largest: bool = true,   // fill every cavern but the largest
}
fn cave(rng: Rng, width: int, height: int, o: CaveOptions) -> Grid {
    return grid_answer(rng, drift::gen_cave(rng.hi, rng.lo, rng.inc, width, height, o.wall_chance, o.steps, o.birth,
                                            o.survive, o.solid_edges, o.keep_largest));
}

// A rectangle of cells: a dungeon room.
struct GridRect { x: int = 0, y: int = 0, w: int = 0, h: int = 0 }
impl GridRect {
    fn center(self) -> Cell { return Cell { x: self.x + self.w / 2, y: self.y + self.h / 2 }; }
    fn contains(self, c: Cell) -> bool { return c.x >= self.x && c.y >= self.y && c.x < self.x + self.w && c.y < self.y + self.h; }
}

struct DungeonOptions {
    min_room: int = 4,
    max_room: int = 10,
    padding: int = 1,             // wall kept around each room inside its partition
    corridor_width: int = 1,
    extra_corridors: int = 2,     // loops on top of the corridors that join every room
    doors: bool = true,
}
struct Dungeon { grid: Grid, rooms: GridRect[] }

// Rooms in a binary space partition, joined by corridors so every room is
// reachable.
fn dungeon(rng: Rng, width: int, height: int, o: DungeonOptions) -> Dungeon {
    let r = drift::gen_dungeon(rng.hi, rng.lo, rng.inc, width, height, o.min_room, o.max_room, o.padding,
                               o.corridor_width, o.extra_corridors, o.doors);
    let g = grid_answer(rng, r);
    let at = 4 + width * height;
    let rooms: GridRect[] = [];
    for i in range(r[at]) {
        let k = at + 1 + i * 4;
        rooms.push(GridRect { x: r[k], y: r[k + 1], w: r[k + 2], h: r[k + 3] });
    }
    return Dungeon { grid: g, rooms: rooms };
}

struct WalkOptions {
    coverage: float = 0.4,        // stop once this share of the cells is floor
    walkers: int = 1,
    turn_chance: float = 0.4,
    brush: int = 1,               // carves brush x brush cells per step
    start: Cell = Cell { x: -1, y: -1 },   // -1, -1: the middle
}
// Walkers wander from the start and carve floor out of solid wall.
fn random_walk(rng: Rng, width: int, height: int, o: WalkOptions) -> Grid {
    return grid_answer(rng, drift::gen_walk(rng.hi, rng.lo, rng.inc, width, height, o.coverage, o.walkers,
                                            o.turn_chance, o.brush, o.start.x, o.start.y));
}

fn points_answer(rng: Rng, r: float[]) -> Vec2[] {
    rng.hi = int(r[0]);
    rng.lo = int(r[1]);
    let out: Vec2[] = [];
    let n = (r.len() - 2) / 2;
    for i in range(n) {
        out.push(Vec2 { x: r[2 + i * 2], y: r[3 + i * 2] });
    }
    return out;
}

// Points in `area` no closer than `min_distance` to each other: even
// spacing without a pattern, for trees, rocks and spawn points.
fn poisson_disk(rng: Rng, area: Rect, min_distance: float) -> Vec2[] {
    return points_answer(rng, drift::gen_poisson(rng.hi, rng.lo, rng.inc, area.x, area.y, area.w, area.h, min_distance, 30));
}
// The same over the cells of `g` holding `value`, in cell units: a point at
// (3.5, 2.5) is the middle of cell (3, 2).
fn poisson_on_grid(rng: Rng, g: Grid, value: int, min_distance: float) -> Vec2[] {
    return points_answer(rng, drift::gen_poisson_grid(rng.hi, rng.lo, rng.inc, g.width, g.height, g.cells, value,
                                                      min_distance, 30));
}

struct WfcOptions {
    attempts: int = 10,       // restarts after a contradiction
    periodic: bool = false,   // neighbours wrap around the edges
    // Cells to fix before collapsing: a grid of the output size where a
    // value from the sample forces that value and any other (such as -1)
    // leaves the cell free. Empty for none.
    preset: Grid = Grid { .. },
}
// Wave function collapse: a width x height grid where every pair of
// neighbouring values also sits side by side somewhere in `sample`, with
// values about as common as there. None when every attempt contradicted
// itself.
fn wfc(rng: Rng, sample: Grid, width: int, height: int, o: WfcOptions) -> Option<Grid> {
    let g = grid_answer(rng, drift::gen_wfc(rng.hi, rng.lo, rng.inc, sample.width, sample.height, sample.cells,
                                            width, height, o.attempts, o.periodic, o.preset.cells));
    if g.width == 0 {
        return None;
    }
    return Some(g);
}

// ---- Pathfinding ----

// Which neighbours a step on a grid can go to: the four beside a cell, or
// the diagonals too (never cutting a blocked corner).
enum Moves { FourWay, EightWay }

// The cells from start to goal, both included, avoiding cells whose value
// is in `blocked`; empty when there is no way.
fn find_path(g: Grid, start: Cell, goal: Cell, blocked: int[], moves: Moves) -> Cell[] {
    let r = drift::path_find(g.width, g.height, g.cells, blocked, start.x, start.y, goal.x, goal.y, moves == Moves::EightWay);
    let out: Cell[] = [];
    for i in range(r.len() / 2) {
        out.push(Cell { x: r[i * 2], y: r[i * 2 + 1] });
    }
    return out;
}

// For every cell, the next step toward the nearest goal: one field steers
// any number of chasers.
struct FlowField { width: int = 0, height: int = 0, next: int[] = [], costs: float[] = [] }
fn flow_field(g: Grid, goals: Cell[], blocked: int[], moves: Moves) -> FlowField {
    let flat: int[] = [];
    for c in goals {
        flat.push(c.x);
        flat.push(c.y);
    }
    let r = drift::flow_field(g.width, g.height, g.cells, blocked, flat, moves == Moves::EightWay);
    let n = g.width * g.height;
    let next: int[] = [];
    for i in range(n) {
        next.push(int(r[i]));
    }
    return FlowField { width: g.width, height: g.height, next: next, costs: r[n..n * 2] };
}
impl FlowField {
    fn in_bounds(self, c: Cell) -> bool { return c.x >= 0 && c.y >= 0 && c.x < self.width && c.y < self.height; }
    // Steps to the nearest goal; -1.0 when none is reachable.
    fn cost(self, c: Cell) -> float {
        if !self.in_bounds(c) {
            return -1.0;
        }
        return self.costs[c.y * self.width + c.x];
    }
    // The neighbour one step closer; the cell itself at a goal or where no
    // goal is reachable.
    fn step(self, c: Cell) -> Cell {
        if !self.in_bounds(c) {
            return c;
        }
        let n = self.next[c.y * self.width + c.x];
        if n < 0 {
            return c;
        }
        return Cell { x: n % self.width, y: n / self.width };
    }
    // Unit vector toward the next step, for a cell.
    fn direction(self, c: Cell) -> Vec2 {
        let n = self.step(c);
        return Vec2 { x: float(n.x - c.x), y: float(n.y - c.y) }.normalized();
    }
    // The same for a world position, with cells `cell_size` wide from the
    // origin.
    fn direction_at(self, p: Vec2, cell_size: float) -> Vec2 {
        return self.direction(Cell { x: int((p.x / cell_size).floor()), y: int((p.y / cell_size).floor()) });
    }
}

// ---- Sight on grids ----

// The cells `from` sees within `radius` cells, as a grid of the same size:
// 1 where visible, 0 elsewhere. Cells whose value is in `opaque` block
// sight and are seen themselves. Symmetric: if a sees b, b sees a.
fn field_of_view(g: Grid, from: Cell, radius: int, opaque: int[]) -> Grid {
    return Grid { width: g.width, height: g.height,
                  cells: drift::grid_fov(g.width, g.height, g.cells, opaque, from.x, from.y, radius) };
}
// Whether no opaque cell lies strictly between a and b.
fn line_of_sight(g: Grid, a: Cell, b: Cell, opaque: int[]) -> bool {
    return drift::grid_los(g.width, g.height, g.cells, opaque, a.x, a.y, b.x, b.y);
}
// The cells of the straight line from a to b, both included.
fn grid_line(a: Cell, b: Cell) -> Cell[] {
    let r = drift::grid_line(a.x, a.y, b.x, b.y);
    let out: Cell[] = [];
    for i in range(r.len() / 2) {
        out.push(Cell { x: r[i * 2], y: r[i * 2 + 1] });
    }
    return out;
}

// ---- Steering ----
//
// Craig Reynolds' steering behaviors, the engine's own: each returns a
// steering force, a change of velocity per second, toward one goal. Add
// the ones you want, weighted, cap the sum and integrate:
//
//     let force = steer_arrive(t.position, v.linear, goal, 120.0, 64.0)
//               + steer_separation(t.position, near, 24.0, 120.0) * 1.5;
//     v.linear = steer_truncate(v.linear + steer_truncate(force, 400.0) * time.dt, 120.0);

fn flat(points: Vec2[]) -> float[] {
    let out: float[] = [];
    for p in points {
        out.push(p.x);
        out.push(p.y);
    }
    return out;
}
fn steer_call(op: string, nums: float[], a: Vec2[], b: Vec2[]) -> float[] { return drift::steer(op, nums, flat(a), flat(b), []); }
fn steer_vec(r: float[]) -> Vec2 { return Vec2 { x: r[0], y: r[1] }; }

// `v` shortened to at most `max_length`.
fn steer_truncate(v: Vec2, max_length: float) -> Vec2 { return steer_vec(steer_call("truncate", [v.x, v.y, max_length], [], [])); }
// Full speed toward the target.
fn steer_seek(pos: Vec2, vel: Vec2, target: Vec2, max_speed: float) -> Vec2 {
    return steer_vec(steer_call("seek", [pos.x, pos.y, vel.x, vel.y, target.x, target.y, max_speed], [], []));
}
// Full speed away from the threat while it is within `panic_radius` (0:
// always).
fn steer_flee(pos: Vec2, vel: Vec2, threat: Vec2, max_speed: float, panic_radius: float) -> Vec2 {
    return steer_vec(steer_call("flee", [pos.x, pos.y, vel.x, vel.y, threat.x, threat.y, max_speed, panic_radius], [], []));
}
// Toward the target, slowing inside `slow_radius` to stop on it.
fn steer_arrive(pos: Vec2, vel: Vec2, target: Vec2, max_speed: float, slow_radius: float) -> Vec2 {
    return steer_vec(steer_call("arrive", [pos.x, pos.y, vel.x, vel.y, target.x, target.y, max_speed, slow_radius], [], []));
}
// Seek where a moving target will be.
fn steer_pursue(pos: Vec2, vel: Vec2, target: Vec2, target_vel: Vec2, max_speed: float) -> Vec2 {
    return steer_vec(steer_call("pursue", [pos.x, pos.y, vel.x, vel.y, target.x, target.y, target_vel.x, target_vel.y,
                                           max_speed], [], []));
}
// Flee from where a moving threat will be.
fn steer_evade(pos: Vec2, vel: Vec2, threat: Vec2, threat_vel: Vec2, max_speed: float, panic_radius: float) -> Vec2 {
    return steer_vec(steer_call("evade", [pos.x, pos.y, vel.x, vel.y, threat.x, threat.y, threat_vel.x, threat_vel.y,
                                          max_speed, panic_radius], [], []));
}
// Away from neighbours closer than `radius`, harder the closer they are.
fn steer_separation(pos: Vec2, neighbours: Vec2[], radius: float, max_speed: float) -> Vec2 {
    return steer_vec(steer_call("separation", [pos.x, pos.y, radius, max_speed], neighbours, []));
}
// Toward the middle of the neighbours within `radius`.
fn steer_cohesion(pos: Vec2, vel: Vec2, neighbours: Vec2[], radius: float, max_speed: float) -> Vec2 {
    return steer_vec(steer_call("cohesion", [pos.x, pos.y, vel.x, vel.y, radius, max_speed], neighbours, []));
}
// Toward the average heading of the neighbours within `radius`.
fn steer_alignment(pos: Vec2, vel: Vec2, positions: Vec2[], velocities: Vec2[], radius: float, max_speed: float) -> Vec2 {
    return steer_vec(steer_call("alignment", [pos.x, pos.y, vel.x, vel.y, radius, max_speed], positions, velocities));
}

// An agent's wandering: keep one per agent, in a component.
struct Wander { angle: float = 0.0, distance: float = 40.0, radius: float = 20.0, jitter: float = 0.5 }
// Aimless but smooth: each call turns the wander angle by up to `jitter`
// radians and steers toward a point on a circle ahead.
fn steer_wander(vel: Vec2, w: Wander, rng: Rng, max_speed: float) -> Vec2 {
    let r = drift::steer("wander", [vel.x, vel.y, w.angle, max_speed, w.distance, w.radius, w.jitter], [], [],
                         [rng.hi, rng.lo, rng.inc]);
    w.angle = r[2];
    rng.hi = int(r[3]);
    rng.lo = int(r[4]);
    return steer_vec(r);
}

// An agent's place along a path: keep one per agent, starting at 0.
struct PathFollow { index: int = 0, reach_radius: float = 8.0, slow_radius: float = 0.0 }
// Seeks each point in turn, moving on within `reach_radius`, and arrives
// at the last one.
fn steer_follow_path(pos: Vec2, vel: Vec2, path: Vec2[], f: PathFollow, max_speed: float) -> Vec2 {
    let r = steer_call("follow_path", [pos.x, pos.y, vel.x, vel.y, float(f.index), max_speed, f.reach_radius,
                                       f.slow_radius], path, []);
    f.index = int(r[2]);
    return steer_vec(r);
}
