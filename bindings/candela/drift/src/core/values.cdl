// Vectors, rectangles and colors, and the math helpers that work on them.

import "drift/core/host" { * };
import "drift/core/components" { * };
import "drift/core/random" { * };
import "drift/core/animation" { * };

// ---- Values ----

struct Vec2 { x: float = 0.0, y: float = 0.0 }
fn vec2(x: float, y: float) -> Vec2 { return Vec2 { x: x, y: y }; }
impl Vec2 {
    fn +(self, o: Vec2) -> Vec2 { return Vec2 { x: self.x + o.x, y: self.y + o.y }; }
    fn -(self, o: Vec2) -> Vec2 { return Vec2 { x: self.x - o.x, y: self.y - o.y }; }
    fn -(self) -> Vec2 { return Vec2 { x: -self.x, y: -self.y }; }
    fn *(self, s: float) -> Vec2 { return Vec2 { x: self.x * s, y: self.y * s }; }
    fn /(self, s: float) -> Vec2 { return Vec2 { x: self.x / s, y: self.y / s }; }
    fn dot(self, o: Vec2) -> float { return self.x * o.x + self.y * o.y; }
    fn length(self) -> float { return (self.x * self.x + self.y * self.y).sqrt(); }
    fn distance(self, o: Vec2) -> float { return (self - o).length(); }
    fn normalized(self) -> Vec2 {
        let l = self.length();
        if l == 0.0 {
            return Vec2 { .. };
        }
        return self / l;
    }
    fn lerp(self, o: Vec2, t: float) -> Vec2 { return self + (o - self) * t; }
}

struct Rect { x: float = 0.0, y: float = 0.0, w: float = 0.0, h: float = 0.0 }
fn rect(x: float, y: float, w: float, h: float) -> Rect { return Rect { x: x, y: y, w: w, h: h }; }
impl Rect {
    fn contains(self, p: Vec2) -> bool {
        return p.x >= self.x && p.y >= self.y && p.x < self.x + self.w && p.y < self.y + self.h;
    }
    fn overlaps(self, o: Rect) -> bool {
        return self.x < o.x + o.w && o.x < self.x + self.w && self.y < o.y + o.h && o.y < self.y + self.h;
    }
    fn center(self) -> Vec2 { return Vec2 { x: self.x + self.w * 0.5, y: self.y + self.h * 0.5 }; }
}

struct Color { r: float = 1.0, g: float = 1.0, b: float = 1.0, a: float = 1.0 }
fn rgb(r: int, g: int, b: int) -> Color {
    return Color { r: float(r) / 255.0, g: float(g) / 255.0, b: float(b) / 255.0, a: 1.0 };
}
fn rgba(r: int, g: int, b: int, a: int) -> Color {
    return Color { r: float(r) / 255.0, g: float(g) / 255.0, b: float(b) / 255.0, a: float(a) / 255.0 };
}
impl Color {
    fn alpha(self, a: float) -> Color { return Color { r: self.r, g: self.g, b: self.b, a: a }; }
}

// An entity's id. `Entity {}` is no entity.
struct Entity { id: int = 0 }
impl Entity {
    // Whether the entity exists: false for `Entity {}` and after a despawn
    // has been applied.
    fn alive(self) -> bool { return drift::entity_alive(self.id); }
}

fn hud_layer() -> int { return 31; }

// Numbers held between bounds, and the smaller or larger of two.
fn clamp(x: float, lo: float, hi: float) -> float {
    if x < lo {
        return lo;
    }
    if x > hi {
        return hi;
    }
    return x;
}
fn min(a: float, b: float) -> float {
    if a < b {
        return a;
    }
    return b;
}
fn max(a: float, b: float) -> float {
    if a > b {
        return a;
    }
    return b;
}
fn log(message: string) { drift::log_message(0, message); }
fn warn(message: string) { drift::log_message(1, message); }

enum Align { Left, Center, Right }
enum VAlign { Top, Middle, Bottom }
enum Blend { Alpha, Additive, Multiply, Screen, Premultiplied, Opaque }
enum Filter { Nearest, Linear }
enum BodyKind { Static, Dynamic, Kinematic }

// ---- Math helpers ----

// Where x sits between a and b: 0.0 at a, 1.0 at b.
fn inverse_lerp(a: float, b: float, x: float) -> float {
    if a == b {
        return 0.0;
    }
    return (x - a) / (b - a);
}
// x moved from the range a..b to the range c..d.
fn remap(x: float, a: float, b: float, c: float, d: float) -> float { return lerp(c, d, inverse_lerp(a, b, x)); }
// x wrapped into lo up to, not including, hi: angles, looping worlds.
fn wrap(x: float, lo: float, hi: float) -> float {
    let span = hi - lo;
    if span <= 0.0 {
        return lo;
    }
    let r = x - span * ((x - lo) / span).floor();
    if r >= hi {
        return lo;
    }
    return r;
}
// -1.0, 0.0 or 1.0.
fn sign(x: float) -> float {
    if x > 0.0 {
        return 1.0;
    }
    if x < 0.0 {
        return -1.0;
    }
    return 0.0;
}
fn radians(degrees: float) -> float { return degrees * PI / 180.0; }
fn degrees(radians: float) -> float { return radians * 180.0 / PI; }

impl Vec2 {
    fn cross(self, o: Vec2) -> float { return self.x * o.y - self.y * o.x; }
    // Toward target by at most max_distance, never past it.
    fn move_towards(self, target: Vec2, max_distance: float) -> Vec2 {
        let d = target - self;
        let l = d.length();
        if l <= max_distance || l == 0.0 {
            return target;
        }
        return self + d / l * max_distance;
    }
    // Bounced off a surface with this normal.
    fn reflect(self, normal: Vec2) -> Vec2 {
        let n = normal.normalized();
        return self - n * (2.0 * self.dot(n));
    }
}

impl Rect {
    // The point inside the rect nearest p.
    fn clamp_point(self, p: Vec2) -> Vec2 {
        return Vec2 { x: clamp(p.x, self.x, self.x + self.w), y: clamp(p.y, self.y, self.y + self.h) };
    }
    // Grown by `by` on every side; negative shrinks it.
    fn expand(self, by: float) -> Rect {
        return Rect { x: self.x - by, y: self.y - by, w: self.w + by * 2.0, h: self.h + by * 2.0 };
    }
    // A rect of size w x h centred on c.
    fn centered_at(self, c: Vec2) -> Rect {
        return Rect { x: c.x - self.w * 0.5, y: c.y - self.h * 0.5, w: self.w, h: self.h };
    }
}

// Whether two circles touch.
fn circles_overlap(a: Vec2, ra: float, b: Vec2, rb: float) -> bool {
    return (a - b).length_squared() <= (ra + rb) * (ra + rb);
}
// Whether a circle touches a rect.
fn circle_overlaps_rect(c: Vec2, r: float, box: Rect) -> bool {
    return (box.clamp_point(c) - c).length_squared() <= r * r;
}
// Where segments a1-a2 and b1-b2 cross, if they do.
fn segments_intersect(a1: Vec2, a2: Vec2, b1: Vec2, b2: Vec2) -> Option<Vec2> {
    let r = a2 - a1;
    let s = b2 - b1;
    let d = r.cross(s);
    if d == 0.0 {
        return None;
    }
    let t = (b1 - a1).cross(s) / d;
    let u = (b1 - a1).cross(r) / d;
    if t < 0.0 || t > 1.0 || u < 0.0 || u > 1.0 {
        return None;
    }
    return Some(a1 + r * t);
}

// ---- Colors ----

// A color from hue, saturation and value, each 0.0 to 1.0 (hue goes once
// around the color wheel: 0.0 red, 0.33 green, 0.67 blue).
fn hsv(h: float, s: float, v: float) -> Color {
    let hh = wrap(h, 0.0, 1.0) * 6.0;
    let i = int(hh.floor());
    let f = hh - float(i);
    let p = v * (1.0 - s);
    let q = v * (1.0 - s * f);
    let t = v * (1.0 - s * (1.0 - f));
    if i == 0 {
        return Color { r: v, g: t, b: p, a: 1.0 };
    }
    if i == 1 {
        return Color { r: q, g: v, b: p, a: 1.0 };
    }
    if i == 2 {
        return Color { r: p, g: v, b: t, a: 1.0 };
    }
    if i == 3 {
        return Color { r: p, g: q, b: v, a: 1.0 };
    }
    if i == 4 {
        return Color { r: t, g: p, b: v, a: 1.0 };
    }
    return Color { r: v, g: p, b: q, a: 1.0 };
}

struct Hsv { h: float = 0.0, s: float = 0.0, v: float = 0.0 }

fn hex_digit(c: string) -> int {
    let digits = "0123456789abcdef";
    return match digits.index_of(c.lowercase()) { Some(i) => i, None => 0 };
}
// A color from "#rgb", "#rrggbb" or "#rrggbbaa" (the # is optional).
fn hex(text: string) -> Color {
    let t = text.trim_start_chars("#");
    if t.len() == 3 {
        t = t[0..1] + t[0..1] + t[1..2] + t[1..2] + t[2..3] + t[2..3];
    }
    if t.len() != 6 && t.len() != 8 {
        throw "drift_bad_color: " + text;
    }
    let ch: float[] = [];
    for i in range(t.len() / 2) {
        ch.push(float(hex_digit(t[i * 2..i * 2 + 1]) * 16 + hex_digit(t[i * 2 + 1..i * 2 + 2])) / 255.0);
    }
    if ch.len() == 3 {
        ch.push(1.0);
    }
    return Color { r: ch[0], g: ch[1], b: ch[2], a: ch[3] };
}

impl Color {
    fn to_hsv(self) -> Hsv {
        let hi = max(self.r, max(self.g, self.b));
        let lo = min(self.r, min(self.g, self.b));
        let d = hi - lo;
        let h = 0.0;
        if d > 0.0 {
            if hi == self.r {
                h = wrap((self.g - self.b) / d, 0.0, 6.0) / 6.0;
            } else if hi == self.g {
                h = ((self.b - self.r) / d + 2.0) / 6.0;
            } else {
                h = ((self.r - self.g) / d + 4.0) / 6.0;
            }
        }
        let s = 0.0;
        if hi > 0.0 {
            s = d / hi;
        }
        return Hsv { h: h, s: s, v: hi };
    }
    // Toward white (amount 0.0 to 1.0), keeping alpha.
    fn lighten(self, amount: float) -> Color {
        return self.lerp(Color { r: 1.0, g: 1.0, b: 1.0, a: self.a }, amount);
    }
    // Toward black, keeping alpha.
    fn darken(self, amount: float) -> Color {
        return self.lerp(Color { r: 0.0, g: 0.0, b: 0.0, a: self.a }, amount);
    }
    // The hue turned by `turn` (1.0 is once around).
    fn shift_hue(self, turn: float) -> Color {
        let c = self.to_hsv();
        return hsv(c.h + turn, c.s, c.v).alpha(self.a);
    }
    // "#rrggbb", or "#rrggbbaa" when not opaque.
    fn to_hex(self) -> string {
        let digits = "0123456789abcdef";
        let out = "#";
        let chans = [self.r, self.g, self.b];
        if self.a < 1.0 {
            chans.push(self.a);
        }
        for c in chans {
            let n = int((clamp(c, 0.0, 1.0) * 255.0).round());
            out = out + digits[n / 16..n / 16 + 1] + digits[n % 16..n % 16 + 1];
        }
        return out;
    }
}

// An ordered set of colors: pick by index, or blend along it as a gradient.
struct Palette { colors: Color[] = [] }
fn palette(hexes: string[]) -> Palette {
    let colors: Color[] = [];
    for h in hexes {
        colors.push(hex(h));
    }
    return Palette { colors: colors };
}
impl Palette {
    fn len(self) -> int { return self.colors.len(); }
    // The color at i, wrapping around the end.
    fn at(self, i: int) -> Color {
        let n = self.colors.len();
        return self.colors[((i % n) + n) % n];
    }
    // A gradient through every color: 0.0 is the first, 1.0 the last.
    fn sample(self, t: float) -> Color {
        let n = self.colors.len();
        if n == 1 {
            return self.colors[0];
        }
        let x = clamp(t, 0.0, 1.0) * float(n - 1);
        let i = int(x.floor());
        if i >= n - 1 {
            return self.colors[n - 1];
        }
        return self.colors[i].lerp(self.colors[i + 1], x - float(i));
    }
    fn random(self, rng: Rng) -> Color { return self.colors[rng.below(self.colors.len())]; }
}
// The PICO-8 sixteen: black, dark blue, purple, dark green, brown, dark grey,
// light grey, white, red, orange, yellow, green, blue, lavender, pink, peach.
fn pico8() -> Palette {
    return palette(["#000000", "#1d2b53", "#7e2553", "#008751", "#ab5236", "#5f574f", "#c2c3c7", "#fff1e8",
                    "#ff004d", "#ffa300", "#ffec27", "#00e436", "#29adff", "#83769c", "#ff77a8", "#ffccaa"]);
}
