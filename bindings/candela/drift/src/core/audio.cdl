// Sound, music and audio buses.

import "drift/core/assets" { * };

// ---- Audio ----

// One playback of a sound, from Sound.play. Every method is safe after the
// sound ended; it then does nothing.
struct Voice { id: int = 0 }
impl Voice {
    fn stop(self, fade: float) { drift::voice_op(self.id, 0, fade, 0.0); }
    fn pause(self, fade: float) { drift::voice_op(self.id, 1, fade, 0.0); }
    fn resume(self, fade: float) { drift::voice_op(self.id, 2, fade, 0.0); }
    // Volume 0 to 1, reached over `fade` seconds.
    fn set_volume(self, volume: float, fade: float) { drift::voice_op(self.id, 3, volume, fade); }
    fn set_pan(self, pan: float) { drift::voice_op(self.id, 4, pan, 0.0); }
    fn set_pitch(self, pitch: float) { drift::voice_op(self.id, 5, pitch, 0.0); }
    fn set_looping(self, looping: bool) {
        let v = 0.0;
        if looping {
            v = 1.0;
        }
        drift::voice_op(self.id, 6, v, 0.0);
    }
    // Until it ends or is stopped; a paused voice counts as playing.
    fn playing(self) -> bool { return drift::voice_op(self.id, 7, 0.0, 0.0) > 0.5; }
    fn paused(self) -> bool { return drift::voice_op(self.id, 8, 0.0, 0.0) > 0.5; }
}

impl Sound {
    // Length in seconds.
    fn duration(self) -> float { return drift::sound_info(self.id, 0, 0); }
    // At most `n` of this sound at once; another start fades out the
    // oldest. 0 for no limit.
    fn set_max_instances(self, n: int) { drift::sound_info(self.id, 1, n); }
}

// A long track, decoded while it plays instead of all at load, loaded once
// per path. Works anywhere, field defaults included.
fn music(path: string) -> Sound {
    let id = drift::music_load(path);
    if id == 0 {
        throw "drift_load_failed: " + path;
    }
    return Sound { id: id };
}

// A mixer bus. Buses form a tree under master; volume, mute and pause
// apply to everything below.
struct Bus { id: int = 0 }
impl Bus {
    fn set_volume(self, volume: float, fade: float) { drift::bus_op(self.id, 0, volume, fade); }
    fn volume(self) -> float { return drift::bus_op(self.id, 1, 0.0, 0.0); }
    fn set_muted(self, muted: bool) { drift::bus_op(self.id, 2, bool_float(muted), 0.0); }
    fn muted(self) -> bool { return drift::bus_op(self.id, 3, 0.0, 0.0) > 0.5; }
    fn set_paused(self, paused: bool) { drift::bus_op(self.id, 4, bool_float(paused), 0.0); }
    fn paused(self) -> bool { return drift::bus_op(self.id, 5, 0.0, 0.0) > 0.5; }
    // Stops every sound on this bus and the buses below it.
    fn stop(self, fade: float) { drift::bus_op(self.id, 6, fade, 0.0); }
}

fn bool_float(b: bool) -> float {
    if b {
        return 1.0;
    }
    return 0.0;
}

// The mixer: music, playlists and buses.
struct Audio { id: int = 0 }
impl Audio {
    // One music track at a time on the music bus; another crossfades over
    // `crossfade` seconds.
    fn play_music(self, track: Sound, crossfade: float, looping: bool) {
        drift::music_op(0, track.id, crossfade, looping);
    }
    // Tracks one after another, `crossfade` seconds apart (0 is gapless).
    fn play_playlist(self, tracks: Sound[], crossfade: float, looping: bool, shuffle: bool) {
        let ids: int[] = [];
        for t in tracks {
            ids.push(t.id);
        }
        drift::music_playlist(ids, crossfade, looping, shuffle, 1.0);
    }
    fn next_track(self) { drift::music_op(5, 0, 0.0, false); }
    fn stop_music(self, fade: float) { drift::music_op(1, 0, fade, false); }
    fn pause_music(self, fade: float) { drift::music_op(2, 0, fade, false); }
    fn resume_music(self, fade: float) { drift::music_op(3, 0, fade, false); }
    fn music_playing(self) -> bool { return drift::music_op(4, 0, 0.0, false) > 0.5; }
    fn master_bus(self) -> Bus { return Bus { id: drift::audio_bus("master", 0) }; }
    fn music_bus(self) -> Bus { return Bus { id: drift::audio_bus("music", 0) }; }
    fn sfx_bus(self) -> Bus { return Bus { id: drift::audio_bus("sfx", 0) }; }
    // The bus of that name under `parent` (Bus {} for master), made the
    // first time it is asked for.
    fn bus(self, name: string, parent: Bus) -> Bus { return Bus { id: drift::audio_bus(name, parent.id) }; }
    // false when no output device opened; sounds then advance silently.
    fn has_device(self) -> bool { return drift::music_op(6, 0, 0.0, false) > 0.5; }
}

enum Rolloff { Linear, Inverse }

// Plays a sound from the entity while it lives. With `spatial`, volume
// and pan follow its position relative to the AudioListener (or the main
// camera): full inside `min_distance`, silent past `max_distance`. The
// engine reads volume, pitch and looping every frame; set `play` to start
// the sound again.
struct AudioSource {
    sound: Sound = Sound { .. },
    bus: Bus = Bus { .. },
    volume: float = 1.0,
    pitch: float = 1.0,
    looping: bool = false,
    autoplay: bool = true,
    spatial: bool = false,
    min_distance: float = 64.0,
    max_distance: float = 1024.0,
    rolloff: Rolloff = Rolloff::Linear,
    priority: int = 0,
    play: bool = false,
}

// The entity spatial sounds are heard from.
struct AudioListener { active: bool = true }
