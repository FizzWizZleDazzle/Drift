//! Particles, post effects, lights and trails.

import "drift/core/host" { * };
import "drift/core/values" { * };
import "drift/core/assets" { * };
import "drift/core/components" { * };
import "drift/core/resources" { * };
import "drift/core/rendering" { * };

// ---- Particles ----

impl Effects {
    /// Starts an emitter's run over: its bursts fire again and a finished one emits anew.
    ///
    /// ```rust
    /// effects.restart_particles(fountain);
    /// ```
    fn restart_particles(self, emitter: Entity) { drift::particles_restart(emitter.id); }
}

// ---- Post effects ----

//! page: resources

/// Bright parts bleed light around them.
///
/// ```rust
/// effects.add(Bloom { threshold: 0.5, intensity: 1.4, levels: 6, tint: rgb(255, 230, 200), .. });
/// ```
struct Bloom {
    /// brightness where it starts, 0 to 1
    threshold: float = 0.7,
    /// 0 cuts off hard, 1 eases in
    soft_knee: float = 0.5,
    intensity: float = 1.0,
    radius: float = 1.0,
    /// 1 to 8; more spreads wider
    levels: int = 5,
    tint: Color = Color { .. },
}

/// Brightness, contrast, saturation and tint, and an optional lookup table: a strip of N slices
/// of N x N, red across a slice, green down it, blue picking the slice.
///
/// ```rust
/// effects.add(ColorGrading { saturation: 0.6, contrast: 1.1, .. });
/// ```
struct ColorGrading {
    brightness: float = 1.0,
    contrast: float = 1.0,
    saturation: float = 1.0,
    tint: Color = Color { .. },
    lut: Texture = Texture { .. },
    lut_strength: float = 1.0,
}

/// ```rust
/// effects.add(Blur { radius: 2.0, iterations: 3 });
/// ```
struct Blur {
    /// Spread in pixels
    radius: float = 1.0,
    /// Passes; more is smoother
    iterations: int = 2,
}

/// ```rust
/// effects.add(Pixelate { size: 6.0 });
/// ```
struct Pixelate {
    /// Block size in pixels
    size: float = 6.0,
}

/// ```rust
/// effects.add(Grayscale { amount: 1.0 });
/// ```
struct Grayscale {
    /// 0 leaves the colors, 1 is fully gray
    amount: float = 1.0,
}

/// ```rust
/// effects.add(Sepia { amount: 0.7 });
/// ```
struct Sepia {
    /// 0 leaves the colors, 1 is fully brown
    amount: float = 1.0,
}

/// ```rust
/// effects.add(Vignette { intensity: 0.8, color: rgb(40, 0, 0), .. });
/// ```
struct Vignette {
    intensity: float = 0.6,
    /// distance from the center where it is full
    radius: float = 0.75,
    /// it starts this far inside `radius`
    softness: float = 0.45,
    color: Color = Color { r: 0.0, g: 0.0, b: 0.0, a: 1.0 },
}

/// ```rust
/// effects.add(Crt { curvature: 0.2, scanlines: 0.5, chromatic_aberration: 2.0, .. });
/// ```
struct Crt {
    curvature: float = 0.15,
    scanlines: float = 0.35,
    scanline_spacing: float = 3.0,
    chromatic_aberration: float = 1.5,
    vignette: float = 0.3,
}

/// A post effect running on the picture.
///
/// ```rust
/// @resource
/// struct Looks { crt: Effect }
///
/// @system
/// fn toggle_crt(input: Input, looks: Looks) {
///     if input.key_pressed(Key::F2) {
///         looks.crt.set_enabled(!looks.crt.enabled());
///     }
/// }
/// ```
struct Effect { id: int = 0 }
impl Effect {
    /// New settings of the same kind as the effect was added with.
    ///
    /// ```rust
    /// glow.set(Bloom { threshold: 0.5, intensity: 2.5, .. });
    /// ```
    fn set(self, settings: any) { drift::effect_set(self.id, settings); }
    /// Switches the effect on or off.
    ///
    /// ```rust
    /// looks.crt.set_enabled(false);
    /// ```
    fn set_enabled(self, on: bool) { drift::effect_op(self.id, "set_enabled", flag(on)); }
    /// Whether the effect is on.
    ///
    /// ```rust
    /// if looks.crt.enabled() { log("crt on"); }
    /// ```
    fn enabled(self) -> bool { return drift::effect_op(self.id, "enabled", 0.0) > 0.5; }
    /// Effects run from the lowest order up.
    ///
    /// ```rust
    /// glow.set_order(10);
    /// ```
    fn set_order(self, order: int) { drift::effect_op(self.id, "set_order", float(order)); }
    /// Removes the effect from the chain.
    ///
    /// ```rust
    /// looks.crt.remove();
    /// ```
    fn remove(self) { drift::effect_op(self.id, "remove", 0.0); }
}

impl Effects {
    /// A post effect from its settings: Bloom, ColorGrading, Blur, Pixelate, Grayscale, Sepia,
    /// Vignette or Crt. Each kind has its own place in the chain; add_at picks one.
    ///
    /// ```rust
    /// let grade = effects.add(ColorGrading { saturation: 0.6, brightness: 0.9, .. });
    /// ```
    fn add(self, settings: any) -> Effect { return Effect { id: drift::effect_add(settings, -2147483647) }; }
    /// The same, at a place of your choosing in the chain; effects run from the lowest order
    /// up.
    ///
    /// ```rust
    /// effects.add_at(Vignette { intensity: 0.8, .. }, 100);
    /// ```
    fn add_at(self, settings: any, order: int) -> Effect { return Effect { id: drift::effect_add(settings, order) }; }
    /// Adds a `Bloom` with a threshold and an intensity.
    ///
    /// ```rust
    /// let glow = effects.bloom(0.7, 1.2);
    /// ```
    fn bloom(self, threshold: float, intensity: float) -> Effect {
        return self.add(Bloom { threshold: threshold, intensity: intensity, .. });
    }
    /// Adds a `Vignette`: darker edges.
    ///
    /// ```rust
    /// effects.vignette(0.6, 0.75);
    /// ```
    fn vignette(self, intensity: float, radius: float) -> Effect {
        return self.add(Vignette { intensity: intensity, radius: radius, .. });
    }
    /// Adds a `Crt`: a curved screen with scanlines.
    ///
    /// ```rust
    /// effects.crt(0.15, 0.35);
    /// ```
    fn crt(self, curvature: float, scanlines: float) -> Effect {
        return self.add(Crt { curvature: curvature, scanlines: scanlines, .. });
    }
    /// Adds a `Grayscale`: color to gray, 0 to 1.
    ///
    /// ```rust
    /// let dead = effects.grayscale(1.0);
    /// ```
    fn grayscale(self, amount: float) -> Effect { return self.add(Grayscale { amount: amount }); }
    /// Adds a `Sepia`: color to brown, 0 to 1.
    ///
    /// ```rust
    /// effects.sepia(0.8);
    /// ```
    fn sepia(self, amount: float) -> Effect { return self.add(Sepia { amount: amount }); }
    /// Adds a `Pixelate`: blocks of `size` pixels.
    ///
    /// ```rust
    /// effects.pixelate(4.0);
    /// ```
    fn pixelate(self, size: float) -> Effect { return self.add(Pixelate { size: size }); }
    /// Adds a `Blur`, for behind a pause menu.
    ///
    /// ```rust
    /// let soft = effects.blur(2.0, 2);
    /// ```
    fn blur(self, radius: float, iterations: int) -> Effect { return self.add(Blur { radius: radius, iterations: iterations }); }
    /// Moves the screen `amount` of the way to `c` over `seconds` and holds it there; amount 0
    /// fades back.
    ///
    /// ```rust
    /// effects.fade_to(rgb(0, 0, 0), 1.0, 0.5);   // to black over half a second
    /// effects.fade_to(rgb(0, 0, 0), 0.0, 0.5);   // and back
    /// ```
    fn fade_to(self, c: Color, amount: float, seconds: float) { drift::fade_to(c.r, c.g, c.b, c.a, amount, seconds); }
    /// Light everywhere before any light adds to it, when lighting is on.
    ///
    /// ```rust
    /// effects.set_ambient(rgb(40, 40, 70));   // night
    /// ```
    fn set_ambient(self, c: Color) { drift::lighting("ambient", color_list(c)); }
    /// Switches lighting on and off while the game runs.
    ///
    /// ```rust
    /// effects.set_lighting(false);
    /// ```
    fn set_lighting(self, on: bool) { drift::lighting("enabled", [flag(on)]); }
    /// Multiplies time for every tween; 0 freezes them.
    ///
    /// ```rust
    /// effects.set_tween_speed(0.0);   // freeze every tween
    /// ```
    fn set_tween_speed(self, s: float) { drift::tween_speed(s); }
}

// ---- Lights ----

//! page: components

/// Lights add to the ambient light of `[lighting]` in `drift.toml`; without that section
/// nothing is lit or darkened. See [Particles and Effects](../guides/effects.md#lights).
///
/// ```rust
/// cmd.spawn([at(400.0, 300.0), PointLight { color: rgb(255, 180, 90), intensity: 1.5, radius: 300.0, .. }]);
/// ```
struct PointLight {
    /// Light color
    color: Color = Color { .. },
    /// Brightness
    intensity: float = 1.0,
    /// How far it reaches, in pixels
    radius: float = 200.0,
    /// 1 fades evenly to the edge; more keeps a tighter core
    falloff: float = 2.0,
    /// Casts shadows from `LightOccluder` entities
    shadows: bool = true,
    /// The layers it lights
    layer_mask: int = ALL_LAYERS,
}

/// A cone of light. `direction` adds to the entity's rotation.
///
/// ```rust
/// cmd.spawn([at(100.0, 100.0), SpotLight { radius: 450.0, direction: 0.8, angle: 0.6, softness: 0.3, .. }]);
/// ```
struct SpotLight {
    /// Light color
    color: Color = Color { .. },
    /// Brightness
    intensity: float = 1.0,
    /// How far it reaches, in pixels
    radius: float = 300.0,
    /// 1 fades evenly to the edge; more keeps a tighter core
    falloff: float = 2.0,
    /// Radians from +x, added to the entity's rotation
    direction: float = 0.0,
    /// The whole cone, in radians
    angle: float = 0.8,
    /// 0 is a hard edge; 1 fades from the middle
    softness: float = 0.2,
    /// Casts shadows from `LightOccluder` entities
    shadows: bool = true,
    /// The layers it lights
    layer_mask: int = ALL_LAYERS,
}

//! page: enums

/// The shape of a [`LightOccluder`](components.md#lightoccluder).
///
/// ```rust
/// LightOccluder { shape: OccluderShape::FromCollider, .. }
/// ```
enum OccluderShape {
    /// A box of `half_size`
    Box,
    /// A circle of `radius`
    Circle,
    /// The corners in `points`
    Polygon,
    /// The entity's collider
    FromCollider,
}

//! page: components

/// Blocks light and casts a shadow from lights with `shadows`. The shape is in the entity's
/// space and turns and scales with it.
///
/// ```rust
/// cmd.spawn([at(300.0, 200.0), Rectangle { size: vec2(64.0, 64.0), .. }, BoxCollider { half_size: vec2(32.0, 32.0), .. },
///            LightOccluder { shape: OccluderShape::FromCollider, .. }]);
/// ```
struct LightOccluder {
    /// The occluder's shape; `FromCollider` takes the entity's collider
    shape: OccluderShape = OccluderShape::Box,
    /// Half size of a `Box`
    half_size: Vec2 = Vec2 { x: 16.0, y: 16.0 },
    /// Radius of a `Circle`
    radius: float = 16.0,
    /// Corners of a `Polygon`, up to 16
    points: Vec2[] = [],
    /// Moves the shape from the entity's position
    offset: Vec2 = Vec2 { .. },
    /// `false` keeps the occluder's own area lit
    shadow_self: bool = false,
    /// The lights' layers it blocks
    layer_mask: int = ALL_LAYERS,
}

// ---- Trails ----

/// A fading ribbon behind a moving entity.
///
/// ```rust
/// cmd.spawn([at(x, y), Circle { radius: 3.0, .. }, Velocity { linear: vec2(300.0, 0.0), .. },
///            Trail { width: 4.0, lifetime: 0.3, color_start: rgb(120, 200, 255), .. }]);
/// ```
struct Trail {
    /// Width in pixels
    width: float = 4.0,
    /// Seconds a point of the ribbon lasts
    lifetime: float = 0.5,
    /// Color at the entity
    color_start: Color = Color { .. },
    /// Color at the tail
    color_end: Color = Color { r: 1.0, g: 1.0, b: 1.0, a: 0.0 },
    /// The entity moves this far before the trail adds a point
    min_distance: float = 2.0,
    /// The most points the ribbon keeps
    max_points: int = 64,
    /// Draw order
    z: float = -1.0,
}
