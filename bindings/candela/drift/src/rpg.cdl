//! drift/rpg: inventories, stats, story flags, quests and dialogue.
//!
//! `import "drift/rpg" { * };` adds plain values the game keeps in its
//! components and resources and saves with Save.set_value: Inventory,
//! Stats with Modifiers, Flags, Quests, and Dialogue played from a
//! DialogueScript data file against Flags.

//! page: rpg
//! # Inventory, Stats, Quests and Dialogue: drift/rpg
//!
//! Inventories, stats with modifiers, story flags, quests, and dialogue played from a script,
//! as plain values the game keeps and saves.
//!
//! ```rust
//! import "drift" { * };
//! import "drift/rpg" { * };
//! ```
//!
//! See [Inventory, Stats, Quests and Dialogue](../guides/game-systems.md).

import "drift" { * };

// ---- Inventory ----

/// One slot of an `Inventory`: an item id and how many of it the slot holds.
struct ItemStack {
    /// The item's id, a name of your own such as "potion".
    item: string = "",
    /// How many the slot holds, from 1 to the inventory's `stack_size`.
    count: int = 0,
}

/// Items by id, in slots of up to `stack_size` each.
///
/// Keep it in a component or resource, and store it with `save.set_value` to keep it between
/// runs.
///
/// ```rust
/// let bag = inventory(12, 10);
/// let left = bag.add("arrow", 25);   // 0: three slots of 10, 10 and 5
/// ```
struct Inventory {
    /// The slots in use, in the order they were filled. A slot that empties is removed.
    slots: ItemStack[] = [],
    /// The most slots it holds.
    capacity: int = 20,
    /// The most of one item a slot holds.
    stack_size: int = 99,
}

/// An empty inventory of `capacity` slots holding up to `stack_size` each.
fn inventory(capacity: int, stack_size: int) -> Inventory {
    return Inventory { capacity: capacity, stack_size: stack_size, .. };
}
impl Inventory {
    /// Adds what fits; returns how many did not. It tops up slots that already hold the item,
    /// then fills new slots while there is room.
    fn add(self, item: string, count: int) -> int {
        let left = count;
        for i in range(self.slots.len()) {
            if left > 0 && self.slots[i].item == item && self.slots[i].count < self.stack_size {
                let put = min(float(left), float(self.stack_size - self.slots[i].count));
                self.slots[i].count += int(put);
                left -= int(put);
            }
        }
        while left > 0 && self.slots.len() < self.capacity {
            let put = int(min(float(left), float(self.stack_size)));
            self.slots.push(ItemStack { item: item, count: put });
            left -= put;
        }
        return left;
    }
    /// Takes `count` of the item, or nothing when there are fewer; returns whether it took them.
    /// It takes from the last slots first.
    fn remove(self, item: string, count: int) -> bool {
        if self.count(item) < count {
            return false;
        }
        let left = count;
        let i = self.slots.len() - 1;
        while i >= 0 && left > 0 {
            if self.slots[i].item == item {
                let take = int(min(float(left), float(self.slots[i].count)));
                self.slots[i].count -= take;
                left -= take;
                if self.slots[i].count == 0 {
                    self.slots.remove(i);
                }
            }
            i -= 1;
        }
        return true;
    }
    /// How many of the item it holds, over every slot.
    fn count(self, item: string) -> int {
        let n = 0;
        for s in self.slots {
            if s.item == item {
                n += s.count;
            }
        }
        return n;
    }
    /// Whether it holds at least `count` of the item.
    fn has(self, item: string, count: int) -> bool { return self.count(item) >= count; }
    /// Whether every slot is in use. A full inventory can still take more of an item whose
    /// slots have room.
    fn is_full(self) -> bool { return self.slots.len() >= self.capacity; }
    /// Each item id once, in slot order.
    fn items(self) -> string[] {
        let out: string[] = [];
        for s in self.slots {
            if !out.contains(s.item) {
                out.push(s.item);
            }
        }
        return out;
    }
}

// ---- Stats and modifiers ----

/// How a `Modifier` changes a stat. A stat reads (base + every Add + base * every Percent),
/// times every Multiply.
///
/// ```rust
/// stats.add(modifier("speed", ModKind::Percent, 0.2, "boots"));   // +20% of base speed
/// ```
enum ModKind {
    /// Adds `amount` to the stat.
    Add,
    /// Adds `amount` times the base value: 0.1 is +10% of the base. Percents on one stat sum.
    Percent,
    /// Multiplies the stat by `amount`, after the adds and percents.
    Multiply,
}

/// A change to one stat. `source` names what gave it (an item, a buff) so it can be taken off
/// again; `seconds` above zero makes it wear off.
struct Modifier {
    /// The name of the stat it changes.
    stat: string = "",
    /// How it changes the stat.
    kind: ModKind = ModKind::Add,
    /// How much: a number to add, a fraction of the base, or a factor, by `kind`.
    amount: float = 0.0,
    /// What gave it, such as an item or buff name; `Stats.remove_source` takes it off by this.
    source: string = "",
    /// Seconds until it wears off, counted down by `Stats.tick`; zero or below lasts until
    /// removed.
    seconds: float = -1.0,
}

/// A modifier that lasts until removed. Set `seconds` on the result to make it wear off.
///
/// ```rust
/// let haste = modifier("speed", ModKind::Multiply, 1.5, "potion");
/// haste.seconds = 10.0;
/// stats.add(haste);
/// ```
fn modifier(stat: string, kind: ModKind, amount: float, source: string) -> Modifier {
    return Modifier { stat: stat, kind: kind, amount: amount, source: source, seconds: -1.0 };
}

/// Base values by name, and the modifiers on them.
///
/// ```rust
/// let s = stats();
/// s.set_base("attack", 10.0);
/// s.add(modifier("attack", ModKind::Add, 5.0, "sword"));
/// let attack = s.get("attack");   // 15.0
/// ```
struct Stats {
    /// The base value of each stat, by name.
    base: {string: float} = {},
    /// Every modifier on it, in the order they were added.
    mods: Modifier[] = [],
}

/// Stats with no base values and no modifiers.
fn stats() -> Stats {
    let base: {string: float} = {};
    let mods: Modifier[] = [];
    return Stats { base: base, mods: mods };
}
impl Stats {
    /// Sets a stat's base value.
    fn set_base(self, stat: string, value: float) { self.base[stat] = value; }
    /// A stat's base value without modifiers; 0.0 for a stat with none set.
    fn base_of(self, stat: string) -> float {
        if self.base.contains(stat) {
            return self.base[stat];
        }
        return 0.0;
    }
    /// Puts a modifier on.
    fn add(self, m: Modifier) { self.mods.push(m); }
    /// Takes off every modifier from `source`.
    fn remove_source(self, source: string) {
        let kept: Modifier[] = [];
        for m in self.mods {
            if m.source != source {
                kept.push(m);
            }
        }
        self.mods = kept;
    }
    /// The stat with every modifier applied: (base + adds + base * percents) * multiplies.
    fn get(self, stat: string) -> float {
        let b = self.base_of(stat);
        let add = 0.0;
        let percent = 0.0;
        let mult = 1.0;
        for m in self.mods {
            if m.stat == stat {
                match m.kind {
                    ModKind::Add => { add += m.amount; }
                    ModKind::Percent => { percent += m.amount; }
                    ModKind::Multiply => { mult *= m.amount; }
                }
            }
        }
        return (b + add + b * percent) * mult;
    }
    /// Wears timed modifiers down by `dt` seconds; drops the ones that ran out. Call it once a
    /// frame with `time.dt`.
    fn tick(self, dt: float) {
        let kept: Modifier[] = [];
        for m in self.mods {
            if m.seconds > 0.0 {
                m.seconds -= dt;
                if m.seconds <= 0.0 {
                    continue;
                }
            }
            kept.push(m);
        }
        self.mods = kept;
    }
}

// ---- Flags and quests ----

/// Named whole numbers for story state: switches (0 or 1), counters, choices. Missing names
/// read 0. Store it with save.set_value to keep it.
///
/// ```rust
/// let story = flags();
/// story.set("met_ana", 1);
/// story.add("wolves", 1);
/// if story.check("wolves >= 3") { log("enough wolves"); }
/// ```
struct Flags {
    /// The value of each name that was set.
    values: {string: int} = {},
}

/// Flags with no names set.
fn flags() -> Flags {
    let values: {string: int} = {};
    return Flags { values: values };
}
impl Flags {
    /// A flag's value; 0 for a name never set.
    fn get(self, name: string) -> int {
        if self.values.contains(name) {
            return self.values[name];
        }
        return 0;
    }
    /// Sets a flag's value.
    fn set(self, name: string, value: int) { self.values[name] = value; }
    /// Whether a flag is anything but 0.
    fn on(self, name: string) -> bool { return self.get(name) != 0; }
    /// Adds to a counter; returns the new value.
    fn add(self, name: string, by: int) -> int {
        let v = self.get(name) + by;
        self.values[name] = v;
        return v;
    }
    /// Whether a condition holds: "key", "!key", or "key OP number" with OP one of == != < <= > >=.
    /// An empty condition holds. A number that does not parse reads as 0.
    fn check(self, condition: string) -> bool {
        let c = condition.trim();
        if c == "" {
            return true;
        }
        if c.starts_with("!") {
            return !self.on(c[1..c.len()].trim());
        }
        for op in ["==", "!=", "<=", ">=", "<", ">"] {
            let i = match c.index_of(op) { Some(k) => k, None => -1 };
            if i >= 0 {
                let v = self.get(c[0..i].trim());
                let n = match c[i + op.len()..c.len()].trim().parse<int>() { Some(k) => k, None => 0 };
                if op == "==" {
                    return v == n;
                }
                if op == "!=" {
                    return v != n;
                }
                if op == "<=" {
                    return v <= n;
                }
                if op == ">=" {
                    return v >= n;
                }
                if op == "<" {
                    return v < n;
                }
                return v > n;
            }
        }
        return self.on(c);
    }
    /// Applies an effect: "key" (sets 1), "key = 3", "key += 2", "key -= 1". An empty effect
    /// does nothing.
    fn apply(self, effect: string) {
        let e = effect.trim();
        if e == "" {
            return;
        }
        for op in ["+=", "-=", "="] {
            let i = match e.index_of(op) { Some(k) => k, None => -1 };
            if i >= 0 {
                let name = e[0..i].trim();
                let n = match e[i + op.len()..e.len()].trim().parse<int>() { Some(k) => k, None => 0 };
                if op == "+=" {
                    self.add(name, n);
                } else if op == "-=" {
                    self.add(name, -n);
                } else {
                    self.set(name, n);
                }
                return;
            }
        }
        self.set(e, 1);
    }
}

/// Where a quest stands. A quest goes from Inactive to Active with `Quests.start`, then to Done
/// or Failed; only an Active quest counts progress.
enum QuestState {
    /// Not started; every quest id starts here.
    Inactive,
    /// Started and not finished; its objectives count progress.
    Active,
    /// Completed.
    Done,
    /// Failed.
    Failed,
}

/// Quests by id: their state and objective counters. Store it with save.set_value to keep it.
///
/// ```rust
/// journal.start("hunt");
/// if journal.progress("hunt", "wolves", 1) >= 3 {
///     journal.complete("hunt");
/// }
/// ```
struct Quests {
    /// The state of each quest that left Inactive, by quest id.
    states: {string: QuestState} = {},
    /// Objective counts, keyed "quest/objective".
    counters: {string: int} = {},
}

/// Quests with every quest Inactive.
fn quests() -> Quests {
    let states: {string: QuestState} = {};
    let counters: {string: int} = {};
    return Quests { states: states, counters: counters };
}
impl Quests {
    /// A quest's state; Inactive for one never started.
    fn state(self, quest: string) -> QuestState {
        if self.states.contains(quest) {
            return self.states[quest];
        }
        return QuestState::Inactive;
    }
    /// Makes an Inactive quest Active. A quest that is Active, Done or Failed stays as it is.
    fn start(self, quest: string) {
        if self.state(quest) == QuestState::Inactive {
            self.states[quest] = QuestState::Active;
        }
    }
    /// Marks a quest Done, whatever its state.
    fn complete(self, quest: string) { self.states[quest] = QuestState::Done; }
    /// Marks a quest Failed, whatever its state.
    fn fail(self, quest: string) { self.states[quest] = QuestState::Failed; }
    /// Whether a quest is Active.
    fn is_active(self, quest: string) -> bool { return self.state(quest) == QuestState::Active; }
    /// Whether a quest is Done.
    fn is_done(self, quest: string) -> bool { return self.state(quest) == QuestState::Done; }
    /// Counts toward an objective of an active quest ("wolves" of "hunt"); returns the count. A
    /// quest that is not Active keeps its count.
    fn progress(self, quest: string, objective: string, by: int) -> int {
        let key = quest + "/" + objective;
        if !self.is_active(quest) {
            return self.count(quest, objective);
        }
        let v = self.count(quest, objective) + by;
        self.counters[key] = v;
        return v;
    }
    /// An objective's count; 0 before any progress.
    fn count(self, quest: string, objective: string) -> int {
        let key = quest + "/" + objective;
        if self.counters.contains(key) {
            return self.counters[key];
        }
        return 0;
    }
    /// The ids of every quest in a state. A quest never started has no entry, so it is not
    /// listed as Inactive.
    fn with_state(self, s: QuestState) -> string[] {
        let out: string[] = [];
        for k in self.states.keys() {
            if self.states[k] == s {
                out.push(k);
            }
        }
        return out;
    }
}

// ---- Dialogue ----

/// One line of dialogue: who says it and what they say.
struct DialogueLine {
    /// The speaker's name; may be empty.
    who: string = "",
    /// The text, with {name} parts that `Dialogue.text` fills in.
    text: string = "",
}

/// One choice the player can pick at a dialogue node.
///
/// `when` is a Flags condition that must hold for the choice to show; `set` are Flags effects
/// applied when it is picked; `next` is the node it leads to ("" ends the dialogue).
struct DialogueChoice {
    /// What the choice says; {name} parts are filled in.
    text: string = "",
    /// The node it leads to; "" ends the dialogue.
    next: string = "",
    /// A Flags condition that must hold for the choice to show; "" always shows.
    when: string = "",
    /// Flags effects applied when it is picked.
    set: string[] = [],
}

/// Lines said in order, then the choices, or straight on to `next`. `set` effects apply on
/// entering the node.
struct DialogueNode {
    /// The lines, said in order.
    lines: DialogueLine[] = [],
    /// The choices offered on the last line.
    choices: DialogueChoice[] = [],
    /// The node after the last line when there are no choices; "" ends the dialogue.
    next: string = "",
    /// Flags effects applied on entering the node.
    set: string[] = [],
}

/// A whole conversation, usually from a data file:
/// load_data<DialogueScript>("assets/talk/ana.json").
struct DialogueScript {
    /// The node `Dialogue.start("")` begins at.
    start: string = "",
    /// Every node, by name.
    nodes: {string: DialogueNode} = {},
}

/// A conversation being played. Variables live in `vars`; {name} in a line shows vars or
/// `names` (for text such as the player's name).
///
/// ```rust
/// let talk = dialogue(load_data<DialogueScript>("assets/talk/ana.json"), story);
/// talk.names["player"] = "Sam";
/// talk.start("");
/// log(talk.speaker() + ": " + talk.text());
/// ```
struct Dialogue {
    /// The conversation it plays.
    script: DialogueScript,
    /// The node it is on; "" when the dialogue is over or not started.
    node: string = "",
    /// The index of the current line in the node.
    line: int = 0,
    /// The flags its conditions read and its effects change.
    vars: Flags,
    /// Text for {name} parts that are not flags, such as the player's name.
    names: {string: string} = {},
}

/// A dialogue over `script` that reads and changes `vars`; it starts with `start`.
fn dialogue(script: DialogueScript, vars: Flags) -> Dialogue {
    let names: {string: string} = {};
    return Dialogue { script: script, node: "", line: 0, vars: vars, names: names };
}
impl Dialogue {
    /// Starts at a node; "" starts at the script's `start`.
    fn start(self, node: string) {
        let n = node;
        if n == "" {
            n = self.script.start;
        }
        self.enter(n);
    }
    /// Goes to a node: applies its `set` effects, and goes straight on to its `next` when it has
    /// no lines and no choices. "" or a name the script does not have ends the dialogue.
    fn enter(self, node: string) {
        self.line = 0;
        if node == "" || !self.script.nodes.contains(node) {
            self.node = "";
            return;
        }
        self.node = node;
        for e in self.script.nodes[node].set {
            self.vars.apply(e);
        }
        // A node with nothing to say goes straight on.
        let n = self.script.nodes[node];
        if n.lines.len() == 0 && n.choices.len() == 0 {
            self.enter(n.next);
        }
    }
    /// Whether the dialogue is playing.
    fn active(self) -> bool { return self.node != ""; }
    /// The current line as written; an empty line when the dialogue is over.
    fn current(self) -> DialogueLine {
        if !self.active() {
            return DialogueLine { .. };
        }
        let lines = self.script.nodes[self.node].lines;
        if self.line >= lines.len() {
            return DialogueLine { .. };
        }
        return lines[self.line];
    }
    /// Who says the current line.
    fn speaker(self) -> string { return self.current().who; }
    /// The line with its {name} parts filled in.
    fn text(self) -> string { return self.substitute(self.current().text); }
    /// `text` with each {name} replaced from `names`, then from the flags in `vars`.
    fn substitute(self, text: string) -> string {
        let out = text;
        for k in self.names.keys() {
            out = out.replace("{" + k + "}", self.names[k]);
        }
        for k in self.vars.values.keys() {
            out = out.replace("{" + k + "}", string(self.vars.values[k]));
        }
        return out;
    }
    /// The choices to show now: on the node's last line, those whose `when` holds. Empty while
    /// lines remain or when the node has none.
    fn choices(self) -> DialogueChoice[] {
        let out: DialogueChoice[] = [];
        if !self.active() {
            return out;
        }
        let n = self.script.nodes[self.node];
        if self.line < n.lines.len() - 1 {
            return out;
        }
        for c in n.choices {
            if self.vars.check(c.when) {
                out.push(DialogueChoice { text: self.substitute(c.text), next: c.next, when: c.when, set: c.set });
            }
        }
        return out;
    }
    /// On to the next line, or the next node when the lines are done and there is nothing to
    /// choose.
    fn advance(self) {
        if !self.active() || self.choices().len() > 0 {
            return;
        }
        let n = self.script.nodes[self.node];
        if self.line + 1 < n.lines.len() {
            self.line += 1;
            return;
        }
        self.enter(n.next);
    }
    /// Picks choice i of choices().
    fn choose(self, i: int) {
        let cs = self.choices();
        if i < 0 || i >= cs.len() {
            return;
        }
        for e in cs[i].set {
            self.vars.apply(e);
        }
        self.enter(cs[i].next);
    }
}
