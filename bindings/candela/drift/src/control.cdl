//! drift/control: movement controllers for the player's entity.
//!
//! `import "drift/control" { * };` adds three controllers: top-down 8-way
//! movement, a platformer with coyote time, jump buffering and variable jump
//! height, and an asteroids-style ship. Each reads the arrow keys, WASD and
//! the first gamepad's left stick by default, plus the input actions it
//! names, and drives the entity's Velocity.

//! page: control
//! # Controllers: drift/control
//!
//! Movement controllers for the player's entity: top-down 8-way movement, a platformer with
//! coyote time, jump buffering and variable jump height, and an asteroids-style ship. Each
//! reads the arrow keys, WASD and the first gamepad's left stick by default, plus the input
//! actions it names, and drives the entity's `Velocity`.
//!
//! ```rust
//! import "drift" { * };
//! import "drift/control" { * };
//! ```
//!
//! See [Building Blocks](../guides/building-blocks.md).

import "drift" { * };

/// A direction from -1 to 1 on each axis: the 2D action `action` when it is set, plus, with
/// `defaults`, the arrow keys, WASD, the first gamepad's d-pad and its left stick.
///
/// Up is -1 on y. The stick counts once it is pushed past 0.2. Each axis is clamped to -1..1,
/// so a diagonal from the keys is (1, 1), longer than 1.
///
/// ```rust
/// let dir = control_axis(input, "", true);
/// ```
fn control_axis(input: Input, action: string, defaults: bool) -> Vec2 {
    let v = Vec2 { .. };
    if action != "" {
        v = input.axis2d(action);
    }
    if defaults {
        if input.key_down(Key::Left) || input.key_down(Key::A) || input.gamepad_down(0, GamepadButton::DpadLeft) {
            v.x -= 1.0;
        }
        if input.key_down(Key::Right) || input.key_down(Key::D) || input.gamepad_down(0, GamepadButton::DpadRight) {
            v.x += 1.0;
        }
        if input.key_down(Key::Up) || input.key_down(Key::W) || input.gamepad_down(0, GamepadButton::DpadUp) {
            v.y -= 1.0;
        }
        if input.key_down(Key::Down) || input.key_down(Key::S) || input.gamepad_down(0, GamepadButton::DpadDown) {
            v.y += 1.0;
        }
        let stick = Vec2 { x: input.gamepad_axis(0, GamepadAxis::LeftX), y: input.gamepad_axis(0, GamepadAxis::LeftY) };
        if stick.length() > 0.2 {
            v = v + stick;
        }
    }
    return Vec2 { x: clamp(v.x, -1.0, 1.0), y: clamp(v.y, -1.0, 1.0) };
}

/// Moves `from` toward `to` by at most `step`, without passing it.
///
/// ```rust
/// speed = approach(speed, 300.0, 600.0 * time.dt);   // 600 pixels per second per second
/// ```
fn approach(from: float, to: float, step: float) -> float {
    if from < to {
        return min(from + step, to);
    }
    return max(from - step, to);
}

// ---- Top-down ----

/// Walks in eight directions at `speed` pixels per second, reaching it in `speed /
/// acceleration` seconds and stopping in `speed / friction`. Diagonals are as fast as straight
/// lines. `facing` is the last direction moved in.
///
/// It sets the entity's Velocity, which it adds when missing. Use it on a kinematic body or an
/// entity with no body; on a dynamic body gravity and pushes fight it.
///
/// ```rust
/// cmd.spawn([at(320.0, 240.0), Sprite { image: art.hero, .. }, TopDownController { speed: 160.0, .. }]);
/// ```
@component(requires: [Velocity])
struct TopDownController {
    /// Top speed in pixels per second.
    speed: float = 220.0,
    /// How fast it speeds up while a direction is held, in pixels per second per second.
    acceleration: float = 2000.0,
    /// How fast it slows down once nothing is held, in pixels per second per second.
    friction: float = 2400.0,
    /// A 2D input action to read as well, such as "move"; empty reads none.
    action: string = "",
    /// Reads the arrow keys, WASD, the d-pad and the left stick; off reads only `action`.
    default_keys: bool = true,
    /// Off stops the controller; the Velocity keeps whatever it was.
    enabled: bool = true,
    /// The last direction moved in, length 1; starts facing down.
    facing: Vec2 = Vec2 { x: 0.0, y: 1.0 },
}

/// Moves every enabled TopDownController.
@system
fn ctl_top_down(top_down_controller: (TopDownController, Velocity), input: Input, time: Time) {
    let (c, v) = top_down_controller;
    if !c.enabled {
        return;
    }
    let dir = control_axis(input, c.action, c.default_keys);
    if dir.length() > 1.0 {
        dir = dir.normalized();
    }
    let want = dir * c.speed;
    let dt = time.dt;
    let rate = c.acceleration;
    if dir.length() < 0.01 {
        rate = c.friction;
    } else {
        c.facing = dir.normalized();
    }
    let lin = Vec2 { x: approach(v.linear.x, want.x, rate * dt), y: approach(v.linear.y, want.y, rate * dt) };
    if lin.x != v.linear.x || lin.y != v.linear.y {
        v.linear = lin;
    }
}

// ---- Platformer ----

/// Runs and jumps on a dynamic body with fixed rotation, under the physics world's gravity.
///
/// Ground is found with three short rays below `foot` (the distance from the entity's position
/// to its feet), `width` apart; a surface counts as ground when it faces up. Jump is Space, Up
/// or W, or the first gamepad's South button, plus `jump_action`.
///
/// - Coyote time: a jump still works `coyote_time` seconds after running off a ledge.
/// - Jump buffering: a jump pressed `jump_buffer` seconds before landing happens on landing.
/// - Variable height: letting go of jump while rising cuts the speed by `jump_cut`, so a tap is
///   a hop and a hold is a full jump.
/// - `air_jumps` extra jumps in the air: 1 is a double jump.
///
/// ```rust
/// cmd.spawn([at(100.0, 300.0), Rectangle { size: vec2(24.0, 32.0), .. },
///            RigidBody { fixed_rotation: true, .. }, BoxCollider { half_size: vec2(12.0, 16.0), .. },
///            PlatformerController { air_jumps: 1, .. }]);
/// ```
@component(requires: [Velocity])
struct PlatformerController {
    /// Top running speed in pixels per second.
    speed: float = 240.0,
    /// How fast it speeds up on the ground, in pixels per second per second.
    acceleration: float = 2400.0,
    /// How fast it changes speed in the air, in pixels per second per second.
    air_acceleration: float = 1400.0,
    /// How fast it stops on the ground once nothing is held, in pixels per second per second.
    friction: float = 2800.0,
    /// Upward speed a jump starts with, in pixels per second.
    jump_speed: float = 520.0,
    /// What the upward speed is multiplied by when jump is let go while rising, 0 to 1.
    jump_cut: float = 0.45,
    /// Seconds after leaving the ground during which a jump still works.
    coyote_time: float = 0.1,
    /// Seconds a jump press is remembered before landing.
    jump_buffer: float = 0.12,
    /// Extra jumps in the air before landing again; 1 is a double jump.
    air_jumps: int = 0,
    /// The fastest it falls, in pixels per second.
    max_fall: float = 900.0,
    /// Distance from the entity's position down to its feet, in pixels.
    foot: float = 16.0,
    /// Distance between the outer ground rays, in pixels; about the collider's width.
    width: float = 24.0,
    /// An input action that jumps as well; empty reads none.
    jump_action: string = "",
    /// A 2D input action whose x runs as well; empty reads none.
    move_action: string = "",
    /// Reads the arrow keys, WASD, the d-pad, the left stick and the jump keys; off reads only
    /// the actions.
    default_keys: bool = true,
    /// Off stops the controller; the Velocity keeps whatever it was.
    enabled: bool = true,
    /// Whether it stood on the ground this frame.
    grounded: bool = false,
    /// Seconds since it last stood on the ground.
    since_ground: float = 1.0,
    /// Seconds since jump was last pressed.
    since_jump_press: float = 1.0,
    /// Air jumps left before landing.
    jumps_left: int = 0,
    /// Set from a jump until it lands or jump is let go while rising.
    jumping: bool = false,
    /// The way it last ran: 1.0 right, -1.0 left.
    facing: float = 1.0,
}

/// Sent when a PlatformerController jumps.
///
/// ```rust
/// @system
/// fn double_jumped(j: Jumped) {
///     if j.air {
///         log("double jump");
///     }
/// }
/// ```
@message
struct Jumped {
    /// The entity that jumped.
    entity: Entity = Entity { .. },
    /// Whether it was an air jump.
    air: bool = false,
}

/// Sent when a PlatformerController lands on the ground.
@message
struct Landed {
    /// The entity that landed.
    entity: Entity = Entity { .. },
}

/// Whether jump was pressed this frame: `c.jump_action`, or with the default keys Space, Up, W
/// or the first gamepad's South button.
fn jump_pressed(input: Input, c: PlatformerController) -> bool {
    if c.jump_action != "" && input.action_pressed(c.jump_action) {
        return true;
    }
    return c.default_keys && (input.key_pressed(Key::Space) || input.key_pressed(Key::Up) || input.key_pressed(Key::W)
                              || input.gamepad_pressed(0, GamepadButton::South));
}

/// Whether jump is held down: `c.jump_action`, or with the default keys Space, Up, W or the
/// first gamepad's South button.
fn jump_held(input: Input, c: PlatformerController) -> bool {
    if c.jump_action != "" && input.action_held(c.jump_action) {
        return true;
    }
    return c.default_keys && (input.key_down(Key::Space) || input.key_down(Key::Up) || input.key_down(Key::W)
                              || input.gamepad_down(0, GamepadButton::South));
}

/// Whether the controller stands on something: one of three rays from just above its feet,
/// 6 pixels down, hits another entity's collider whose surface faces up.
fn on_ground(e: Entity, t: Transform, c: PlatformerController, physics: Physics) -> bool {
    let down = Vec2 { x: 0.0, y: 1.0 };
    for i in range(3) {
        let x = t.position.x + c.width * 0.5 * float(i - 1);
        let hit = physics.raycast(Vec2 { x: x, y: t.position.y + c.foot - 2.0 }, down, 6.0);
        if hit.hit && hit.entity != e && hit.normal.y < -0.5 {
            return true;
        }
    }
    return false;
}

/// Runs, jumps and lands every enabled PlatformerController.
@system
fn ctl_platformer(platformer_controller: (Entity, PlatformerController, Velocity, Transform),
                  input: Input, time: Time, physics: Physics, cmd: Commands) {
    let (e, c, v, t) = platformer_controller;
    if !c.enabled {
        return;
    }
    let dt = time.dt;
    let was = c.grounded;
    c.grounded = on_ground(e, t, c, physics) && v.linear.y >= -1.0;
    if c.grounded {
        c.since_ground = 0.0;
        c.jumps_left = c.air_jumps;
        c.jumping = false;
        if !was {
            cmd.send(Landed { entity: e });
        }
    } else {
        c.since_ground += dt;
    }
    c.since_jump_press += dt;
    if jump_pressed(input, c) {
        c.since_jump_press = 0.0;
    }

    let lin = v.linear;
    let x = control_axis(input, c.move_action, c.default_keys).x;
    if c.move_action != "" && !c.default_keys {
        x = input.axis2d(c.move_action).x;
    }
    if x != 0.0 {
        c.facing = 1.0;
        if x < 0.0 {
            c.facing = -1.0;
        }
    }
    let rate = c.air_acceleration;
    if c.grounded {
        rate = c.acceleration;
        if x == 0.0 {
            rate = c.friction;
        }
    }
    lin.x = approach(lin.x, x * c.speed, rate * dt);

    if c.since_jump_press <= c.jump_buffer {
        let air = false;
        let can = c.grounded || c.since_ground <= c.coyote_time;
        if !can && c.jumps_left > 0 {
            can = true;
            air = true;
            c.jumps_left -= 1;
        }
        if can && (!c.jumping || air) {
            lin.y = -c.jump_speed;
            c.jumping = true;
            c.grounded = false;
            c.since_ground = c.coyote_time + 1.0;
            c.since_jump_press = c.jump_buffer + 1.0;
            cmd.send(Jumped { entity: e, air: air });
        }
    }
    if c.jumping && lin.y < 0.0 && !jump_held(input, c) {
        lin.y *= c.jump_cut;
        c.jumping = false;
    }
    if lin.y > c.max_fall {
        lin.y = c.max_fall;
    }
    if lin.x != v.linear.x || lin.y != v.linear.y {
        v.linear = lin;
    }
}

// ---- Ship ----

/// An asteroids-style ship: Left and Right turn at `turn_speed` radians per second, Up thrusts
/// along the facing direction, and the ship drifts, slowed by `drag` per second, up to
/// `max_speed`.
///
/// The ship faces +X at rotation 0. `thrusting` is true while thrust is held, for a flame
/// sprite. It turns the Transform and sets the Velocity.
///
/// ```rust
/// cmd.spawn([at(320.0, 240.0), Sprite { image: art.ship, .. }, ShipController { .. }, WrapAround { .. }]);
/// ```
@component(requires: [Velocity])
struct ShipController {
    /// Speed gained per second of full thrust, in pixels per second per second.
    thrust: float = 420.0,
    /// Turning speed in radians per second.
    turn_speed: float = 4.0,
    /// The fastest it moves, in pixels per second.
    max_speed: float = 420.0,
    /// Share of the speed lost per second; 0 drifts forever.
    drag: float = 0.6,
    /// Backward thrust while Down is held, in pixels per second per second; 0 gives Down no
    /// effect.
    reverse: float = 0.0,
    /// A 2D input action to read as well: x turns, negative y thrusts; empty reads none.
    action: string = "",
    /// Reads the arrow keys, WASD, the d-pad and the left stick; off reads only `action`.
    default_keys: bool = true,
    /// Off stops the controller; the Velocity keeps whatever it was.
    enabled: bool = true,
    /// Whether thrust is held this frame.
    thrusting: bool = false,
}

/// Turns and thrusts every enabled ShipController.
@system
fn ctl_ship(ship_controller: (ShipController, Velocity, Transform), input: Input, time: Time) {
    let (c, v, t) = ship_controller;
    if !c.enabled {
        return;
    }
    let dt = time.dt;
    let a = control_axis(input, c.action, c.default_keys);
    t.rotation += a.x * c.turn_speed * dt;
    let forward = Vec2 { x: cos(t.rotation), y: sin(t.rotation) };
    let lin = v.linear;
    c.thrusting = a.y < -0.1;
    if c.thrusting {
        lin = lin + forward * (c.thrust * -a.y * dt);
    } else if a.y > 0.1 && c.reverse > 0.0 {
        lin = lin - forward * (c.reverse * a.y * dt);
    }
    lin = lin * max(0.0, 1.0 - c.drag * dt);
    if lin.length() > c.max_speed {
        lin = lin.normalized() * c.max_speed;
    }
    v.linear = lin;
}
