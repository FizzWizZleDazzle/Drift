//! drift/ui: HUD and menu widgets on the screen layer.
//!
//! `import "drift/ui" { * };` adds the components, the messages and the
//! systems that run them. Every widget is an entity on hud_layer(), placed
//! by an Anchor relative to the window, so it stays put when the window
//! changes size and when the camera shakes. Widgets that are more than one
//! shape (bars, buttons, toggles, sliders, icon rows) keep their extra
//! shapes as part entities and move them along.

//! page: ui
//! # HUD and Menus: drift/ui
//!
//! The `drift/ui` module: labels, panels, bars, buttons, toggles, sliders, toasts and dialog
//! boxes on the screen layer. Import it beside `drift`:
//!
//! ```rust
//! import "drift" { * };
//! import "drift/ui" { * };
//! ```
//!
//! See [UI and Score](../guides/ui-and-score.md) for a walk through it.

import "drift" { * };

// ---- Theme ----

/// The look every widget starts from. Set it once in drift.toml [theme] or from a system; a
/// widget copies what it needs when it is made, so change one widget afterwards through its own
/// components.
@settings(section: "theme")
struct Theme {
    /// The font of every label, button and toast; the default is the engine's built-in font.
    font: Font = Font { .. },
    /// Text height in pixels.
    text_size: float = 22.0,
    /// The color of text.
    text_color: Color = Color { r: 0.93, g: 0.94, b: 0.97, a: 1.0 },
    /// Outline thickness around text in pixels; 0 draws none.
    outline: float = 0.0,
    /// The color of the text outline.
    outline_color: Color = Color { r: 0.0, g: 0.0, b: 0.0, a: 1.0 },
    /// How far the text's drop shadow sits from the text, in pixels.
    shadow_offset: Vec2 = Vec2 { x: 0.0, y: 2.0 },
    /// The color of the text's drop shadow; alpha 0 hides it.
    shadow_color: Color = Color { r: 0.0, g: 0.0, b: 0.0, a: 0.55 },
    /// The fill of panels and dialog boxes.
    panel_color: Color = Color { r: 0.08, g: 0.09, b: 0.14, a: 0.86 },
    /// The mark of a toggle that is on and the knob of a slider.
    accent: Color = Color { r: 0.35, g: 0.67, b: 1.0, a: 1.0 },
    /// The fill of a button, toggle or slider at rest.
    button_color: Color = Color { r: 0.18, g: 0.21, b: 0.32, a: 1.0 },
    /// The fill while the mouse is over the widget or it has the focus.
    button_hover: Color = Color { r: 0.26, g: 0.31, b: 0.46, a: 1.0 },
    /// The fill while the left mouse button is held down on the widget.
    button_pressed: Color = Color { r: 0.13, g: 0.15, b: 0.24, a: 1.0 },
    /// The toggle mark and slider knob color while the widget has the keyboard or gamepad focus.
    button_focus: Color = Color { r: 0.35, g: 0.67, b: 1.0, a: 1.0 },
    /// The background of a bar; its alpha is the bar's full opacity.
    bar_back: Color = Color { r: 0.05, g: 0.06, b: 0.09, a: 0.9 },
    /// The fill of a bar whose own `fill_color` is unset.
    bar_fill: Color = Color { r: 0.36, g: 0.85, b: 0.45, a: 1.0 },
    /// The damage trail of a bar whose own `trail_color` is unset.
    bar_trail: Color = Color { r: 0.95, g: 0.85, b: 0.4, a: 1.0 },
    /// Space between a widget's text and its edges, in pixels: x on the left and right, y above
    /// and below.
    padding: Vec2 = Vec2 { x: 16.0, y: 10.0 },
    /// Corner radius of panels and widgets in pixels; bars use half of it.
    corner_radius: float = 6.0,
    /// The narrowest a button, toggle or slider is; slider tracks add half.
    widget_width: float = 220.0,
    /// Kept clear on every side of the window: notches and rounded corners on phones.
    safe_margin: Vec2 = Vec2 { x: 0.0, y: 0.0 },
}

impl Theme {
    /// A copy with another text size, for one widget.
    fn sized(self, size: float) -> Theme {
        let t = self.copy();
        t.text_size = size;
        return t;
    }
    /// A copy with another text color.
    fn colored(self, c: Color) -> Theme {
        let t = self.copy();
        t.text_color = c;
        return t;
    }
    /// A copy with another accent: bar fill and focus color.
    fn accented(self, c: Color) -> Theme {
        let t = self.copy();
        t.accent = c;
        t.bar_fill = c;
        t.button_focus = c;
        return t;
    }
    /// A copy of the theme that shares no fields with it, to change for one widget.
    ///
    /// ```rust
    /// let big = theme.copy();
    /// big.text_size = 40.0;
    /// big.outline = 2.0;
    /// ```
    fn copy(self) -> Theme {
        return Theme {
            font: self.font, text_size: self.text_size, text_color: self.text_color,
            outline: self.outline, outline_color: self.outline_color,
            shadow_offset: self.shadow_offset, shadow_color: self.shadow_color,
            panel_color: self.panel_color, accent: self.accent,
            button_color: self.button_color, button_hover: self.button_hover,
            button_pressed: self.button_pressed, button_focus: self.button_focus,
            bar_back: self.bar_back, bar_fill: self.bar_fill, bar_trail: self.bar_trail,
            padding: self.padding, corner_radius: self.corner_radius, widget_width: self.widget_width,
            safe_margin: self.safe_margin,
        };
    }
    /// Text in this theme. `pivot` picks the alignment, as in Anchor.
    fn text(self, value: string, pivot: Vec2) -> Text {
        return Text {
            value: value, size: self.text_size, color: self.text_color,
            align: align_of(pivot.x), valign: valign_of(pivot.y),
            outline: self.outline, outline_color: self.outline_color,
            shadow_offset: self.shadow_offset, shadow_color: self.shadow_color,
            font: self.font, z: 2.0, layer: hud_layer(), ..
        };
    }
}

// ---- Anchors and layout ----

/// The top-left corner of the window, for Anchor.to. Window points run from (0, 0) at the
/// top-left to (1, 1) at the bottom-right.
const TOP_LEFT: Vec2 = Vec2 { x: 0.0, y: 0.0 };
/// The middle of the window's top edge, for Anchor.to.
const TOP: Vec2 = Vec2 { x: 0.5, y: 0.0 };
/// The top-right corner of the window, for Anchor.to.
const TOP_RIGHT: Vec2 = Vec2 { x: 1.0, y: 0.0 };
/// The middle of the window's left edge, for Anchor.to.
const LEFT: Vec2 = Vec2 { x: 0.0, y: 0.5 };
/// The middle of the window, for Anchor.to.
const CENTER: Vec2 = Vec2 { x: 0.5, y: 0.5 };
/// The middle of the window's right edge, for Anchor.to.
const RIGHT: Vec2 = Vec2 { x: 1.0, y: 0.5 };
/// The bottom-left corner of the window, for Anchor.to.
const BOTTOM_LEFT: Vec2 = Vec2 { x: 0.0, y: 1.0 };
/// The middle of the window's bottom edge, for Anchor.to.
const BOTTOM: Vec2 = Vec2 { x: 0.5, y: 1.0 };
/// The bottom-right corner of the window, for Anchor.to.
const BOTTOM_RIGHT: Vec2 = Vec2 { x: 1.0, y: 1.0 };

/// Keeps the entity at a point of the window plus `offset` pixels, inside the theme's safe
/// margin. Widgets made here also take `to` as their pivot, so a TOP_RIGHT widget hangs from
/// the top-right corner.
@component
struct Anchor {
    /// The point of the window, from (0, 0) at the top-left to (1, 1) at the bottom-right;
    /// TOP_LEFT and the other constants name the usual ones.
    to: Vec2 = Vec2 { .. },
    /// Pixels added to that point; positive x goes right, positive y goes down.
    offset: Vec2 = Vec2 { .. },
}

/// An Anchor at the window point `to`, moved `x` and `y` pixels from it.
///
/// ```rust
/// cmd.spawn(label(theme, "Score 0", anchor(TOP_RIGHT, -16.0, 16.0)));
/// ```
fn anchor(to: Vec2, x: float, y: float) -> Anchor { return Anchor { to: to, offset: Vec2 { x: x, y: y } }; }

/// Internal: a helper the module needs; games do not call it.
fn anchor_point(a: Anchor, win: Window, theme: Theme) -> Vec2 {
    let m = theme.safe_margin;
    return Vec2 {
        x: m.x + (win.width - m.x * 2.0) * a.to.x + a.offset.x,
        y: m.y + (win.height - m.y * 2.0) * a.to.y + a.offset.y,
    };
}

/// Moves every anchored entity to its window point each frame, so widgets follow the window's
/// size.
@system
fn ui_anchor(anchor: (Anchor, Transform), win: Window, theme: Theme) {
    let (a, t) = anchor;
    let p = anchor_point(a, win, theme);
    if p.x != t.position.x || p.y != t.position.y {
        t.position = p;
    }
}

/// Offsets for `count` widgets in a row, `gap` pixels apart, going right from `start`.
fn row(start: Vec2, gap: float, count: int) -> Vec2[] {
    let out: Vec2[] = [];
    for i in range(count) {
        out.push(Vec2 { x: start.x + gap * float(i), y: start.y });
    }
    return out;
}

/// Offsets for `count` widgets in a column, `gap` pixels apart, going down from `start`.
fn column(start: Vec2, gap: float, count: int) -> Vec2[] {
    let out: Vec2[] = [];
    for i in range(count) {
        out.push(Vec2 { x: start.x, y: start.y + gap * float(i) });
    }
    return out;
}

/// Offsets for `count` widgets in rows of `columns`, `cell` apart.
fn grid_layout(start: Vec2, cell: Vec2, columns: int, count: int) -> Vec2[] {
    let out: Vec2[] = [];
    for i in range(count) {
        out.push(Vec2 { x: start.x + cell.x * float(i % columns), y: start.y + cell.y * float(i / columns) });
    }
    return out;
}

/// Internal: a helper the module needs; games do not call it.
fn align_of(x: float) -> Align {
    if x < 0.25 {
        return Align::Left;
    }
    if x > 0.75 {
        return Align::Right;
    }
    return Align::Center;
}

/// Internal: a helper the module needs; games do not call it.
fn valign_of(y: float) -> VAlign {
    if y < 0.25 {
        return VAlign::Top;
    }
    if y > 0.75 {
        return VAlign::Bottom;
    }
    return VAlign::Middle;
}

// ---- Labels ----

/// Text on the HUD.
fn label(theme: Theme, value: string, at: Anchor) -> any[] {
    return [Transform { .. }, theme.text(value, at.to), at];
}

/// A rounded panel behind other widgets, `size` pixels.
fn panel(theme: Theme, at: Anchor, size: Vec2) -> any[] {
    return [
        Transform { .. },
        Rectangle { size: size, color: theme.panel_color, corner_radius: theme.corner_radius,
                    anchor: at.to, z: 0.0, layer: hud_layer(), .. },
        at,
    ];
}

/// Fills a Text from a field of a resource: `source` names it, made with
/// resource_field<Game>("score"), and `format` is the text with {} where the value goes.
/// `count_speed` above 0 counts a number up or down to its new value at that many units per
/// second, with at least a quarter second per change, instead of jumping. `decimals` is how
/// many digits a number shows after the point.
@component
struct Bind {
    /// The resource field to show, made with resource_field<T>(path).
    source: ResourceField = ResourceField { .. },
    /// The text, with {} where the value goes.
    format: string = "{}",
    /// Digits a number shows after the point.
    decimals: int = 0,
    /// Units per second a number counts toward a new value; 0 jumps to it.
    count_speed: float = 0.0,
    /// The number on screen while it counts; Bind keeps it.
    shown: float = 0.0,
    /// Whether the first value has shown; Bind keeps it, so the first value does not count up
    /// from 0.
    started: bool = false,
}

/// A Bind showing the field `path` of the resource T: bind_text<Game>("score", "Score {}"). A
/// type that is not a resource, or a field it does not have, raises drift_not_a_resource or
/// drift_no_such_field.
fn bind_text<T>(path: string, format: string) -> Bind { return Bind { source: resource_field<T>(path), format: format, .. }; }

/// A Bind like `bind_text` that counts toward each new number at `units_per_second` or faster
/// instead of jumping to it.
fn bind_counter<T>(path: string, format: string, units_per_second: float) -> Bind {
    return Bind { source: resource_field<T>(path), format: format, count_speed: units_per_second, .. };
}

/// Writes each Bind's resource field into its Text every frame, counting numbers when
/// `count_speed` is above 0.
@system
fn ui_bind(bind: (Bind, Text), time: Time) {
    let (b, text) = bind;
    let raw = b.source.text();
    let shown = raw;
    if raw.parse<float>() is Some(v) {
        let target = v;
        if b.count_speed > 0.0 && b.started {
            let step = max(b.count_speed, (target - b.shown).abs() * 4.0) * time.real_dt;
            if (target - b.shown).abs() <= step {
                b.shown = target;
            } else if target > b.shown {
                b.shown += step;
            } else {
                b.shown -= step;
            }
        } else {
            b.shown = target;
        }
        b.started = true;
        shown = fixed(b.shown, b.decimals);
    }
    let value = b.format.replace("{}", shown);
    if value != text.value {
        text.value = value;
    }
}

/// A Text that shows a resource field holding seconds as a clock, "m:ss", or "m:ss.d" with
/// `tenths`: ClockBind { source: resource_field<Game>("time_left"), .. }.
@component
struct ClockBind {
    /// The resource field holding seconds.
    source: ResourceField = ResourceField { .. },
    /// The text, with {} where the clock goes.
    format: string = "{}",
    /// Whether the clock shows a digit of tenths of a second.
    tenths: bool = false,
}

/// Writes each ClockBind's seconds into its Text as a clock every frame.
@system
fn ui_clock(clock_bind: (ClockBind, Text)) {
    let (c, text) = clock_bind;
    let seconds = c.source.number();
    let shown = format_clock(seconds);
    if c.tenths {
        shown = format_clock_tenths(seconds);
    }
    let value = c.format.replace("{}", shown);
    if value != text.value {
        text.value = value;
    }
}

// ---- Parts ----

/// A shape that belongs to a widget: it goes when the widget goes.
@component
struct PartOf {
    /// The widget the part belongs to; when it is despawned, so is the part.
    owner: Entity = Entity { .. },
}

/// Despawns every part whose owner is gone.
@system
fn ui_parts(part_of: (Entity, PartOf), cmd: Commands) {
    let (e, p) = part_of;
    if !p.owner.alive() {
        cmd.despawn(e);
    }
}

/// Internal: The top-left corner of a rectangle drawn at `t` with its pivot at `pivot`.
fn top_left(t: Transform, size: Vec2, pivot: Vec2) -> Vec2 {
    return Vec2 { x: t.position.x - size.x * pivot.x, y: t.position.y - size.y * pivot.y };
}

/// Internal: a helper the module needs; games do not call it.
fn part_rect(at: Vec2, size: Vec2, c: Color, corner: float, z: float, visible: bool) -> any[] {
    return [
        Transform { position: at, .. },
        Rectangle { size: size, color: c, corner_radius: corner, anchor: Vec2 { x: 0.0, y: 0.0 },
                    z: z, layer: hud_layer(), visible: visible, .. },
    ];
}

/// Internal: How faded a widget is: its background alpha against the one it was made with, so
/// fading the background fades the parts too.
fn fade_of(r: Rectangle, alpha: float) -> float {
    if alpha <= 0.0 {
        return 1.0;
    }
    return clamp(r.color.a / alpha, 0.0, 1.0);
}

// ---- Bars ----

/// A bar that fills to value / max: health, stamina, progress. The fill slides toward a new
/// value at `smooth` per second (0 jumps), and a trail in `trail_color` shows recent damage,
/// shrinking after `trail_delay` seconds. `value_from` and `max_from`, made with
/// resource_field<Game>("hp"), fill value and max from resource fields every frame. `smooth` is
/// a rate per second (0 jumps); `trail_speed` is the share of the bar the trail shrinks per
/// second. Colors left unset come from the theme.
@component
struct Bar {
    /// The current amount; the fill is value / max, clamped to 0..1.
    value: float = 1.0,
    /// The full amount; 0 or less shows an empty bar.
    max: float = 1.0,
    /// A resource field `value` is read from every frame, when set.
    value_from: ResourceField = ResourceField { .. },
    /// A resource field `max` is read from every frame, when set.
    max_from: ResourceField = ResourceField { .. },
    /// The fill color; a negative alpha, the default, takes the theme's bar_fill.
    fill_color: Color = Color { r: 0.0, g: 0.0, b: 0.0, a: -1.0 },
    /// The trail color; a negative alpha, the default, takes the theme's bar_trail.
    trail_color: Color = Color { r: 0.0, g: 0.0, b: 0.0, a: -1.0 },
    /// How fast the fill slides toward a new value, per second; 0 jumps.
    smooth: float = 6.0,
    /// Seconds the trail waits after a drop before it shrinks.
    trail_delay: float = 0.4,
    /// The share of the bar the trail shrinks per second.
    trail_speed: float = 1.5,
    /// Pixels between the bar's edge and its fill.
    inset: float = 2.0,
    /// The fill share on screen, 0 to 1; the bar keeps it, -1 until the first frame.
    shown: float = -1.0,
    /// The trail share on screen, 0 to 1; the bar keeps it.
    trail: float = -1.0,
    /// Seconds the trail still waits; the bar keeps it.
    hold: float = 0.0,
    /// The fill share last frame, to notice drops; the bar keeps it.
    last: float = -1.0,
    /// The background alpha the bar was made with; fading the background below it fades the
    /// fill and trail too.
    alpha: float = 1.0,
    /// The part entity that draws the fill; spawn_bar sets it.
    fill_part: Entity = Entity { .. },
    /// The part entity that draws the trail; spawn_bar sets it.
    trail_part: Entity = Entity { .. },
}

/// Spawns a bar `size` pixels at `at` and answers its entity: `spawn_bar(cmd, theme,
/// anchor(TOP_LEFT, 16.0, 48.0), vec2(220.0, 18.0), Bar { value_from:
/// resource_field<Game>("hp"), max_from: resource_field<Game>("max_hp"), .. })`. Change it
/// later through a system that takes its Bar.
fn spawn_bar(cmd: Commands, theme: Theme, at: Anchor, size: Vec2, bar: Bar) -> Entity {
    let e = cmd.spawn([
        Transform { .. },
        Rectangle { size: size, color: theme.bar_back, corner_radius: theme.corner_radius * 0.5,
                    anchor: at.to, z: 0.0, layer: hud_layer(), .. },
        at,
    ]);
    let trail = cmd.spawn(part_rect(Vec2 { .. }, size, theme.bar_trail, 0.0, 0.5, false));
    let fill = cmd.spawn(part_rect(Vec2 { .. }, size, theme.bar_fill, 0.0, 1.0, false));
    cmd.insert(trail, PartOf { owner: e });
    cmd.insert(fill, PartOf { owner: e });
    if bar.fill_color.a < 0.0 {
        bar.fill_color = theme.bar_fill;
    }
    if bar.trail_color.a < 0.0 {
        bar.trail_color = theme.bar_trail;
    }
    bar.alpha = theme.bar_back.a;
    bar.fill_part = fill;
    bar.trail_part = trail;
    cmd.insert(e, bar);
    return e;
}

/// Moves every bar's fill and trail toward its value and redraws them.
@system(after: [ui_anchor])
fn ui_bars(row: (Bar, Rectangle, Transform), time: Time, cmd: Commands) {
    let (bar, back, t) = row;
    if bar.value_from.is_set() {
        bar.value = bar.value_from.number();
    }
    if bar.max_from.is_set() {
        bar.max = bar.max_from.number();
    }
    let target = 0.0;
    if bar.max > 0.0 {
        target = clamp(bar.value / bar.max, 0.0, 1.0);
    }
    let dt = time.real_dt;
    if bar.shown < 0.0 {
        bar.shown = target;
        bar.trail = target;
        bar.last = target;
    }
    if bar.smooth > 0.0 {
        bar.shown += (target - bar.shown) * min(1.0, bar.smooth * dt);
        if (target - bar.shown).abs() < 0.001 {
            bar.shown = target;
        }
    } else {
        bar.shown = target;
    }
    // New damage holds the trail where it was for trail_delay seconds, then
    // it catches up; it never sits below the fill.
    if target < bar.last - 0.0001 {
        bar.hold = bar.trail_delay;
    }
    bar.last = target;
    if bar.trail > target {
        if bar.hold > 0.0 {
            bar.hold -= dt;
        } else {
            bar.trail = max(target, bar.trail - bar.trail_speed * dt);
        }
    } else {
        bar.trail = bar.shown;
    }
    if bar.trail < bar.shown {
        bar.trail = bar.shown;
    }

    let fade = fade_of(back, bar.alpha);
    let inner = Vec2 { x: back.size.x - bar.inset * 2.0, y: back.size.y - bar.inset * 2.0 };
    let corner = top_left(t, back.size, back.anchor) + Vec2 { x: bar.inset, y: bar.inset };
    let z = back.z;
    let fill_color = bar.fill_color.alpha(bar.fill_color.a * fade);
    let trail_color = bar.trail_color.alpha(bar.trail_color.a * fade);
    cmd.insert(bar.trail_part, Transform { position: corner, .. });
    cmd.insert(bar.trail_part, Rectangle {
        size: Vec2 { x: inner.x * bar.trail, y: inner.y }, color: trail_color, anchor: Vec2 { x: 0.0, y: 0.0 },
        z: z + 0.5, layer: back.layer, visible: back.visible && bar.trail > 0.0, ..
    });
    cmd.insert(bar.fill_part, Transform { position: corner, .. });
    cmd.insert(bar.fill_part, Rectangle {
        size: Vec2 { x: inner.x * bar.shown, y: inner.y }, color: fill_color, anchor: Vec2 { x: 0.0, y: 0.0 },
        z: z + 1.0, layer: back.layer, visible: back.visible && bar.shown > 0.0, ..
    });
}

// ---- Icon rows ----

/// A row of `max` icons with the first `count` lit: hearts, ammo, lives. Icons are `image` when
/// it is set, circles otherwise. `count_from`, made with resource_field<Game>("lives"), fills
/// count from a resource field.
@component
struct IconRow {
    /// How many icons are lit, from the left.
    count: int = 3,
    /// How many icons the row has.
    max: int = 3,
    /// A resource field `count` is read from every frame, when set.
    count_from: ResourceField = ResourceField { .. },
    /// The icon image, scaled to `size` pixels wide; no image draws circles.
    image: Texture = Texture { .. },
    /// The width of one icon in pixels.
    size: float = 24.0,
    /// Pixels from one icon's left edge to the next.
    spacing: float = 30.0,
    /// The tint of a lit icon.
    full: Color = Color { r: 1.0, g: 0.35, b: 0.4, a: 1.0 },
    /// The tint of an unlit icon.
    empty: Color = Color { r: 1.0, g: 1.0, b: 1.0, a: 0.18 },
    /// One part entity per icon; the row keeps them.
    parts: Entity[] = [],
}

/// The components of an IconRow at `at` with `count` of `max` icons lit, to spawn. The row
/// starts at the anchor and goes right.
///
/// ```rust
/// cmd.spawn(icon_row(anchor(TOP_LEFT, 16.0, 16.0), 3, 5));
/// ```
fn icon_row(at: Anchor, count: int, max: int) -> any[] {
    return [Transform { .. }, at, IconRow { count: count, max: max, .. }];
}

/// Keeps one part per icon of each IconRow and colors the first `count` of them as lit.
@system(after: [ui_anchor])
fn ui_icon_rows(icon_row: (Entity, IconRow, Transform), cmd: Commands) {
    let (e, row, t) = icon_row;
    if row.count_from.is_set() {
        row.count = int(row.count_from.number());
    }
    while row.parts.len() < row.max {
        let part = cmd.spawn([Transform { .. }, PartOf { owner: e }]);
        row.parts.push(part);
    }
    while row.parts.len() > row.max {
        cmd.despawn(row.parts[row.parts.len() - 1]);
        row.parts.remove(row.parts.len() - 1);
    }
    let width = row.spacing * float(row.max - 1) + row.size;
    let start = t.position.x - width * 0.0;
    for i in range(row.max) {
        let p = Vec2 { x: start + row.spacing * float(i) + row.size * 0.5, y: t.position.y + row.size * 0.5 };
        let c = row.empty;
        if i < row.count {
            c = row.full;
        }
        cmd.insert(row.parts[i], Transform { position: p, .. });
        if row.image.id != 0 {
            let s = row.image.size();
            let k = 1.0;
            if s.x > 0.0 {
                k = row.size / s.x;
            }
            cmd.insert(row.parts[i], Transform { position: p, scale: Vec2 { x: k, y: k }, .. });
            cmd.insert(row.parts[i], Sprite { image: row.image, color: c, z: 1.0, layer: hud_layer(), .. });
        } else {
            cmd.insert(row.parts[i], Circle { radius: row.size * 0.5, color: c, z: 1.0, layer: hud_layer(), .. });
        }
    }
}

// ---- Buttons, toggles and sliders ----

/// Sent when a button is clicked, tapped, or activated with Return, Space or the gamepad's
/// South button while focused.
@message
struct ButtonPressed {
    /// The id the button was made with.
    id: string = "",
    /// The button's entity.
    button: Entity = Entity { .. },
}

/// Sent when a toggle flips.
@message
struct ToggleChanged {
    /// The id the toggle was made with.
    id: string = "",
    /// Whether the toggle is now on.
    on: bool = false,
    /// The toggle's entity.
    toggle: Entity = Entity { .. },
}

/// Sent while a slider moves.
@message
struct SliderChanged {
    /// The id the slider was made with.
    id: string = "",
    /// The slider's new value, between its min and max.
    value: float = 0.0,
    /// The slider's entity.
    slider: Entity = Entity { .. },
}

/// Which of the three clickable widgets a Widget is; button(), toggle() and slider() set it.
enum WidgetKind {
    /// Sends ButtonPressed when clicked or activated.
    Button,
    /// Flips `on` and sends ToggleChanged when clicked or activated.
    Toggle,
    /// Changes `value` while dragged, or with Left and Right while focused, and sends
    /// SliderChanged; Return, Space and the South button do nothing on it.
    Slider,
}

/// Which widget the keyboard or gamepad is on: the `order` of a Widget, or -1 before anyone
/// navigates. Up/Down (W/S, the d-pad, the left stick) move it; Left/Right change a focused
/// slider.
@resource
struct UiFocus {
    /// The `order` of the focused widget, or -1 while none is.
    index: int = -1,
    /// Seconds until a held stick moves the focus again; UiFocus keeps it.
    held: float = 0.0,
    /// Whether the keyboard and gamepad move and use the focus; false leaves only the mouse.
    enabled: bool = true,
}

/// What a clickable widget is. Made by button(), toggle() and slider().
@component
struct Widget {
    /// The id its messages carry.
    id: string = "",
    /// Button, toggle or slider.
    kind: WidgetKind = WidgetKind::Button,
    /// Its place in keyboard and gamepad navigation; lower comes first.
    order: int = 0,
    /// Whether a toggle is on.
    on: bool = false,
    /// A slider's value.
    value: float = 0.0,
    /// A slider's lowest value.
    min: float = 0.0,
    /// A slider's highest value.
    max: float = 1.0,
    /// A twentieth of a slider's range; slider() sets it, and the module does not read it.
    step: float = 0.1,
    /// Whether the mouse is over it this frame.
    hovered: bool = false,
    /// Whether the left mouse button went down on it and is still held.
    pressed: bool = false,
    /// Whether a slider's knob is being dragged.
    dragging: bool = false,
    /// The fill at rest, from the theme's button_color.
    color: Color = Color { .. },
    /// The fill while hovered or focused, from the theme's button_hover.
    hover: Color = Color { .. },
    /// The fill while pressed, from the theme's button_pressed.
    down: Color = Color { .. },
    /// The mark or knob color while focused, from the theme's button_focus.
    focus: Color = Color { .. },
    /// The mark or knob color otherwise, from the theme's accent.
    accent: Color = Color { .. },
    /// The background alpha it was made with; fading the background below it fades the parts
    /// too.
    alpha: float = 1.0,
    /// The part entity that draws its text.
    label_part: Entity = Entity { .. },
    /// The part entity that draws a toggle's mark or a slider's knob.
    mark_part: Entity = Entity { .. },
}

/// Internal: a helper the module needs; games do not call it.
fn widget_size(theme: Theme, text: string, min_width: float) -> Vec2 {
    let w = max(min_width, float(text.len()) * theme.text_size * 0.55 + theme.padding.x * 2.0);
    return Vec2 { x: w, y: theme.text_size + theme.padding.y * 2.0 };
}

/// Internal: a helper the module needs; games do not call it.
fn spawn_widget(cmd: Commands, theme: Theme, at: Anchor, size: Vec2, w: Widget, text: string) -> Entity {
    let e = cmd.spawn([
        Transform { .. },
        Rectangle { size: size, color: theme.button_color, corner_radius: theme.corner_radius,
                    anchor: at.to, z: 0.0, layer: hud_layer(), .. },
        at,
    ]);
    let pivot = Vec2 { x: 0.5, y: 0.5 };
    if w.kind != WidgetKind::Button {
        pivot = Vec2 { x: 0.0, y: 0.5 };
    }
    let label = cmd.spawn([Transform { .. }, theme.text(text, pivot), PartOf { owner: e }]);
    w.label_part = label;
    if w.kind != WidgetKind::Button {
        let mark = cmd.spawn([Transform { .. }, PartOf { owner: e }]);
        w.mark_part = mark;
    }
    w.color = theme.button_color;
    w.hover = theme.button_hover;
    w.down = theme.button_pressed;
    w.focus = theme.button_focus;
    w.accent = theme.accent;
    w.alpha = theme.button_color.a;
    cmd.insert(e, w);
    return e;
}

/// A button with `text`; pressing it sends ButtonPressed with `id`. `order` is its place in
/// keyboard and gamepad navigation.
fn button(cmd: Commands, theme: Theme, at: Anchor, id: string, text: string, order: int) -> Entity {
    return spawn_widget(cmd, theme, at, widget_size(theme, text, theme.widget_width),
                        Widget { id: id, order: order, .. }, text);
}

/// An on/off switch; flipping it sends ToggleChanged.
fn toggle(cmd: Commands, theme: Theme, at: Anchor, id: string, text: string, on: bool, order: int) -> Entity {
    let size = widget_size(theme, text, theme.widget_width);
    return spawn_widget(cmd, theme, at, size, Widget { id: id, kind: WidgetKind::Toggle, on: on, order: order, .. }, text);
}

/// A slider from `min` to `max`; moving it sends SliderChanged.
fn slider(cmd: Commands, theme: Theme, at: Anchor, id: string, text: string, value: float,
          min: float, max: float, order: int) -> Entity {
    let size = widget_size(theme, text, theme.widget_width);
    size.x += theme.widget_width * 0.5;
    return spawn_widget(cmd, theme, at, size, Widget {
        id: id, kind: WidgetKind::Slider, value: value, min: min, max: max,
        step: (max - min) / 20.0, order: order, ..
    }, text);
}

/// Internal: a helper the module needs; games do not call it.
fn ui_nav_up(input: Input) -> bool {
    return input.key_pressed(Key::Up) || input.key_pressed(Key::W) || input.gamepad_pressed(0, GamepadButton::DpadUp);
}

/// Internal: a helper the module needs; games do not call it.
fn ui_nav_down(input: Input) -> bool {
    return input.key_pressed(Key::Down) || input.key_pressed(Key::S) || input.gamepad_pressed(0, GamepadButton::DpadDown);
}

/// Internal: a helper the module needs; games do not call it.
fn ui_activate(input: Input) -> bool {
    return input.key_pressed(Key::Return) || input.key_pressed(Key::Space) || input.gamepad_pressed(0, GamepadButton::South);
}

/// Internal: a helper the module needs; games do not call it.
fn ui_nav_x(input: Input) -> float {
    let x = 0.0;
    if input.key_down(Key::Left) || input.key_down(Key::A) || input.gamepad_down(0, GamepadButton::DpadLeft) {
        x -= 1.0;
    }
    if input.key_down(Key::Right) || input.key_down(Key::D) || input.gamepad_down(0, GamepadButton::DpadRight) {
        x += 1.0;
    }
    let stick = input.gamepad_axis(0, GamepadAxis::LeftX);
    if stick.abs() > 0.5 {
        x = stick;
    }
    return x;
}

/// Moves the focus between the visible widgets in `order`.
@system
fn ui_focus_nav(focus: UiFocus, input: Input, time: Time, widgets: (Widget, Rectangle)[]) {
    if !focus.enabled {
        return;
    }
    let orders: int[] = [];
    for (w, r) in widgets {
        if r.visible {
            orders.push(w.order);
        }
    }
    if orders.len() == 0 {
        return;
    }
    orders.sort();
    let stick = input.gamepad_axis(0, GamepadAxis::LeftY);
    let dir = 0;
    if ui_nav_up(input) {
        dir = -1;
    }
    if ui_nav_down(input) {
        dir = 1;
    }
    if dir == 0 && stick.abs() > 0.5 {
        focus.held -= time.real_dt;
        if focus.held <= 0.0 {
            focus.held = 0.25;
            dir = 1;
            if stick < 0.0 {
                dir = -1;
            }
        }
    } else if stick.abs() <= 0.5 {
        focus.held = 0.0;
    }
    if dir == 0 {
        return;
    }
    let at = -1;
    for i in range(orders.len()) {
        if orders[i] == focus.index {
            at = i;
        }
    }
    if at < 0 {
        focus.index = orders[0];
        return;
    }
    let next = (at + dir + orders.len()) % orders.len();
    focus.index = orders[next];
}

/// Handles the mouse, the focus and activation of every button, toggle and slider, sends their
/// messages and redraws them.
@system(after: [ui_anchor, ui_focus_nav])
fn ui_widgets(widget: (Entity, Widget, Rectangle, Transform), input: Input, focus: UiFocus,
              time: Time, cmd: Commands) {
    let (e, w, r, t) = widget;
    let corner = top_left(t, r.size, r.anchor);
    let box = Rect { x: corner.x, y: corner.y, w: r.size.x, h: r.size.y };
    let mouse = input.mouse_screen();
    w.hovered = r.visible && box.contains(mouse);
    let focused = r.visible && focus.enabled && focus.index == w.order;
    let fire = false;
    let fade = fade_of(r, w.alpha);

    if w.hovered && input.mouse_pressed(MouseButton::Left) {
        w.pressed = true;
        if w.kind == WidgetKind::Slider {
            w.dragging = true;
        }
    }
    if input.mouse_released(MouseButton::Left) {
        if w.pressed && w.hovered && w.kind != WidgetKind::Slider {
            fire = true;
        }
        w.pressed = false;
        w.dragging = false;
    }
    if focused && ui_activate(input) && w.kind != WidgetKind::Slider {
        fire = true;
    }

    // Slider: the track is the right part of the box.
    let track_x = corner.x + r.size.x * 0.45;
    let track_w = r.size.x * 0.5;
    if w.kind == WidgetKind::Slider {
        let before = w.value;
        if w.dragging && track_w > 0.0 {
            let k = clamp((mouse.x - track_x) / track_w, 0.0, 1.0);
            w.value = w.min + (w.max - w.min) * k;
        }
        if focused {
            let x = ui_nav_x(input);
            if x != 0.0 {
                w.value = clamp(w.value + x * (w.max - w.min) * time.real_dt, w.min, w.max);
            }
        }
        if w.value != before {
            cmd.send(SliderChanged { id: w.id, value: w.value, slider: e });
        }
    }
    if fire {
        if w.kind == WidgetKind::Toggle {
            w.on = !w.on;
            cmd.send(ToggleChanged { id: w.id, on: w.on, toggle: e });
        } else {
            cmd.send(ButtonPressed { id: w.id, button: e });
        }
    }

    let c = w.color;
    if w.pressed && w.hovered {
        c = w.down;
    } else if w.hovered || focused {
        c = w.hover;
    }
    r.color = c.alpha(c.a * fade);

    // The label, and the mark of a toggle or the knob of a slider.
    let text_pos = Vec2 { x: corner.x + r.size.x * 0.5, y: corner.y + r.size.y * 0.5 };
    if w.kind != WidgetKind::Button {
        text_pos = Vec2 { x: corner.x + 14.0, y: corner.y + r.size.y * 0.5 };
    }
    cmd.insert(w.label_part, Transform { position: text_pos, .. });
    let mark = w.accent;
    if focused {
        mark = w.focus;
    }
    if w.kind == WidgetKind::Toggle {
        let s = r.size.y * 0.5;
        let m = mark;
        if !w.on {
            m = Color { r: 1.0, g: 1.0, b: 1.0, a: 0.15 };
        }
        cmd.insert(w.mark_part, Transform { position: Vec2 { x: corner.x + r.size.x - r.size.y * 0.5, y: corner.y + r.size.y * 0.5 }, .. });
        cmd.insert(w.mark_part, Rectangle { size: Vec2 { x: s, y: s }, color: m.alpha(m.a * fade), corner_radius: 3.0,
                                            z: r.z + 1.0, layer: r.layer, visible: r.visible, .. });
    }
    if w.kind == WidgetKind::Slider {
        let k = 0.0;
        if w.max > w.min {
            k = (w.value - w.min) / (w.max - w.min);
        }
        cmd.insert(w.mark_part, Transform { position: Vec2 { x: track_x + track_w * k, y: corner.y + r.size.y * 0.5 }, .. });
        cmd.insert(w.mark_part, Circle { radius: r.size.y * 0.3, color: mark.alpha(mark.a * fade),
                                         z: r.z + 1.0, layer: r.layer, visible: r.visible, .. });
    }
}

// ---- Show, hide, slide and fade ----

/// Fades and slides a widget in and out: set `shown` and it moves from `offset + slide`
/// (hidden) to `offset` (shown) over `seconds`, fading its Rectangle or Text. A hidden widget
/// stops drawing.
@component
struct Reveal {
    /// Whether the widget is shown; change it to start the move.
    shown: bool = true,
    /// Pixels the widget sits away from its anchor offset while hidden.
    slide: Vec2 = Vec2 { .. },
    /// How long showing or hiding takes; 0 is at once.
    seconds: float = 0.25,
    /// Progress from hidden (0) to shown (1); Reveal keeps it, -1 until the first frame.
    t: float = -1.0,
    /// The anchor offset when shown, taken on the first frame; Reveal keeps it.
    home: Vec2 = Vec2 { .. },
    /// The full alpha, taken from the widget on the first frame; Reveal keeps it.
    alpha: float = -1.0,
}

/// A Reveal that starts `shown` or hidden and sits `slide` pixels away while hidden.
///
/// ```rust
/// cmd.spawn([Transform { .. }, theme.text("Paused", CENTER), anchor(CENTER, 0.0, 0.0),
///            reveal(false, vec2(0.0, 40.0))]);
/// ```
fn reveal(shown: bool, slide: Vec2) -> Reveal { return Reveal { shown: shown, slide: slide, .. }; }

/// Internal: a helper the module needs; games do not call it.
fn ease_out(t: float) -> float {
    let u = 1.0 - t;
    return 1.0 - u * u * u;
}

/// Internal: a helper the module needs; games do not call it.
fn reveal_step(rv: Reveal, a: Anchor, dt: float) -> float {
    if rv.t < 0.0 {
        rv.home = a.offset;
        rv.t = 0.0;
        if rv.shown {
            rv.t = 1.0;
        }
    }
    let speed = 1.0;
    if rv.seconds > 0.0 {
        speed = dt / rv.seconds;
    }
    if rv.shown {
        rv.t = min(1.0, rv.t + speed);
        if rv.seconds <= 0.0 {
            rv.t = 1.0;
        }
    } else {
        rv.t = max(0.0, rv.t - speed);
        if rv.seconds <= 0.0 {
            rv.t = 0.0;
        }
    }
    let k = ease_out(rv.t);
    a.offset = rv.home + rv.slide * (1.0 - k);
    return k;
}

/// Slides and fades every Rectangle that has a Reveal.
@system(before: [ui_anchor])
fn ui_reveal_rects(reveal: (Reveal, Anchor, Rectangle), time: Time) {
    let (rv, a, r) = reveal;
    if rv.alpha < 0.0 {
        rv.alpha = r.color.a;
    }
    let k = reveal_step(rv, a, time.real_dt);
    r.color = r.color.alpha(rv.alpha * k);
    r.visible = k > 0.0;
}

/// Slides and fades every Text that has a Reveal.
@system(before: [ui_anchor])
fn ui_reveal_texts(reveal: (Reveal, Anchor, Text), time: Time) {
    let (rv, a, text) = reveal;
    if rv.alpha < 0.0 {
        rv.alpha = text.color.a;
    }
    let k = reveal_step(rv, a, time.real_dt);
    text.color = text.color.alpha(rv.alpha * k);
    text.shadow_color = text.shadow_color.alpha(min(text.shadow_color.a, k));
    text.visible = k > 0.0;
}

// ---- Toasts ----

/// A message that shows for a few seconds below the top of the window and goes; newer ones
/// stack under older ones.
@component
struct Toast {
    /// How long it shows, fading in and out included.
    seconds: float = 2.5,
    /// Seconds it has shown; Toast keeps it.
    age: float = 0.0,
    /// Its place in the stack, sliding toward a whole number; Toast keeps it.
    slot: float = -1.0,
}

/// Shows `message` as a toast for 2.5 seconds, in the theme's text, 72 pixels below the top of
/// the window. It fades in over 0.2 seconds and out over the last 0.4.
///
/// ```rust
/// toast(cmd, theme, "Checkpoint reached");
/// ```
fn toast(cmd: Commands, theme: Theme, message: string) {
    cmd.spawn([
        Transform { .. },
        theme.text(message, TOP),
        Anchor { to: TOP, offset: Vec2 { x: 0.0, y: 72.0 } },
        Toast { .. },
    ]);
}

/// Ages, stacks and fades every toast, and despawns the ones whose time is up.
@system(before: [ui_anchor])
fn ui_toasts(toasts: (Entity, Toast, Anchor, Text)[], time: Time, theme: Theme, cmd: Commands) {
    let slot = 0.0;
    for (e, t, a, text) in toasts {
        t.age += time.real_dt;
        if t.age >= t.seconds {
            cmd.despawn(e);
            continue;
        }
        if t.slot < 0.0 {
            t.slot = slot;
        }
        t.slot += (slot - t.slot) * min(1.0, time.real_dt * 10.0);
        let k = clamp(min(t.age / 0.2, (t.seconds - t.age) / 0.4), 0.0, 1.0);
        a.offset = Vec2 { x: 0.0, y: 72.0 + t.slot * (theme.text_size + 12.0) - (1.0 - k) * 12.0 };
        text.color = text.color.alpha(k);
        text.shadow_color = text.shadow_color.alpha(k * 0.55);
        slot += 1.0;
    }
}

// ---- Typewriter text and dialog boxes ----

/// Reveals a Text's `full` string a few characters at a time. `finished` turns true once all of
/// it shows; finish() shows it at once.
@component
struct Typewriter {
    /// The whole text to reveal.
    full: string = "",
    /// Characters revealed per second.
    chars_per_second: float = 40.0,
    /// How many characters show; Typewriter keeps it.
    shown: float = 0.0,
    /// Whether all of `full` shows.
    finished: bool = false,
}

impl Typewriter {
    /// Shows the whole text at once and marks it finished.
    ///
    /// ```rust
    /// if input.key_pressed(Key::Space) { tw.finish(); }
    /// ```
    fn finish(self) {
        self.shown = float(self.full.len());
        self.finished = true;
    }
}

/// Reveals more of every Typewriter's text each frame.
@system
fn ui_typewriter(typewriter: (Typewriter, Text), time: Time) {
    let (tw, text) = typewriter;
    let n = tw.full.len();
    if !tw.finished {
        tw.shown += tw.chars_per_second * time.real_dt;
        if tw.shown >= float(n) {
            tw.shown = float(n);
            tw.finished = true;
        }
    }
    let value = tw.full[..int(tw.shown)];
    if value != text.value {
        text.value = value;
    }
}

/// Sent when the player closes a dialog box.
@message
struct DialogClosed {
    /// The id the dialog box was made with.
    id: string = "",
    /// The dialog box's entity, despawned as the message is sent.
    dialog: Entity = Entity { .. },
}

/// A box along the bottom of the window that types out `pages` one after another. Return,
/// Space, a click or the South button finishes the page, then turns it; after the last page the
/// box closes and sends DialogClosed.
@component
struct DialogBox {
    /// The id DialogClosed carries.
    id: string = "",
    /// The text of each page, in order.
    pages: string[] = [],
    /// The page showing, from 0.
    page: int = 0,
    /// The part entity that types the text; dialog_box sets it.
    text_part: Entity = Entity { .. },
}

/// Spawns a dialog box 720 pixels wide, 16 pixels above the bottom of the window, that types
/// out `pages` in the theme's text, and answers its entity.
///
/// ```rust
/// dialog_box(cmd, theme, "intro", ["Welcome, traveller.", "The bridge is out. Find another way."]);
/// ```
fn dialog_box(cmd: Commands, theme: Theme, id: string, pages: string[]) -> Entity {
    let box = cmd.spawn(panel(theme, Anchor { to: BOTTOM, offset: Vec2 { x: 0.0, y: -16.0 } },
                              Vec2 { x: 720.0, y: theme.text_size * 4.0 + theme.padding.y * 2.0 }));
    let first = "";
    if pages.len() > 0 {
        first = pages[0];
    }
    let text = theme.text("", TOP_LEFT);
    text.wrap = 720.0 - theme.padding.x * 2.0;
    text.z = 3.0;
    let part = cmd.spawn([Transform { .. }, text, Typewriter { full: first, .. }, PartOf { owner: box }]);
    cmd.insert(box, DialogBox { id: id, pages: pages, text_part: part, .. });
    return box;
}

/// Finishes or turns the page of every dialog box when the player presses Return, Space, the
/// left mouse button or the gamepad's South button, and closes it after the last page.
@system(after: [ui_anchor])
fn ui_dialogs(dialog_box: (Entity, DialogBox, Rectangle, Transform), input: Input,
              writers: Lookup<Typewriter>, cmd: Commands) {
    let (e, d, r, t) = dialog_box;
    let corner = top_left(t, r.size, r.anchor);
    cmd.insert(d.text_part, Transform { position: corner + Vec2 { x: 16.0, y: 12.0 }, .. });
    let next = ui_activate(input) || input.mouse_pressed(MouseButton::Left);
    if !next {
        return;
    }
    if writers.get(d.text_part) is Some(tw) {
        if !tw.finished {
            tw.finish();
            cmd.insert(d.text_part, tw);
            return;
        }
    }
    d.page += 1;
    if d.page >= d.pages.len() {
        cmd.send(DialogClosed { id: d.id, dialog: e });
        cmd.despawn(e);
        return;
    }
    cmd.insert(d.text_part, Typewriter { full: d.pages[d.page], .. });
}

// ---- Widgets that follow the world ----

/// Keeps an anchored widget over an entity in the world: `offset` pixels from where the camera
/// shows the target. Floating names, prompts and health bars over heads. The widget hides while
/// the target is gone.
@component
struct FollowWorld {
    /// The entity to stay over; when it is gone the widget is despawned.
    target: Entity = Entity { .. },
    /// Pixels from the target's screen position; the default is 32 pixels above it.
    offset: Vec2 = Vec2 { x: 0.0, y: -32.0 },
}

/// Where the camera shows the entity `e`, in window pixels.
///
/// ```rust
/// let p = screen_point_of(boss, camera);
/// ```
fn screen_point_of(e: Entity, camera: Camera2D) -> Vec2 {
    return camera.world_to_screen(world_transform(e).position);
}

/// Points every FollowWorld widget's Anchor at its target's screen position, and despawns the
/// widget once the target is gone.
@system(before: [ui_anchor])
fn ui_follow_world(follow_world: (Entity, FollowWorld, Anchor), camera: Camera2D, win: Window,
                   theme: Theme, cmd: Commands) {
    let (e, f, a) = follow_world;
    if !f.target.alive() {
        cmd.despawn(e);
        return;
    }
    let p = screen_point_of(f.target, camera) + f.offset;
    let m = theme.safe_margin;
    a.to = Vec2 { .. };
    a.offset = Vec2 { x: p.x - m.x, y: p.y - m.y };
}

/// An arrow at the edge of the window pointing at `target` while the camera does not show it:
/// the way to the exit, a lost teammate, a boss.
@component
struct OffscreenArrow {
    /// The entity to point at; nothing draws while it is gone.
    target: Entity = Entity { .. },
    /// The arrow's color.
    color: Color = Color { r: 1.0, g: 0.85, b: 0.3, a: 1.0 },
    /// The arrow's length in pixels.
    size: float = 14.0,
    /// Pixels between the arrow's tip and the window edge, inside the theme's safe margin.
    margin: float = 28.0,
}

/// Draws an arrow at the window edge for every OffscreenArrow whose target is off the screen.
@system
fn ui_offscreen_arrows(offscreen_arrow: (Entity, OffscreenArrow), camera: Camera2D, win: Window,
                       theme: Theme, draw: Draw) {
    let (_, a) = offscreen_arrow;
    if !a.target.alive() {
        return;
    }
    let p = screen_point_of(a.target, camera);
    let m = a.margin;
    let sm = theme.safe_margin;
    let lo = Vec2 { x: sm.x + m, y: sm.y + m };
    let hi = Vec2 { x: win.width - sm.x - m, y: win.height - sm.y - m };
    if p.x >= lo.x && p.x <= hi.x && p.y >= lo.y && p.y <= hi.y {
        return;
    }
    let c = Vec2 { x: win.width * 0.5, y: win.height * 0.5 };
    let d = (p - c).normalized();
    // Where the line from the middle toward the target crosses the margin.
    let k = 1000000.0;
    if d.x > 0.0001 {
        k = min(k, (hi.x - c.x) / d.x);
    }
    if d.x < -0.0001 {
        k = min(k, (lo.x - c.x) / d.x);
    }
    if d.y > 0.0001 {
        k = min(k, (hi.y - c.y) / d.y);
    }
    if d.y < -0.0001 {
        k = min(k, (lo.y - c.y) / d.y);
    }
    let tip = c + d * k;
    let side = d.perp() * (a.size * 0.6);
    let back = tip - d * a.size;
    draw.hud();
    draw.at_z(5000.0);
    draw.triangle(tip, back + side, back - side, a.color);
}

/// A round radar on the HUD at the anchor: entities with a RadarBlip within `range` world units
/// of `center` show as dots.
@component
struct Radar {
    /// The entity at the middle of the radar, usually the player; no blips show while it is gone.
    center: Entity = Entity { .. },
    /// World units from the center to the radar's edge.
    range: float = 600.0,
    /// The radar's radius on the screen, in pixels.
    radius: float = 64.0,
    /// The radar's fill.
    color: Color = Color { r: 0.05, g: 0.08, b: 0.12, a: 0.75 },
    /// The color of the radar's outline and its middle dot.
    ring: Color = Color { r: 0.35, g: 0.67, b: 1.0, a: 0.8 },
}

/// Shows the entity on every Radar.
@component
struct RadarBlip {
    /// The dot's color.
    color: Color = Color { r: 1.0, g: 0.35, b: 0.4, a: 1.0 },
    /// The dot's radius in pixels.
    size: float = 3.0,
}

/// Draws every Radar and the RadarBlip entities within its range.
@system(after: [ui_anchor])
fn ui_radars(radar: (Radar, Transform), blips: (Entity, RadarBlip)[], draw: Draw) {
    let (r, t) = radar;
    let c = t.position;
    draw.hud();
    draw.at_z(4000.0);
    draw.circle(c, r.radius, r.color);
    draw.circle_lines(c, r.radius, r.ring, 1.5);
    draw.circle(c, 2.5, r.ring);
    if !r.center.alive() {
        return;
    }
    let me = world_transform(r.center).position;
    for (e, b) in blips {
        let d = (world_transform(e).position - me) / r.range;
        if d.length() <= 1.0 {
            draw.circle(c + d * r.radius, b.size, b.color);
        }
    }
}

/// A panel drawn from an image cut in nine: the corners keep their size and the edges and
/// middle stretch, so one small image frames any size. `border` is the width of each edge in
/// the image's pixels; `frame` picks part of the image (zero for all of it).
@component
struct NineSlice {
    /// The image to cut.
    image: Texture = Texture { .. },
    /// The panel's size in pixels; the Anchor's `to` is its pivot.
    size: Vec2 = Vec2 { x: 200.0, y: 100.0 },
    /// The left, top, right and bottom margins in the image, in image pixels.
    border: Edges = Edges { left: 8.0, top: 8.0, right: 8.0, bottom: 8.0 },
    /// The part of the image to use, in image pixels; zero size uses all of it.
    frame: Rect = Rect { .. },
    /// A tint; white, the default, leaves the image as it is.
    color: Color = Color { .. },
    /// Draw order on the HUD layer; higher draws on top.
    z: float = 0.0,
    /// Whether it draws.
    visible: bool = true,
}

/// The components of a NineSlice panel `size` pixels at `at`, with the same `border` in image
/// pixels on all four sides, to spawn.
///
/// ```rust
/// cmd.spawn(nine_slice_panel(art.frame, 8.0, anchor(CENTER, 0.0, 0.0), vec2(320.0, 180.0)));
/// ```
fn nine_slice_panel(image: Texture, border: float, at: Anchor, size: Vec2) -> any[] {
    return [Transform { .. }, at,
            NineSlice { image: image, size: size, border: edges(border), .. }];
}

/// Draws every visible NineSlice at its anchor.
@system(after: [ui_anchor])
fn ui_nine_slices(nine_slice: (NineSlice, Anchor, Transform), draw: Draw) {
    let (n, a, t) = nine_slice;
    if !n.visible {
        return;
    }
    let corner = Vec2 { x: t.position.x - n.size.x * a.to.x, y: t.position.y - n.size.y * a.to.y };
    draw.hud();
    draw.at_z(n.z);
    draw.nine_slice(n.image, Rect { x: corner.x, y: corner.y, w: n.size.x, h: n.size.y }, n.frame, n.border, n.color);
}

/// An icon and text side by side, as one anchored line: coins, ammo, keys. Answers the text's
/// entity; the icon is a part of it.
fn icon_label(cmd: Commands, theme: Theme, icon: Texture, text: string, at: Anchor) -> Entity {
    let e = cmd.spawn([Transform { .. }, theme.text(text, Vec2 { x: 0.0, y: 0.5 }), at, IconOf { icon: icon, .. }]);
    return e;
}

/// Draws `icon` left of the entity's Text, `size` pixels tall.
@component
struct IconOf {
    /// The image to draw.
    icon: Texture = Texture { .. },
    /// The icon's height in pixels; 0 makes it 1.1 times the text size.
    size: float = 0.0,
    /// Pixels between the icon and the text.
    gap: float = 8.0,
    /// The part entity that draws the icon, made on the first frame; IconOf keeps it.
    part: Entity = Entity { .. },
}

/// Places and draws the icon of every IconOf beside its Text.
@system(after: [ui_anchor])
fn ui_icons(icon_of: (Entity, IconOf, Text, Transform), cmd: Commands) {
    let (e, i, text, t) = icon_of;
    if i.part.id == 0 {
        i.part = cmd.spawn([Transform { .. }, PartOf { owner: e }]);
    }
    let h = i.size;
    if h <= 0.0 {
        h = text.size * 1.1;
    }
    let s = i.icon.size();
    let k = 1.0;
    if s.y > 0.0 {
        k = h / s.y;
    }
    // The text starts at the anchor; the icon sits before it.
    let x = t.position.x;
    let y = t.position.y;
    if text.valign == VAlign::Top {
        y += text.size * 0.6;
    }
    cmd.insert(i.part, Transform { position: Vec2 { x: x - i.gap - s.x * k * 0.5, y: y }, scale: Vec2 { x: k, y: k }, .. });
    cmd.insert(i.part, Sprite { image: i.icon, z: text.z, layer: text.layer, visible: text.visible, .. });
}
