// drift: the engine module of Candela games that `drift` runs.
//
// A game marks its structs and functions with the attributes below, and the
// host reads them: components and resources it stores, systems it calls every
// frame with the data their parameters ask for. Everything here is either one
// of those declarations, an engine component or resource, or a value type.
// See bindings/candela/docs for the book.
//
// The module is written as one file per topic under core/. Each one is
// passed on here, so `import "drift" { * };` reaches every name.

export import "drift/core/host" { * };
export import "drift/core/values" { * };
export import "drift/core/assets" { * };
export import "drift/core/components" { * };
export import "drift/core/world" { * };
export import "drift/core/resources" { * };
export import "drift/core/time" { * };
export import "drift/core/random" { * };
export import "drift/core/procgen" { * };
export import "drift/core/tilemaps" { * };
export import "drift/core/rendering" { * };
export import "drift/core/effects" { * };
export import "drift/core/animation" { * };
export import "drift/core/input" { * };
export import "drift/core/physics" { * };
export import "drift/core/audio" { * };
export import "drift/core/text" { * };
export import "drift/core/data" { * };
export import "drift/core/scenes" { * };
