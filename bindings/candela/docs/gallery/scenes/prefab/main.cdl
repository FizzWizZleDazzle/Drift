// ANCHOR: all
// A prefab from a scene file: assets/lamp.json holds a lamp of two
// entities, a post and its bulb, and the bulb has the game's own Glow
// component. Four copies are spawned in a row; the third gets a red bulb
// through an override.

import "drift" { * };

// A component of the game, named in the file by its struct name.
@component struct Glow { speed: float = 1.0 }

// ANCHOR: spawn
@system(schedule: Schedule::Startup)
fn street(cmd: Commands, assets: Assets) {
    let lamp = assets.scene("assets/lamp.json");   // loaded once, spawned many times
    for i in range(4) {
        let overrides: {string: string} = {};
        if i == 2 {
            // By Name, a JSON patch of components; colors are 0 to 255 in files.
            overrides["Bulb"] = "{\"Shape2D\": {\"color\": [255, 90, 90, 255]}}";
        }
        let copy = cmd.spawn_scene(lamp, SceneOptions { offset: vec2(90.0 + 100.0 * float(i), 170.0), overrides: overrides, .. });
        if copy.find("Bulb") is Some(bulb) {
            log("lamp " + string(i) + " bulb is entity " + string(bulb.id));
        }
    }
}
// ANCHOR_END: spawn

// The Glow from the file runs like any component spawned in code.
@system
fn glow(row: (Glow, Transform), time: Time) {
    let (g, t) = row;
    let s = 1.0 + 0.15 * sin(time.elapsed * g.speed * 3.0);
    t.scale = vec2(s, s);
}
// ANCHOR_END: all
