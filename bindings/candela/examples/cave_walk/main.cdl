// Cave Walk: walk around generated caves and dungeons.
//
// 1 and 2 switch between a cellular-automata cave and a BSP dungeon, R rolls
// a new seed, the arrow keys or WASD move. Coins, gems and slimes stand on
// Poisson-disk points picked from a weighted table; slimes follow a flow
// field toward you.

import "drift" { * };

const CELL: float = 16.0;
const TOP: float = 28.0;     // the HUD strip above the map
const MAP_W: int = 60;
const MAP_H: int = 32;

// ---- Components ----

@component(requires: [Velocity])
struct Player { speed: float = 130.0 }

@component struct Slime { speed: float = 55.0 }
@component struct Pickup { value: int = 1 }
@component struct LevelThing {}
@component struct Hud {}

// ---- Resources ----

@resource
struct Level {
    map: Map = Map { .. },
    entity: Entity = Entity { .. },
    grid: Grid = Grid { .. },
    field: FlowField = FlowField { .. },
    goal: Cell = Cell { x: -1, y: -1 },
    start: Vec2 = Vec2 { .. },
    seed: int = 0,
    dungeon: bool = false,
    rebuild: bool = true,
    score: int = 0,
}

@resource
struct Art { tiles: Texture = tileset() }

// ---- Startup ----

@system(schedule: Schedule::Startup)
fn setup(cmd: Commands, input: Input, level: Level, random: Random) {
    input.bind_axis2d("move", Key::Left, Key::Right, Key::Up, Key::Down);
    input.bind_axis2d("move", Key::A, Key::D, Key::W, Key::S);
    level.seed = random.seed();
    cmd.spawn([
        at(0.0, 0.0),
        Circle { radius: 6.0, color: rgb(255, 220, 90), z: 5.0, .. },
        RigidBody { fixed_rotation: true, gravity_scale: 0.0, .. },
        CircleCollider { radius: 5.5, friction: 0.0, .. },
        Player { .. },
    ]);
    cmd.spawn([at(12.0, 4.0), Text { size: 18.0, layer: hud_layer(), .. }, Hud {}]);
}

// ---- Building levels ----

@system
fn controls(input: Input, level: Level) {
    if input.key_pressed(Key::Num1) {
        level.dungeon = false;
        level.rebuild = true;
    }
    if input.key_pressed(Key::Num2) {
        level.dungeon = true;
        level.rebuild = true;
    }
    if input.key_pressed(Key::R) {
        level.seed = rng(level.seed).range(1, 2147483647);
        level.rebuild = true;
    }
}

@system(after: [controls])
fn build(cmd: Commands, assets: Assets, level: Level, art: Art,
         things: (Entity, LevelThing)[], players: (Player, Transform, Velocity)[]) {
    if !level.rebuild {
        return;
    }
    level.rebuild = false;
    for (e, _) in things {
        cmd.despawn(e);
    }
    if level.entity.id != 0 {
        cmd.despawn(level.entity);
        level.map.destroy();
    }

    // Each kind of level has its own stream of the seed.
    let r = rng_stream(level.seed, 1);
    if level.dungeon {
        r = rng_stream(level.seed, 2);
        level.grid = dungeon(r, MAP_W, MAP_H, DungeonOptions { min_room: 4, max_room: 9, extra_corridors: 3, .. }).grid;
    } else {
        level.grid = cave(r, MAP_W, MAP_H, CaveOptions { .. });
    }

    // Floor everywhere open, in two noise-shaped variants; walls on their
    // own layer, which builds the colliders.
    level.map = assets.create_tilemap(MAP_W, MAP_H, 16, art.tiles, ["Floor", "Walls"]);
    let patches = noise(level.seed).grid(MAP_W, MAP_H, 0.1, 2, 1);
    let floor = grid(MAP_W, MAP_H, 0);
    for i in range(MAP_W * MAP_H) {
        let v = level.grid.cells[i];
        if v == FLOOR {
            floor.cells[i] = patches.cells[i];
        } else if v == DOOR {
            floor.cells[i] = 3;
        }
    }
    level.map.write_grid(0, floor, [0, 1, 2, 4], cell(0, 0));
    level.map.write_grid(1, level.grid, [0, 3, 0], cell(0, 0));
    level.map.set_layer_solid(1, true, [3]);
    level.entity = cmd.spawn([at(0.0, TOP), Tilemap { map: level.map, .. }]);
    level.goal = cell(-1, -1);

    // Things on Poisson-disk points; the first point is the start.
    let spots = poisson_on_grid(r, level.grid, FLOOR, 4.0);
    level.start = world(spots[0]);
    for (_, t, v) in players {
        t.position = level.start;
        v.linear = vec2(0.0, 0.0);
    }
    let table = weighted_table<int>().add(0, 70.0).add(1, 8.0).add(2, 12.0);
    for i in range(spots.len() - 1) {
        let p = world(spots[i + 1]);
        let what = 0;
        if table.roll(r) is Some(w) {
            what = w;
        }
        if what == 2 && p.distance(level.start) < 10.0 * CELL {
            what = 0;
        }
        if what == 0 {
            cmd.spawn([Transform { position: p, .. }, Circle { radius: 3.0, color: rgb(255, 200, 40), z: 3.0, .. },
                       CircleCollider { radius: 3.0, sensor: true, .. }, Pickup { value: 1 }, LevelThing {}]);
        } else if what == 1 {
            cmd.spawn([Transform { position: p, rotation: 0.785, .. },
                       Rectangle { size: vec2(7.0, 7.0), color: rgb(90, 220, 255), z: 3.0, .. },
                       CircleCollider { radius: 4.0, sensor: true, .. }, Pickup { value: 5 }, LevelThing {}]);
        } else {
            cmd.spawn([Transform { position: p, .. }, Circle { radius: 5.0, color: rgb(110, 220, 90), z: 4.0, .. },
                       RigidBody { fixed_rotation: true, gravity_scale: 0.0, .. },
                       CircleCollider { radius: 4.5, friction: 0.0, .. }, Velocity { .. }, Slime { .. }, LevelThing {}]);
        }
    }
}

// ---- Every frame ----

@system
fn walk(row: (Player, Velocity), input: Input) {
    let (player, velocity) = row;
    velocity.linear = input.axis2d("move").normalized() * player.speed;
}

@system(after: [build])
fn chase(level: Level, effects: Effects, players: (Player, Transform, Velocity)[],
         slimes: (Slime, Transform, Velocity)[]) {
    for (_, pt, pv) in players {
        // One flow field for every slime, rebuilt when the player moves to
        // another cell.
        let goal = cell_of(pt.position);
        if (goal.x != level.goal.x || goal.y != level.goal.y) && level.grid.get(goal) != WALL {
            level.field = flow_field(level.grid, [goal], [WALL], Moves::EightWay);
            level.goal = goal;
        }
        let caught = false;
        for (s, t, v) in slimes {
            let to_player = pt.position - t.position;
            if to_player.length() < 11.0 {
                caught = true;
            }
            if to_player.length() > 10.0 * CELL {
                v.linear = vec2(0.0, 0.0);
            } else {
                let dir = level.field.direction(cell_of(t.position));
                if dir.length() == 0.0 {
                    dir = to_player.normalized();
                }
                v.linear = dir * s.speed;
            }
        }
        if caught {
            level.score = level.score / 2;
            pt.position = level.start;
            pv.linear = vec2(0.0, 0.0);
            effects.flash(rgb(255, 60, 60), 0.3);
        }
    }
}

// Called once for each pickup the player touches.
@system
fn pick_up(hit: Overlap<Player, Pickup>, pickups: Lookup<Pickup>, cmd: Commands, level: Level) {
    if pickups.get(hit.b) is Some(p) {
        level.score += p.value;
    }
    cmd.despawn(hit.b);
}

@system
fn hud(row: (Hud, Text), level: Level) {
    let (_, text) = row;
    let kind = "Cave";
    if level.dungeon {
        kind = "Dungeon";
    }
    text.value = kind + "   seed " + string(level.seed) + "   score " + string(level.score)
        + "      1 cave  2 dungeon  R new seed  WASD move";
}

// ---- Helpers ----

// A point in cell units (from poisson_on_grid) in the world.
fn world(p: Vec2) -> Vec2 { return vec2(p.x * CELL, p.y * CELL + TOP); }

fn cell_of(p: Vec2) -> Cell {
    return cell(int((p.x / CELL).floor()), int(((p.y - TOP) / CELL).floor()));
}

// Four 16x16 tiles side by side: two floors, a wall and a door, with grain
// from value noise.
fn tileset() -> Texture {
    let grain = Noise { seed: 7, kind: NoiseType::Value, frequency: 0.5, octaves: 3, .. };
    let n = grain.samples(vec2(0.0, 0.0), 64, 16, 1.0);
    let pixels: Color[] = [];
    for y in range(16) {
        for x in range(64) {
            let tile = x / 16;
            let lx = x % 16;
            let g = n[y * 64 + x] * 0.5 + 0.5;
            if tile < 2 {
                let base = 52.0 + 8.0 * float(tile);
                pixels.push(rgb(int(base + 18.0 * g), int(base * 0.85 + 14.0 * g), int(base * 0.75 + 10.0 * g)));
            } else if tile == 2 {
                let mortar = y % 5 == 4 || (lx + (y / 5) * 4) % 8 == 0;
                let lit = 0;
                if y < 2 {
                    lit = 40;
                }
                if mortar {
                    pixels.push(rgb(70, 66, 80));
                } else {
                    pixels.push(rgb(120 + int(30.0 * g) + lit, 96 + int(22.0 * g) + lit, 104 + int(20.0 * g) + lit));
                }
            } else {
                if lx % 4 == 0 {
                    pixels.push(rgb(70, 44, 24));
                } else {
                    pixels.push(rgb(140 + int(20.0 * g), 92 + int(14.0 * g), 48 + int(10.0 * g)));
                }
            }
        }
    }
    let assets = Assets { .. };
    return assets.create_texture(64, 16, pixels);
}
