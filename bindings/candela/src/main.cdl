// =========================================================================
// Math types
// =========================================================================

/// A 2D point or direction. +X is right, +Y is down.
struct Vec2 {
    x: float,
    y: float,
}

fn vec2(x: float, y: float) -> Vec2 {
    return Vec2 { x: x, y: y };
}

impl Vec2 {
    fn add(self, o: Vec2) -> Vec2 { return Vec2 { x: self.x + o.x, y: self.y + o.y }; }
    fn sub(self, o: Vec2) -> Vec2 { return Vec2 { x: self.x - o.x, y: self.y - o.y }; }
    fn mul(self, s: float) -> Vec2 { return Vec2 { x: self.x * s, y: self.y * s }; }
    fn dot(self, o: Vec2) -> float { return self.x * o.x + self.y * o.y; }
    fn length(self) -> float { return (self.x * self.x + self.y * self.y).sqrt(); }
    fn distance(self, o: Vec2) -> float { return self.sub(o).length(); }
    /// The same direction with length 1, or zero for a zero vector.
    fn normalized(self) -> Vec2 {
        let len = self.length();
        if len < 0.00000001 {
            return Vec2 { x: 0.0, y: 0.0 };
        }
        return Vec2 { x: self.x / len, y: self.y / len };
    }
    fn lerp(self, o: Vec2, t: float) -> Vec2 {
        return Vec2 { x: self.x + (o.x - self.x) * t, y: self.y + (o.y - self.y) * t };
    }
}

/// An axis-aligned rectangle: top-left corner and size.
struct Rect {
    x: float,
    y: float,
    w: float,
    h: float,
}

fn rect(x: float, y: float, w: float, h: float) -> Rect {
    return Rect { x: x, y: y, w: w, h: h };
}

impl Rect {
    fn contains(self, p: Vec2) -> bool {
        return p.x >= self.x && p.x < self.x + self.w && p.y >= self.y && p.y < self.y + self.h;
    }
    fn overlaps(self, o: Rect) -> bool {
        return self.x < o.x + o.w && self.x + self.w > o.x && self.y < o.y + o.h && self.y + self.h > o.y;
    }
    fn center(self) -> Vec2 { return Vec2 { x: self.x + self.w * 0.5, y: self.y + self.h * 0.5 }; }
}

/// A color with channels from 0.0 to 1.0.
struct Color {
    r: float,
    g: float,
    b: float,
    a: float,
}

/// An opaque color from 0..255 channels: rgb(255, 128, 0).
fn rgb(r: int, g: int, b: int) -> Color {
    return Color { r: float(r) / 255.0, g: float(g) / 255.0, b: float(b) / 255.0, a: 1.0 };
}

/// A color from 0..255 channels with alpha.
fn rgba(r: int, g: int, b: int, a: int) -> Color {
    return Color { r: float(r) / 255.0, g: float(g) / 255.0, b: float(b) / 255.0, a: float(a) / 255.0 };
}

impl Color {
    /// The same color with alpha `a` (0.0 to 1.0).
    fn alpha(self, a: float) -> Color { return Color { r: self.r, g: self.g, b: self.b, a: a }; }
}

/// A tile cell: column and row.
struct Cell {
    x: int,
    y: int,
}

// =========================================================================
// Enums
// =========================================================================

/// How the logical resolution fits the window.
enum ScaleMode {
    Letterbox,
    Stretch,
    Integer,
    Expand,
}

impl ScaleMode {
    fn code(self) -> int {
        match self {
            Letterbox => { return 0; }
            Stretch => { return 1; }
            Integer => { return 2; }
            Expand => { return 3; }
        }
        return 0;
    }
}

enum Blend {
    Alpha,
    Additive,
    Multiply,
    Premultiplied,
    Screen,
    Opaque,
}

impl Blend {
    fn code(self) -> int {
        match self {
            Alpha => { return 0; }
            Additive => { return 1; }
            Multiply => { return 2; }
            Premultiplied => { return 3; }
            Screen => { return 4; }
            Opaque => { return 5; }
        }
        return 0;
    }
}

enum Filter {
    Nearest,
    Linear,
}

enum Align {
    Left,
    Center,
    Right,
}

impl Align {
    fn code(self) -> int {
        match self {
            Left => { return 0; }
            Center => { return 1; }
            Right => { return 2; }
        }
        return 0;
    }
}

enum VAlign {
    Top,
    Middle,
    Bottom,
}

impl VAlign {
    fn code(self) -> int {
        match self {
            Top => { return 0; }
            Middle => { return 1; }
            Bottom => { return 2; }
        }
        return 0;
    }
}

enum BodyKind {
    Static,
