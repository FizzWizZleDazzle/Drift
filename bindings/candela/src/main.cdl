// drift: write 2D games for the Drift engine in candela.
//
// The native half is libdrift_candela in dist/ beside this package: a C shim
// with the whole engine linked in. Only ints, floats, strings, packed int and
// float lists and structs of those cross into it, and it cannot call back, so
// the game owns the loop:
//
//     let app = start(config("My Game", 1280, 720));
//     while app.frame() { ...read input, change entities, draw... }
//
// Engine objects come back as small integer handles; this file wraps them in
// typed structs (Entity, Texture, Sound, ...) with methods, turns enums and
// bools into the integers the shim takes, and raises an error kind when a
// call fails.

dylib "../dist/libdrift_candela" {
    string dc_error();
    int dc_start(string, int, int, int, int, int, int, int, string);
    int dc_frame();
    int dc_quit();
