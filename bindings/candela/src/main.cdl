// drift: write 2D games for the Drift engine in candela.
//
// A game is a set of systems over entities and components, Bevy style:
//
//     app(config("My Game", 1280, 720)).startup(setup).update(update).run();
//
// setup(world) spawns entities with components; update(world, dt) queries
// and changes them every frame. Components are plain structs. The engine's
// own (Transform, Sprite, Text, RigidBody, ...) are mirrored to the native
// engine, which draws and simulates them; yours live here. The frame loop
// is App.run().
//
// The native half is libdrift_candela in dist/ beside this package: a C shim
// with the whole engine linked in. Only ints, floats, strings, packed int and
// float lists and structs of those cross into it.

dylib "../dist/libdrift_candela" {
    string dc_error();
    int dc_start(string, int, int, int, int, int, int, int, string, int, int);
    int dc_sync_begin();
    int dc_sync_end();
    float dc_stat(int);
