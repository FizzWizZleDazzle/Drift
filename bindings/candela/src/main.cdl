    float dc_dt();
    float dc_time();
    int dc_frame_count();
    int dc_set_title(string);
    int dc_set_clear_color(Color);
    int dc_set_scale_mode(int);
    int dc_set_logical_size(int, int);
    Vec2 dc_logical_size();
    int dc_screenshot(string);
    string dc_backend();
    int dc_draw_calls();

    int dc_key_down(int);
